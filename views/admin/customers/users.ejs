<!DOCTYPE html>
<html class="dark" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>TechKart Admin - Customers CRM</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#0055ff",
                        "background-light": "#f5f6f8",
                        "background-dark": "#0a0c10",
                        "card-bg": "rgba(23, 33, 54, 0.4)",
                    },
                    fontFamily: {
                        "display": ["Space Grotesk", "sans-serif"]
                    },
                    borderRadius: {
                        "DEFAULT": "0.5rem",
                        "lg": "1rem",
                        "xl": "1.5rem",
                        "full": "9999px"
                    },
                },
            },
        }
    </script>
    <link rel="stylesheet" href="/css/views/admin/customers/users.css">
</head>

<body class="flex min-h-screen">
    <!-- Sidebar -->
    <%- include('../../partials/admin/sidebar') %>

        <main class="flex-1 flex flex-col relative overflow-y-auto custom-scrollbar min-w-0">
            <!-- Header -->
            <%- include('../../partials/admin/header') %>

                <div class="p-4 md:p-10 max-w-[1600px] mx-auto w-full space-y-6 md:space-y-8">
                    <!-- Stats -->
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <!-- Total Customers -->
                        <div class="bg-[#111827]/50 rounded-2xl p-6 border border-white/5 border-l-4 border-l-primary">
                            <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-2">Total Customers</p>
                            <div class="flex items-end justify-between">
                                <h3 class="text-3xl font-bold"><%= stats.total %></h3>
                                <span class="material-symbols-outlined text-primary bg-primary/10 p-2 rounded-lg">group</span>
                            </div>
                        </div>
                        <!-- Blocked Users -->
                        <div class="bg-[#111827]/50 rounded-2xl p-6 border border-white/5 border-l-4 border-l-rose-500">
                            <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-2">Blocked Users</p>
                            <div class="flex items-end justify-between">
                                <h3 class="text-3xl font-bold text-rose-400"><%= blockedUsers %></h3>
                                <span class="material-symbols-outlined text-rose-500 bg-rose-500/10 p-2 rounded-lg">block</span>
                            </div>
                        </div>
                        <!-- Active Users -->
                        <div class="bg-[#111827]/50 rounded-2xl p-6 border border-white/5 border-l-4 border-l-emerald-500">
                            <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-2">Active Users</p>
                            <div class="flex items-end justify-between">
                                <h3 class="text-3xl font-bold text-emerald-400"><%= activeUsers %></h3>
                                <span class="material-symbols-outlined text-emerald-500 bg-emerald-500/10 p-2 rounded-lg">check_circle</span>
                            </div>
                        </div>
                    </div>

                    <!-- Search and Filter -->
                    <div class="bg-[#111827]/50 rounded-2xl p-6 border border-white/5">
                        <form action="/admin/users" method="GET" class="flex flex-wrap items-center gap-4">
                            <div class="relative flex-1 max-w-md">
                                <span
                                    class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 text-xl">search</span>
                                <input
                                    class="!bg-white/5 border border-white/10 rounded-xl py-2.5 pl-12 pr-10 text-sm w-full focus:outline-none focus:border-primary text-white placeholder:text-slate-500"
                                    name="search" value="<%= search %>" placeholder="Search by name, email, or ID..."
                                    type="text" />
                                <% if (search) { %>
                                    <button type="button" onclick="window.location.href='/admin/users'"
                                        class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-500 hover:text-white transition-all">
                                        <span class="material-symbols-outlined text-lg">close</span>
                                    </button>
                                    <% } %>
                            </div>
                            <div class="flex items-center gap-3">
                                <button type="submit"
                                    class="bg-primary hover:bg-primary/90 text-white text-xs font-bold px-8 py-2.5 rounded-xl transition-all shadow-lg uppercase tracking-wider">
                                    Filter
                                </button>
                                <% if (search) { %>
                                    <a href="/admin/users"
                                        class="bg-white/5 hover:bg-white/10 text-slate-400 text-xs font-bold px-8 py-2.5 rounded-xl transition-all border border-white/10 uppercase tracking-wider">
                                        Reset
                                    </a>
                                    <% } %>
                            </div>
                        </form>
                    </div>

                    <!-- Table -->
                    <div class="bg-[#111827]/50 rounded-3xl overflow-x-auto border border-white/5 custom-scrollbar">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-white/5 border-b border-white/5">
                                    <th
                                        class="px-8 py-5 text-[10px] font-bold text-slate-400 uppercase tracking-widest">
                                        Customer</th>
                                    <th
                                        class="px-6 py-5 text-[10px] font-bold text-slate-400 uppercase tracking-widest">
                                        Join
                                        Date</th>
                                    <th
                                        class="px-6 py-5 text-[10px] font-bold text-slate-400 uppercase tracking-widest text-center">
                                        Orders</th>
                                    <th
                                        class="px-6 py-5 text-[10px] font-bold text-slate-400 uppercase tracking-widest">
                                        Total
                                        Spent</th>

                                    <th
                                        class="px-6 py-5 text-[10px] font-bold text-slate-400 uppercase tracking-widest">
                                        Status
                                    </th>
                                    <th
                                        class="px-8 py-5 text-[10px] font-bold text-slate-400 uppercase tracking-widest text-right">
                                        Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-white/5">
                                <% if (users && users.length> 0) { %>
                                    <% users.forEach(user=> { %>
                                        <tr class="hover:bg-white/5 transition-colors group">
                                            <td class="px-8 py-6">
                                                <div class="flex items-center gap-4">
                                                    <div
                                                        class="h-12 w-12 rounded-xl bg-primary/20 flex items-center justify-center text-primary font-bold text-base">
                                                        <%= user.fullname ? user.fullname.substring(0, 2).toUpperCase()
                                                            : '??' %>
                                                    </div>
                                                    <div>
                                                        <p class="text-sm font-bold text-slate-100">
                                                            <%= user.fullname %>
                                                        </p>
                                                        <p class="text-xs text-slate-500 font-medium">
                                                            <%= user.email %>
                                                        </p>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="px-6 py-5">
                                                <p class="text-sm text-slate-300 font-medium">
                                                    <%= new Date(user.createdAt).toLocaleDateString('en-US', {
                                                        month: 'short' , day: '2-digit' , year: 'numeric' }) %>
                                                </p>
                                            </td>
                                            <td class="px-6 py-5 text-center">
                                                <p class="text-sm font-bold text-slate-100">0</p>
                                            </td>
                                            <td class="px-6 py-5">
                                                <p class="text-sm font-bold text-primary">₹0.00</p>
                                            </td>

                                            <td class="px-6 py-5">
                                                <span
                                                    class="status-badge <%= user.isBlocked ? 'status-blocked' : 'status-active' %>">
                                                    <%= user.isBlocked ? 'Blocked' : 'Active' %>
                                                </span>
                                            </td>
                                            <td class="px-8 py-5 text-right">
                                                <div class="flex items-center justify-end gap-3">
                                                    <button
                                                        onclick="confirmBlock('<%= user._id %>', '<%= user.isBlocked %>')"
                                                        class="text-[10px] font-bold uppercase tracking-widest <%= user.isBlocked ? 'text-emerald-500 hover:text-emerald-400' : 'text-rose-500 hover:text-rose-400' %> transition-all">
                                                        <%= user.isBlocked ? 'Unblock' : 'Block' %>
                                                    </button>
                                                    <button
                                                        onclick="viewUser({
                                                            fullname: '<%= user.fullname %>',
                                                            email: '<%= user.email %>',
                                                            phone: '<%= user.phone || 'N/A' %>',
                                                            referralCode: '<%= user.referralCode || 'N/A' %>',
                                                            isBlocked: <%= user.isBlocked %>,
                                                            createdAt: '<%= new Date(user.createdAt).toLocaleDateString('en-US', { month: 'short' , day: '2-digit' , year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>'
                                                        })"
                                                        class="text-[10px] font-bold uppercase tracking-widest text-slate-400 hover:text-white transition-all">
                                                        View User
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                        <% }) %>
                                            <% } else { %>
                                                <tr>
                                                    <td colspan="7"
                                                        class="px-8 py-10 text-center text-slate-500 italic">No
                                                        customers found matching your search.</td>
                                                </tr>
                                                <% } %>
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <div class="flex items-center justify-between">
                        <p class="text-xs text-slate-500 font-medium uppercase tracking-widest">
                            Showing <%= (page - 1) * limit + 1 %> to <%= Math.min(page * limit, totalUsers) %> of <%=
                                        totalUsers %>
                                        customers
                        </p>
                        <% if (totalPages> 1) { %>
                            <div class="flex items-center gap-2">
                                <a href="?page=<%= page - 1 %>&search=<%= search %>"
                                    class="px-6 py-2.5 rounded-lg border border-white/10 text-slate-400 hover:bg-white/5 transition-all text-[10px] font-bold uppercase tracking-widest <%= page === 1 ? 'pointer-events-none opacity-30' : '' %>">
                                    Previous
                                </a>

                                <% for(let i=1; i <=totalPages; i++) { %>
                                    <a href="?page=<%= i %>&search=<%= search %>"
                                        class="h-10 w-10 flex items-center justify-center rounded-lg text-[10px] font-bold transition-all <%= page === i ? 'bg-primary text-white shadow-[0_0_20px_rgba(0,85,255,0.3)]' : 'border border-white/10 text-slate-400 hover:bg-white/5' %>">
                                        <%= i %>
                                    </a>
                                    <% } %>

                                        <a href="?page=<%= page + 1 %>&search=<%= search %>"
                                            class="px-6 py-2.5 rounded-lg border border-white/10 text-slate-400 hover:bg-white/5 transition-all text-[10px] font-bold uppercase tracking-widest <%= page === totalPages ? 'pointer-events-none opacity-30' : '' %>">
                                            Next
                                        </a>
                            </div>
                            <% } %>
                    </div>
                </div>
        </main>

        <script src="/js/admin/users.js"></script>
</body>

</html>