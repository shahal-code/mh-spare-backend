<!DOCTYPE html>
<html class="dark" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Manage Variants | <%= product.name %>
    </title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap"
        rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
        rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.css">
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#0055ff",
                        "background-dark": "#0d0d0d",
                        "panel-bg": "#11151F",
                        "input-bg": "#1A1F2B"
                    },
                    fontFamily: {
                        "display": ["Space Grotesk", "sans-serif"]
                    },
                },
            },
        }
    </script>
    <link rel="stylesheet" href="/css/views/admin/product/manage-variants.css">
</head>

<body class="flex min-h-screen bg-[#0D0D0D]">
    <%- include('../../partials/admin/sidebar') %>

        <main class="flex-1 flex flex-col relative overflow-y-auto custom-scrollbar">
            <%- include('../../partials/admin/header') %>

                <div class="p-8 lg:p-12 max-w-7xl mx-auto w-full space-y-8">
                    <!-- Header Area -->
                    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                        <div>
                            <div class="flex items-center gap-2 text-slate-500 mb-2">
                                <a href="/admin/product" class="hover:text-white transition-colors">Products</a>
                                <span class="material-symbols-outlined text-xs">chevron_right</span>
                                <span>Manage Variants</span>
                            </div>
                            <h2 class="text-3xl font-bold tracking-tight mb-1">
                                <%= product.name %>
                            </h2>
                            <p class="text-sm text-slate-500 font-medium">Manage technical variants and images</p>
                        </div>
                        <button onclick="openAddVariantModal()"
                            class="flex items-center gap-2 bg-primary hover:bg-primary/90 text-white px-6 py-3 rounded-full font-bold text-sm tracking-wide transition-all shadow-lg">
                            <span class="material-symbols-outlined text-sm">add</span>
                            ADD NEW VARIANT
                        </button>
                    </div>

                    <!-- Existing Variants List -->
                    <div class="space-y-6">
                        <% if(product.variants && product.variants.length> 0) { %>
                            <% product.variants.forEach((variant, index)=> { %>
                                <div class="form-card relative group">
                                    <div class="flex flex-col lg:flex-row gap-8">
                                        <!-- Variant Info -->
                                        <div class="flex-1 space-y-6">
                                            <div class="flex items-center justify-between">
                                                <h3 class="text-xl font-bold">Variant #<%= index + 1 %> - <%=
                                                            variant.color || 'Default Color' %>
                                                </h3>
                                                <div class="flex items-center gap-3">
                                                    <span
                                                        class="px-3 py-1 bg-white/5 border border-white/10 rounded-lg text-[10px] uppercase font-bold text-slate-400">SKU:
                                                        <%= variant.sku %></span>
                                                    <button onclick="openEditVariantModal('<%= variant._id %>')"
                                                        class="text-primary hover:bg-primary/10 p-2 rounded-full transition-colors">
                                                        <span class="material-symbols-outlined">edit</span>
                                                    </button>
                                                    <button onclick="deleteVariant('<%= variant._id %>')"
                                                        class="text-rose-500 hover:bg-rose-500/10 p-2 rounded-full transition-colors">
                                                        <span class="material-symbols-outlined">delete</span>
                                                    </button>
                                                </div>
                                            </div>

                                            <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
                                                <div>
                                                    <label class="input-label text-slate-500">Price</label>
                                                    <p class="font-bold text-primary text-xl">₹<%= variant.price %>
                                                    </p>
                                                </div>
                                                <div>
                                                    <label class="input-label text-slate-500">Stock</label>
                                                    <p
                                                        class="font-bold <%= variant.stock < 10 ? 'text-rose-500' : 'text-emerald-500' %> text-xl">
                                                        <%= variant.stock %>
                                                    </p>
                                                </div>
                                                <div>
                                                    <label class="input-label text-slate-500">RAM</label>
                                                    <p class="font-medium">
                                                        <%= variant.ram %>
                                                    </p>
                                                </div>
                                                <div>
                                                    <label class="input-label text-slate-500">Processor</label>
                                                    <p class="font-medium">
                                                        <% if(variant.processorBrand) { %>
                                                            <span class="text-primary font-bold">
                                                                <%= variant.processorBrand %>
                                                            </span> -
                                                            <% } %>
                                                                <%= variant.processor %>
                                                    </p>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Variant Images -->
                                        <div class="lg:w-72">
                                            <label class="input-label mb-4">Variant Images</label>
                                            <div class="grid grid-cols-3 gap-3">
                                                <% variant.images.forEach(img=> { %>
                                                    <div
                                                        class="aspect-square rounded-xl overflow-hidden border border-white/5">
                                                        <img src="<%= img %>" class="w-full h-full object-cover">
                                                    </div>
                                                    <% }) %>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <% }) %>
                                    <% } else { %>
                                        <div
                                            class="form-card text-center py-20 bg-primary/5 border-dashed border-primary/20">
                                            <span
                                                class="material-symbols-outlined text-5xl text-primary/30 mb-4 tracking-tighter">layers</span>
                                            <h3 class="text-xl font-bold mb-2">No variants added yet</h3>
                                            <p class="text-slate-500 text-sm max-w-xs mx-auto">Click "Add New Variant"
                                                to add technical configurations and images to this product.</p>
                                        </div>
                                        <% } %>
                    </div>
                </div>
        </main>

        <!-- Add Variant Modal (Simplified for now) -->
        <div id="variantModal"
            class="fixed inset-0 z-[998] hidden bg-black/95 backdrop-blur-md flex items-center justify-center p-4">
            <div
                class="bg-panel-bg w-full max-w-4xl rounded-[32px] overflow-hidden border border-white/10 shadow-3xl max-h-[90vh] overflow-y-auto custom-scrollbar">
                <div class="p-8 border-b border-white/5 flex items-center justify-between">
                    <div>
                        <h3 id="modalTitle" class="text-2xl font-bold">Add New Variant</h3>
                        <p class="text-xs text-slate-500 font-medium">Configure technical specs and images</p>
                    </div>
                    <button onclick="closeModal()" class="text-slate-400 hover:text-white transition-colors">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                </div>

                <form id="variantForm" action="/admin/product/<%= product._id %>/variants/add" method="POST"
                    enctype="multipart/form-data" class="p-8 space-y-8">
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                        <div>
                            <label class="input-label">Color</label>
                            <input type="text" name="color" id="color" class="input-field"
                            placeholder="e.g. Space Gray" oninput="clearVariantError('color')">
                        <p id="color-error" class="field-error"></p>
                        </div>
                        <div>
                            <label class="input-label">Price (INR)</label>
                            <input type="number" name="price" id="price" class="input-field" placeholder="e.g. 79999" oninput="clearVariantError('price')">
                        <p id="price-error" class="field-error"></p>
                        </div>
                        <div>
                            <label class="input-label">Stock</label>
                            <input type="number" name="stock" id="stock" class="input-field" placeholder="100" oninput="clearVariantError('stock')">
                        <p id="stock-error" class="field-error"></p>
                        </div>
                        <div>
                            <label class="input-label">Processor Brand</label>
                            <select id="processorBrand" name="processorBrand"
                                class="input-field appearance-none cursor-pointer" onchange="updateProcessorModels(); clearVariantError('processorBrand')">
                                <option value="" disabled selected>Select Brand</option>
                                <option value="Intel">Intel</option>
                                <option value="AMD">AMD</option>
                            </select>
                            <p id="processorBrand-error" class="field-error"></p>
                        </div>
                        <div>
                            <label class="input-label">Processor Model</label>
                            <select id="processorModel" name="processor"
                                class="input-field appearance-none cursor-pointer" onchange="clearVariantError('processorModel')">
                                <option value="" disabled selected>Select Model</option>
                            </select>
                            <p id="processorModel-error" class="field-error"></p>
                        </div>
                        <div>
                            <label class="input-label">RAM</label>
                            <select name="ram" id="ram" class="input-field appearance-none cursor-pointer" onchange="clearVariantError('ram')">
                                <option value="" disabled selected>Select RAM</option>
                                <option value="8GB">8GB</option>
                                <option value="16GB">16GB</option>
                                <option value="32GB">32GB</option>
                                <option value="64GB">64GB</option>
                            </select>
                            <p id="ram-error" class="field-error"></p>
                        </div>
                        <div>
                            <label class="input-label">Storage</label>
                            <input type="text" name="storage" class="input-field" placeholder="e.g. 1TB SSD">
                        </div>
                        <div>
                            <label class="input-label">GPU</label>
                            <input type="text" name="gpu" class="input-field" placeholder="e.g. RTX 4060">
                        </div>
                        <div>
                            <label class="input-label">Size</label>
                            <input type="text" name="size" class="input-field" placeholder="e.g. 16 inch">
                        </div>
                    </div>

                    <!-- Image Upload for Variant -->
                    <div class="space-y-4">
                        <div id="existingImagesContainer" class="hidden space-y-4">
                            <label class="input-label">Existing Images (Click to remove)</label>
                            <div id="existingImagesPreview" class="flex flex-wrap gap-4"></div>
                        </div>

                        <label class="input-label">Upload New Images (Min 3 total required)</label>
                        <label for="variantImageUpload" class="upload-zone">
                            <span class="material-symbols-outlined text-primary text-3xl mb-2">cloud_upload</span>
                            <p class="text-sm font-bold">Click to upload images for this color/variant</p>
                            <input type="file" id="variantImageUpload" name="images" multiple accept="image/*"
                                class="hidden" onchange="previewVariantImages(event)">
                        </label>
                        <p id="images-error" class="field-error"></p>
                        <div id="variantImagePreview" class="flex flex-wrap gap-4 mt-6"></div>
                        <div id="removedImagesContainer"></div>
                    </div>

                    <div class="pt-6 border-t border-white/5 flex justify-end gap-4">
                        <button type="button" onclick="closeModal()"
                            class="px-8 py-3 rounded-full text-sm font-bold text-slate-400 hover:text-white transition-colors uppercase">Cancel</button>
                        <button type="submit" id="submitBtn"
                            class="px-10 py-3 bg-primary hover:bg-primary/90 text-white rounded-full font-bold text-sm tracking-wide shadow-lg uppercase">Create
                            Variant</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Same Cropper Modal as before -->
        <div id="cropperModal" class="fixed inset-0 z-[999] hidden bg-black/90 flex items-center justify-center p-4">
            <div class="bg-panel-bg w-full max-w-2xl rounded-[32px] overflow-hidden border border-white/10">
                <div class="p-6 border-b border-white/5 flex justify-between">
                    <h3 class="text-xl font-bold">Crop Variant Image</h3>
                    <button type="button" onclick="closeCropper()" class="text-slate-400"><span
                            class="material-symbols-outlined">close</span></button>
                </div>
                <div class="p-6 max-h-[60vh] overflow-hidden flex items-center justify-center">
                    <img id="cropperImage" src="" class="max-w-full">
                </div>
                <div class="p-6 border-t border-white/5 flex justify-end gap-4">
                    <button type="button" onclick="closeCropper()"
                        class="px-6- py-2 text-slate-400 font-bold">CANCEL</button>
                    <button type="button" onclick="cropImage()"
                        class="px-8 py-3 bg-primary rounded-full text-sm font-bold text-white shadow-lg">CROP &
                        ADD</button>
                </div>
            </div>
        </div>

        <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.js"></script>
        <script id="product-variants-data" type="application/json">
        <%- JSON.stringify(product.variants) %>
    </script>
        <script id="last-variant-data" type="application/json">
        <%- JSON.stringify(lastVariant || null) %>
    </script>
        <script>
            const productVariants = JSON.parse(document.getElementById('product-variants-data').textContent);
            const lastVariant = JSON.parse(document.getElementById('last-variant-data').textContent);
            const productId = '<%= product._id %>';
        </script>
        <script src="/js/admin/product/manage-variants.js"></script>

</body>

</html>