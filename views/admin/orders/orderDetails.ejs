<!DOCTYPE html>
<html class="dark" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Admin - Order #<%= order.orderId %>
    </title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#0055ff",
                        "background-dark": "#0d0d0d",
                        "card-bg": "rgba(23, 33, 54, 0.4)",
                    },
                    fontFamily: {
                        "display": ["Space Grotesk", "sans-serif"]
                    },
                },
            },
        }
    </script>
    <link rel="stylesheet" href="/css/views/admin/orders/orderDetails.css">
</head>

<body class="bg-background-dark font-display text-slate-200">
    <div class="flex h-screen overflow-hidden">
        <%- include('../../partials/admin/sidebar') %>

            <main class="flex-1 flex flex-col overflow-y-auto"> 
                <header
                    class="flex items-center justify-between px-8 py-4 border-b border-white/5 bg-background-dark/50 backdrop-blur-md sticky top-0 z-10">
                    <div class="flex items-center gap-4">
                        <a href="/admin/orders" class="p-2 hover:bg-white/5 rounded-lg transition-colors">
                            <span class="material-symbols-outlined">arrow_back</span>
                        </a>
                        <h1 class="text-lg font-bold">Order Details</h1>
                    </div>
                </header>

                <div class="p-8 max-w-7xl mx-auto w-full space-y-8 pb-20">
                    <!-- Order Header -->
                    <!--invoice -->
                    <% if (["Shipped","Out for Delivery","Delivered"].includes(order.status)) { %>
                        <button onclick="downloadInvoice('<%= order._id %>')"
                            class="bg-primary/10 hover:bg-primary/20 text-primary px-6 py-2.5 rounded-xl text-sm font-bold transition-all flex items-center gap-2 border border-primary/10">
                            <span class="material-symbols-outlined text-lg">download</span>
                            Invoice
                        </button>
                        <% } %>
                            <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
                                <div
                                    class="md:col-span-3 p-8 rounded-[2rem] bg-card-bg border border-white/5 flex flex-col md:flex-row justify-between items-center gap-8 shadow-2xl relative overflow-hidden group">
                                    <div
                                        class="absolute top-0 right-0 w-32 h-32 bg-primary/5 blur-3xl -mr-16 -mt-16 group-hover:bg-primary/10 transition-colors">
                                    </div>
                                    <div class="relative z-10">
                                        <p
                                            class="text-[10px] font-black text-slate-500 uppercase tracking-[0.3em] mb-2">
                                            Transaction Reference</p>
                                        <h2
                                            class="text-3xl font-black text-white tracking-tighter flex items-center gap-3">
                                            <span class="text-primary">#</span>
                                            <%= order.orderId %>
                                        </h2>
                                        <p class="text-xs font-bold text-slate-500 mt-3 flex items-center gap-2">
                                            <span class="material-symbols-outlined text-sm">calendar_today</span>
                                            <%= new Date(order.createdAt).toLocaleDateString('en-US', { weekday: 'long'
                                                , year: 'numeric' , month: 'long' , day: 'numeric' , hour: '2-digit' ,
                                                minute: '2-digit' }) %>
                                        </p>
                                    </div>
                                    <div class="text-center md:text-right relative z-10">
                                        <p
                                            class="text-[10px] font-black text-slate-500 uppercase tracking-[0.3em] mb-3">
                                            Fulfillment State</p>
                                        <% let statusClass='status-pending' ; if (order.status==='Shipped' )
                                            statusClass='status-shipped' ; if (order.status==='Out for Delivery' )
                                            statusClass='status-out-for-delivery' ; if (order.status==='Delivered' )
                                            statusClass='status-delivered' ; if (order.status==='Cancelled' )
                                            statusClass='status-cancelled' ; if (order.status==='Return Request' )
                                            statusClass='status-return-request' ; if (order.status==='Returned' )
                                            statusClass='status-returned' ; %>
                                            <span
                                                class="status-badge <%= statusClass %> text-sm py-2.5 px-6 shadow-lg shadow-current/10">
                                                <%= order.status %>
                                            </span>
                                    </div>
                                </div>
                                <div
                                    class="p-8 rounded-[2rem] bg-primary border border-primary/20 shadow-2xl shadow-primary/20 flex flex-col justify-center items-center relative overflow-hidden group">
                                    <div
                                        class="absolute inset-0 bg-white/10 opacity-0 group-hover:opacity-100 transition-opacity">
                                    </div>
                                    <p class="text-[10px] font-black text-white/60 uppercase tracking-[0.3em] mb-2">
                                        Total Value
                                    </p>
                                    <h2 class="text-4xl font-black text-white tracking-tighter">₹<%=
                                            order.finalAmount.toLocaleString() %>
                                    </h2>
                                    <div class="mt-4 flex flex-wrap justify-center gap-2">
                                        <span
                                            class="px-2 py-1 rounded-lg bg-white/20 text-white text-[9px] font-black uppercase tracking-wider">
                                            <%= order.paymentStatus %>
                                        </span>
                                        <span
                                            class="px-2 py-1 rounded-lg bg-white/20 text-white text-[9px] font-black uppercase tracking-wider">
                                            <%= order.paymentMethod %>
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <% if (order.status==='Return Request' || order.status==='Returned' ||
                                order.status==='Cancelled' ) { %>
                                <div
                                    class="p-8 rounded-[2rem] bg-rose-500/10 border border-rose-500/20 shadow-2xl relative overflow-hidden group">
                                    <div class="absolute top-0 right-0 w-32 h-32 bg-rose-500/5 blur-3xl -mr-16 -mt-16">
                                    </div>
                                    <div class="flex flex-col md:flex-row items-center gap-6">
                                        <div
                                            class="size-16 rounded-3xl bg-rose-500 flex items-center justify-center text-white shadow-xl shadow-rose-500/20 flex-shrink-0">
                                            <span class="material-symbols-outlined text-3xl">
                                                <%= order.status==='Cancelled' ? 'cancel' : 'keyboard_return' %>
                                            </span>
                                        </div>
                                        <div>
                                            <h4 class="text-xl font-black text-rose-500 tracking-tight uppercase mb-1">
                                                <%= order.status==='Return Request' ? 'Action Required: Return Request'
                                                    : order.status==='Returned' ? 'Order Returned' : 'Order Cancelled'
                                                    %>
                                            </h4>
                                            <p class="text-slate-200 font-medium text-lg italic">
                                                "<%= order.returnReason || order.cancellationReason
                                                    || 'No reason provided' %>"
                                            </p>
                                            <p class="text-slate-500 text-xs mt-3 font-bold uppercase tracking-widest">
                                                Submitted
                                                by Customer</p>
                                        </div>
                                    </div>
                                </div>
                                <% } %>

                                    <!-- Order Timeline -->
                                    <div
                                        class="p-10 rounded-[2.5rem] bg-card-bg border border-white/5 relative overflow-hidden">
                                        <div class="flex items-center justify-between relative z-10">
                                            <% const statuses=['Pending', 'Shipped' , 'Out for Delivery' , 'Delivered'
                                                ]; const currentIndex=statuses.indexOf(order.status); const
                                                isCancelled=order.status==='Cancelled' ; %>

                                                <% if (!isCancelled) { %>
                                                    <% statuses.forEach((status, index)=> { %>
                                                        <div
                                                            class="flex flex-col items-center gap-4 relative z-10 flex-1 group/item">
                                                            <div
                                                                class="size-12 rounded-2xl flex items-center justify-center transition-all duration-700 <%= index <= currentIndex ? 'bg-primary text-white shadow-[0_0_30px_rgba(0,85,255,0.4)] scale-110' : 'bg-white/5 text-slate-600 border border-white/5' %>">
                                                                <span class="material-symbols-outlined text-xl">
                                                                    <%= status==='Pending' ? 'shopping_cart' :
                                                                        status==='Shipped' ? 'local_shipping' :
                                                                        status==='Out for Delivery' ? 'delivery_dining'
                                                                        : 'task_alt' %>
                                                                </span>
                                                            </div>
                                                            <div class="text-center">
                                                                <p
                                                                    class="text-[10px] font-black uppercase tracking-[0.2em] <%= index <= currentIndex ? 'text-white' : 'text-slate-600' %>">
                                                                    <%= status %>
                                                                </p>
                                                                <p class="text-[8px] text-slate-500 mt-1">
                                                                    <%= index <=currentIndex ? 'Completed' : 'Upcoming'
                                                                        %>
                                                                </p>
                                                            </div>

                                                            <% if (index < statuses.length - 1) { %>
                                                                <div
                                                                    class="absolute left-1/2 top-6 w-full h-[1px] bg-white/5 -z-10">
                                                                    <div class="h-full bg-primary/40 transition-all duration-1000"
                                                                        style="width: <%= index < currentIndex ? '100%' : '0%' %>">
                                                                    </div>
                                                                </div>
                                                                <% } %>
                                                        </div>
                                                        <% }) %>
                                                            <% } else { %>
                                                                <div
                                                                    class="flex items-center gap-6 w-full p-6 rounded-3xl bg-rose-500/5 border border-rose-500/10">
                                                                    <div
                                                                        class="size-16 rounded-3xl bg-rose-500 flex items-center justify-center text-white shadow-xl shadow-rose-500/20">
                                                                        <span
                                                                            class="material-symbols-outlined text-4xl">cancel</span>
                                                                    </div>
                                                                    <div>
                                                                        <h4
                                                                            class="text-2xl font-black text-rose-500 tracking-tight">
                                                                            Order Cancelled</h4>
                                                                        <p class="text-slate-400 text-sm mt-1">This
                                                                            transaction
                                                                            was terminated and inventory has been
                                                                            restored.</p>
                                                                    </div>
                                                                </div>
                                                                <% } %>
                                        </div>
                                    </div>

                                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                                        <!-- Left: Customer and Items -->
                                        <div class="lg:col-span-2 space-y-8">
                                            <!-- Customer Card -->
                                            <div
                                                class="p-8 rounded-[2.5rem] bg-card-bg border border-white/5 relative overflow-hidden group">
                                                <div
                                                    class="absolute top-0 left-0 w-48 h-48 bg-primary/5 blur-3xl -ml-24 -mt-24">
                                                </div>
                                                <h3
                                                    class="text-lg font-black text-white flex items-center gap-3 mb-8 relative z-10">
                                                    <span
                                                        class="size-8 rounded-xl bg-primary/10 flex items-center justify-center text-primary">
                                                        <span
                                                            class="material-symbols-outlined text-lg">account_circle</span>
                                                    </span>
                                                    Client Identity
                                                </h3>
                                                <div class="grid grid-cols-1 md:grid-cols-2 gap-10 relative z-10">
                                                    <div class="flex items-center gap-5">
                                                        <div
                                                            class="size-16 rounded-3xl bg-primary flex items-center justify-center text-xl font-black text-white shadow-xl shadow-primary/20">
                                                            <%= order.userId ? order.userId.fullname.charAt(0) : 'U' %>
                                                        </div>
                                                        <div>
                                                            <p
                                                                class="text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1">
                                                                Full Legal Name</p>
                                                            <p class="text-xl font-bold text-white tracking-tight">
                                                                <%= order.userId ? order.userId.fullname
                                                                    : 'Unknown User' %>
                                                            </p>
                                                            <p class="text-sm font-medium text-primary mt-1">
                                                                <%= order.userId ? order.userId.email
                                                                    : 'No email provided' %>
                                                            </p>
                                                        </div>
                                                    </div>
                                                    <div class="flex items-center gap-5">
                                                        <div
                                                            class="size-16 rounded-3xl bg-white/5 flex items-center justify-center text-slate-400 border border-white/5">
                                                            <span class="material-symbols-outlined">call</span>
                                                        </div>
                                                        <div>
                                                            <p
                                                                class="text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1">
                                                                Direct Contact</p>
                                                            <p class="text-xl font-bold text-white tracking-tight">
                                                                <%= order.shippingAddress.phone %>
                                                            </p>
                                                            <p
                                                                class="text-sm font-medium text-emerald-500 mt-1 flex items-center gap-1">
                                                                <span
                                                                    class="size-1.5 rounded-full bg-current animate-pulse"></span>
                                                                Verified Phone
                                                            </p>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Items List -->
                                            <div
                                                class="rounded-[2.5rem] bg-card-bg border border-white/5 overflow-hidden shadow-2xl">
                                                <div
                                                    class="p-8 border-b border-white/5 flex items-center justify-between">
                                                    <h3 class="text-lg font-black text-white flex items-center gap-3">
                                                        <span
                                                            class="size-8 rounded-xl bg-primary/10 flex items-center justify-center text-primary">
                                                            <span class="material-symbols-outlined text-lg">box</span>
                                                        </span>
                                                        Inventory Summary
                                                    </h3>
                                                    <span
                                                        class="text-[10px] font-black text-slate-500 uppercase tracking-widest">
                                                        <%= order.orderedItems.length %> Distinct Items
                                                    </span>
                                                </div>
                                                <div class="divide-y divide-white/5">
                                                    <% order.orderedItems.forEach(item=> { %>
                                                        <div
                                                            class="p-8 flex items-center gap-8 hover:bg-white/[0.02] transition-colors group">
                                                            <div
                                                                class="size-28 rounded-3xl bg-slate-900 border border-white/5 overflow-hidden flex-shrink-0 shadow-2xl relative">
                                                                <% const variant=item.product?.variants?.find(v=>
                                                                    v._id.toString() === item.variantId.toString()); %>
                                                                    <% if (item.product && variant) { %>
                                                                        <img src="<%= variant.images[0] %>"
                                                                            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500">
                                                                        <% } else { %>
                                                                            <div
                                                                                class="w-full h-full bg-white/5 flex items-center justify-center">
                                                                                <span
                                                                                    class="material-symbols-outlined text-white/20 text-4xl">inventory_2</span>
                                                                            </div>
                                                                            <% } %>
                                                                                <div
                                                                                    class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity">
                                                                                </div>
                                                            </div>
                                                            <div class="flex-1">
                                                                <div class="flex justify-between items-start">
                                                                    <div>
                                                                        <h4
                                                                            class="text-xl font-black text-white tracking-tight group-hover:text-primary transition-colors">
                                                                            <%= item.product?.name
                                                                                || "Product Unavailable" %>
                                                                        </h4>
                                                                        <div class="flex items-center gap-3 mt-3">
                                                                            <span
                                                                                class="px-3 py-1 rounded-full bg-white/5 border border-white/5 text-[10px] font-black text-slate-400 uppercase tracking-widest">
                                                                                <%= variant?.color %>
                                                                            </span>
                                                                            <span
                                                                                class="px-3 py-1 rounded-full bg-white/5 border border-white/5 text-[10px] font-black text-slate-400 uppercase tracking-widest">
                                                                                <%= variant?.storage || variant?.ram
                                                                                    || 'Standard' %>
                                                                            </span>
                                                                            <!-- Item Status -->
                                                                            <div class="flex items-center gap-2">
                                                                                <span
                                                                                    class="status-badge status-<%= item.status.toLowerCase().replace(/\s+/g, '-') %> text-[9px] py-1 px-3">
                                                                                    <%= item.status %>
                                                                                </span>
                                                                                <% if (!['Cancelled', 'Returned'].includes(item.status)) { %>
                                                                                <button
                                                                                    onclick="updateItemStatus('<%= order._id %>', '<%= item._id %>', '<%= item.status %>')"
                                                                                    class="p-1 rounded-md bg-white/5 hover:bg-primary/10 text-slate-500 hover:text-primary transition-all">
                                                                                    <span
                                                                                        class="material-symbols-outlined text-[14px]">edit</span>
                                                                                </button>
                                                                                <% } %>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="text-right">
                                                                        <p
                                                                            class="text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1">
                                                                            Unit Price</p>
                                                                        <p class="text-xl font-black text-white">₹<%=
                                                                                item.price.toLocaleString() %>
                                                                        </p>
                                                                        <p
                                                                            class="text-xs font-bold text-slate-500 mt-1">
                                                                            x <%= item.quantity %>
                                                                        </p>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <% }) %>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Right: Address and Summary -->
                                        <div class="space-y-8">
                                            <!-- Address Card -->
                                            <div
                                                class="p-8 rounded-[2.5rem] bg-card-bg border border-white/5 relative overflow-hidden group">
                                                <div
                                                    class="absolute bottom-0 right-0 w-32 h-32 bg-primary/5 blur-3xl -mr-16 -mb-16">
                                                </div>
                                                <h3 class="text-lg font-black text-white flex items-center gap-3 mb-8">
                                                    <span
                                                        class="size-8 rounded-xl bg-primary/10 flex items-center justify-center text-primary">
                                                        <span class="material-symbols-outlined text-lg">distance</span>
                                                    </span>
                                                    Destination
                                                </h3>
                                                <div class="space-y-4">
                                                    <div class="p-4 rounded-2xl bg-white/5 border border-white/5">
                                                        <p
                                                            class="text-[10px] font-black text-slate-500 uppercase tracking-widest mb-2">
                                                            Recipient</p>
                                                        <p class="text-lg font-bold text-white tracking-tight">
                                                            <%= order.shippingAddress.fullname %>
                                                        </p>
                                                    </div>
                                                    <div class="p-4 rounded-2xl bg-white/5 border border-white/5">
                                                        <p
                                                            class="text-[10px] font-black text-slate-500 uppercase tracking-widest mb-2">
                                                            Full Address</p>
                                                        <p class="text-sm font-medium text-slate-300 leading-relaxed">
                                                            <%= order.shippingAddress.line1 %><br>
                                                                <% if (order.shippingAddress.line2) { %>
                                                                    <%= order.shippingAddress.line2 %><br>
                                                                        <% } %>
                                                                            <span class="text-white font-bold">
                                                                                <%= order.shippingAddress.city %>, <%=
                                                                                        order.shippingAddress.state %>
                                                                            </span><br>
                                                                            <span class="text-primary font-black">
                                                                                <%= order.shippingAddress.postal_code %>
                                                                            </span>
                                                        </p>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Financial Summary -->
                                            <div
                                                class="p-8 rounded-[2.5rem] bg-card-bg border border-white/5 space-y-6 relative overflow-hidden group">
                                                <div
                                                    class="absolute top-0 right-0 w-32 h-32 bg-primary/5 blur-3xl -mr-16 -mt-16">
                                                </div>
                                                <h3 class="text-lg font-black text-white flex items-center gap-3 mb-2">
                                                    <span
                                                        class="size-8 rounded-xl bg-primary/10 flex items-center justify-center text-primary">
                                                        <span
                                                            class="material-symbols-outlined text-lg">receipt_long</span>
                                                    </span>
                                                    Financials
                                                </h3>
                                                <div class="space-y-4 relative z-10">
                                                    <div class="flex justify-between items-center text-sm">
                                                        <span
                                                            class="text-slate-500 font-bold uppercase tracking-widest text-[10px]">Gross
                                                            Subtotal</span>
                                                        <span class="text-white font-black">₹<%=
                                                                order.totalPrice.toLocaleString() %></span>
                                                    </div>
                                                    <div class="flex justify-between items-center text-sm">
                                                        <span
                                                            class="text-slate-500 font-bold uppercase tracking-widest text-[10px]">Fulfillment
                                                            Fee</span>
                                                        <span
                                                            class="text-emerald-500 font-black uppercase text-[10px] tracking-widest">Complimentary</span>
                                                    </div>
                                                    <% if (order.discount> 0) { %>
                                                        <div class="flex justify-between items-center text-sm">
                                                            <span
                                                                class="text-slate-500 font-bold uppercase tracking-widest text-[10px]">Applied
                                                                Discount</span>
                                                            <span class="text-rose-500 font-black">-₹<%=
                                                                    order.discount.toLocaleString() %></span>
                                                        </div>
                                                        <% } %>
                                                            <div class="h-px bg-white/5 my-6"></div>
                                                            <div class="flex justify-between items-end">
                                                                <div>
                                                                    <p
                                                                        class="text-[10px] font-black text-slate-500 uppercase tracking-[0.3em] mb-1">
                                                                        Net Settlement</p>
                                                                    <p
                                                                        class="text-3xl font-black text-white tracking-tighter">
                                                                        ₹
                                                                        <%= order.finalAmount.toLocaleString() %>
                                                                    </p>
                                                                </div>
                                                                <div class="text-right">
                                                                    <span
                                                                        class="px-3 py-1 rounded-lg bg-emerald-500/10 text-emerald-500 text-[10px] font-black uppercase tracking-widest border border-emerald-500/20">Fully
                                                                        Settled</span>
                                                                </div>
                                                            </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                </div>
            </main>
    </div>
    <script src="/js/admin/orders/orderDetails.js"></script>
    
</body>

</html>