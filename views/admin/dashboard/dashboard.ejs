<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard | MH SPARE HUB</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
  <!-- Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "primary": "#0055ff",
            "background-dark": "#0d0d0d",
          },
          fontFamily: {
            "display": ["Space Grotesk", "sans-serif"]
          },
        },
      },
    }
  </script>
  <link rel="stylesheet" href="/css/views/admin/dashboard/dashboard.css">
</head>

<body>
  <%- include('../../partials/admin/sidebar') %>
  <main class="dashboard-main">
    <%- include('../../partials/admin/header') %>
    <div class="dashboard-body">

      <!-- Page Title -->
      <div class="page-title-row">
        <div>
          <div class="page-title">Dashboard</div>
          <div class="page-subtitle">Welcome back! Here's what's happening today.</div>
        </div>
        <div class="page-date" id="dashDate"></div>
      </div>

      <!-- ============ STAT CARDS ============ -->
      <section class="stat-cards-grid">

        <!-- Total Revenue -->
        <div class="stat-card">
          <div class="stat-card-header">
            <span class="stat-card-label">Total Revenue</span>
            <div class="stat-card-icon blue">
              <span class="material-symbols-outlined" style="font-size:20px;">payments</span>
            </div>
          </div>
          <div class="stat-card-value">₹<%= totalRevenue ? totalRevenue.toLocaleString('en-IN') : '0' %></div>
          <div class="stat-card-sub">Lifetime earnings</div>
          <div class="stat-card-sparkline">
            <svg viewBox="0 0 200 60" preserveAspectRatio="none">
              <path class="glow-line" d="M0 50 Q 25 45, 50 35 T 100 40 T 150 20 T 200 10" fill="none" stroke="#2563eb" stroke-width="2.5"></path>
              <path d="M0 50 Q 25 45, 50 35 T 100 40 T 150 20 T 200 10 L200 60 L0 60 Z" fill="rgba(37,99,235,0.06)"></path>
            </svg>
          </div>
        </div>

        <!-- Total Orders -->
        <div class="stat-card">
          <div class="stat-card-header">
            <span class="stat-card-label">Total Orders</span>
            <div class="stat-card-icon green">
              <span class="material-symbols-outlined" style="font-size:20px;">local_shipping</span>
            </div>
          </div>
          <div class="stat-card-value"><%= totalOrders || 0 %></div>
          <div class="stat-card-sub">Completed orders</div>
          <div class="stat-card-bar">
            <div class="stat-card-bar-fill fill-green" style="width: 100%;"></div>
          </div>
        </div>

        <!-- Total Users -->
        <div class="stat-card">
          <div class="stat-card-header">
            <span class="stat-card-label">Total Users</span>
            <div class="stat-card-icon amber">
              <span class="material-symbols-outlined" style="font-size:20px;">group_add</span>
            </div>
          </div>
          <div class="stat-card-value"><%= totalUsers || 0 %></div>
          <div class="stat-card-sub">Registered customers</div>
          <div class="stat-card-bar">
            <div class="stat-card-bar-fill fill-amber" style="width: 100%;"></div>
          </div>
        </div>

        <!-- Total Products -->
        <div class="stat-card">
          <div class="stat-card-header">
            <span class="stat-card-label">Products</span>
            <div class="stat-card-icon blue">
              <span class="material-symbols-outlined" style="font-size:20px;">inventory_2</span>
            </div>
          </div>
          <div class="stat-card-value"><%= totalProducts || 0 %></div>
          <div class="stat-card-sub">Active products in store</div>
          <div class="stat-card-bar">
            <div class="stat-card-bar-fill fill-blue" style="width: 100%;"></div>
          </div>
        </div>

      </section>

      <!-- ============ SALES CHART ============ -->
      <section class="chart-card">
        <div class="chart-card-header">
          <div>
            <div class="chart-card-title">Sales Analytics</div>
            <div class="chart-card-subtitle">Revenue Overview</div>
          </div>
          <select id="chartFilter" class="chart-filter-select">
            <option value="weekly">Weekly</option>
            <option value="monthly" selected>Monthly</option>
            <option value="yearly">Yearly</option>
          </select>
        </div>
        <div class="chart-body">
          <canvas id="salesChart"></canvas>
        </div>
      </section>

      <!-- ============ TOP 10 LISTS ============ -->
      <section class="top-lists-grid">

        <!-- Top Products -->
        <div class="top-list-card">
          <div class="top-list-header">
            <div class="top-list-title">Top 10 Products</div>
            <div class="top-list-sub">Best-selling by units</div>
          </div>
          <div class="top-list-body">
            <% if (topProducts && topProducts.length > 0) { %>
              <% topProducts.forEach((product, index) => { %>
                <% const maxQty = topProducts[0].totalQuantity; const percentage = (product.totalQuantity / maxQty) * 100; %>
                <div class="top-list-item">
                  <div class="top-list-rank"><%= (index + 1).toString().padStart(2, '0') %></div>
                  <div class="top-list-info">
                    <div class="top-list-name-row">
                      <span class="top-list-name"><%= product.name %></span>
                      <span class="top-list-qty"><%= product.totalQuantity %> units</span>
                    </div>
                    <div class="top-list-bar-wrap">
                      <div class="top-list-bar bar-blue" style="width: <%= percentage %>%"></div>
                    </div>
                  </div>
                </div>
              <% }) %>
            <% } else { %>
              <div class="top-list-empty">No product sales yet</div>
            <% } %>
          </div>
        </div>

        <!-- Top Categories -->
        <div class="top-list-card">
          <div class="top-list-header">
            <div class="top-list-title">Top 10 Categories</div>
            <div class="top-list-sub">Best-selling by units</div>
          </div>
          <div class="top-list-body">
            <% if (topCategories && topCategories.length > 0) { %>
              <% topCategories.forEach((category, index) => { %>
                <% const maxQty = topCategories[0].totalQuantity; const percentage = (category.totalQuantity / maxQty) * 100; %>
                <div class="top-list-item">
                  <div class="top-list-rank"><%= (index + 1).toString().padStart(2, '0') %></div>
                  <div class="top-list-info">
                    <div class="top-list-name-row">
                      <span class="top-list-name"><%= category.name %></span>
                      <span class="top-list-qty"><%= category.totalQuantity %> units</span>
                    </div>
                    <div class="top-list-bar-wrap">
                      <div class="top-list-bar bar-green" style="width: <%= percentage %>%"></div>
                    </div>
                  </div>
                </div>
              <% }) %>
            <% } else { %>
              <div class="top-list-empty">No category sales yet</div>
            <% } %>
          </div>
        </div>

        <!-- Top Brands -->
        <div class="top-list-card">
          <div class="top-list-header">
            <div class="top-list-title">Top 10 Brands</div>
            <div class="top-list-sub">Best-selling by units</div>
          </div>
          <div class="top-list-body">
            <% if (topBrands && topBrands.length > 0) { %>
              <% topBrands.forEach((brand, index) => { %>
                <% const maxQty = topBrands[0].totalQuantity; const percentage = (brand.totalQuantity / maxQty) * 100; %>
                <div class="top-list-item">
                  <div class="top-list-rank"><%= (index + 1).toString().padStart(2, '0') %></div>
                  <div class="top-list-info">
                    <div class="top-list-name-row">
                      <span class="top-list-name"><%= brand.name %></span>
                      <span class="top-list-qty"><%= brand.totalQuantity %> units</span>
                    </div>
                    <div class="top-list-bar-wrap">
                      <div class="top-list-bar bar-amber" style="width: <%= percentage %>%"></div>
                    </div>
                  </div>
                </div>
              <% }) %>
            <% } else { %>
              <div class="top-list-empty">No brand sales yet</div>
            <% } %>
          </div>
        </div>

      </section>

    </div>
  </main>

  <script src="/js/admin/dashboard/dashboard.js"></script>
  <script>
    // Set today's date in header
    document.getElementById('dashDate').textContent = new Date().toLocaleDateString('en-IN', {
      weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'
    });
  </script>
</body>
</html>