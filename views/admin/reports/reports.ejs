<!DOCTYPE html>
<html class="dark" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>TechKart Admin - Sales Reports</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- PDF -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
    <!-- Excel -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: { "primary": "#0055ff", "background-dark": "#0d0d0d", "card-bg": "#121620" },
                    fontFamily: { "display": ["Space Grotesk", "sans-serif"] },
                },
            },
        }
    </script>
    <link rel="stylesheet" href="/css/views/admin/reports/reports.css">
</head>

<body class="flex min-h-screen bg-[#0D0D0D]">
    <%- include('../../partials/admin/sidebar') %>

    <main class="flex-1 flex flex-col relative overflow-y-auto custom-scrollbar">
        <%- include('../../partials/admin/header') %>

        <div class="p-8 lg:p-12 space-y-8">

            <!-- Page Header -->
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                <div>
                    <h2 class="text-3xl font-bold tracking-tight mb-1">Sales Reports</h2>
                    <p class="text-sm text-slate-500 font-medium">Track revenue, orders, and discount analytics</p>
                </div>
                <!-- Download Buttons -->
                <div class="flex items-center gap-3">
                    <button onclick="downloadExcel()" id="excelBtn"
                        class="flex items-center gap-2 px-5 py-2.5 rounded-full border border-emerald-500/30 text-emerald-400 hover:bg-emerald-500/10 text-xs font-bold uppercase tracking-wide transition-all">
                        <span class="material-symbols-outlined text-[16px]">table_view</span>
                        Excel
                    </button>
                    <button onclick="downloadPDF()" id="pdfBtn"
                        class="flex items-center gap-2 px-5 py-2.5 rounded-full border border-rose-500/30 text-rose-400 hover:bg-rose-500/10 text-xs font-bold uppercase tracking-wide transition-all">
                        <span class="material-symbols-outlined text-[16px]">picture_as_pdf</span>
                        PDF
                    </button>
                </div>
            </div>

            <!-- Filter Tabs + Custom Date -->
            <div class="glass-morphism rounded-2xl p-5 flex flex-wrap items-center gap-4">
                <div class="flex items-center gap-2 flex-wrap" id="filterTabs">
                    <button class="filter-tab active" data-filter="today" onclick="setFilter(this, 'today')">Today</button>
                    <button class="filter-tab" data-filter="weekly" onclick="setFilter(this, 'weekly')">Weekly</button>
                    <button class="filter-tab" data-filter="monthly" onclick="setFilter(this, 'monthly')">Monthly</button>
                    <button class="filter-tab" data-filter="yearly" onclick="setFilter(this, 'yearly')">Yearly</button>
                    <button class="filter-tab" data-filter="custom" onclick="setFilter(this, 'custom')">Custom</button>
                </div>

                <!-- Custom Date Range -->
                <div id="customDateRange" class="hidden flex items-center gap-3 ml-auto">
                    <div class="flex items-center gap-2">
                        <label class="text-[10px] text-slate-500 font-bold uppercase">From</label>
                        <input type="date" id="startDate"
                            class="bg-white/5 border border-white/10 rounded-xl px-4 py-2 text-sm text-white focus:outline-none focus:border-primary transition-all" />
                    </div>
                    <div class="flex items-center gap-2">
                        <label class="text-[10px] text-slate-500 font-bold uppercase">To</label>
                        <input type="date" id="endDate"
                            class="bg-white/5 border border-white/10 rounded-xl px-4 py-2 text-sm text-white focus:outline-none focus:border-primary transition-all" />
                    </div>
                    <button onclick="applyCustomFilter()"
                        class="px-5 py-2 bg-primary rounded-xl text-xs font-bold text-white hover:bg-primary/90 transition-all">
                        Apply
                    </button>
                </div>

                <!-- Period Label -->
                <div class="ml-auto hidden md:flex items-center gap-2" id="periodLabel">
                    <span class="material-symbols-outlined text-slate-500 text-[16px]">calendar_month</span>
                    <span id="periodText" class="text-[11px] text-slate-500 font-medium uppercase tracking-widest">Today</span>
                </div>
            </div>

            <!-- Summary Cards -->
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-5" id="summaryCards">

                <!-- Total Revenue -->
                <div class="stat-card">
                    <div class="flex items-center justify-between">
                        <p class="text-[10px] font-bold text-slate-500 uppercase tracking-widest">Total Revenue</p>
                        <div class="w-9 h-9 rounded-xl bg-primary/10 flex items-center justify-center">
                            <span class="material-symbols-outlined text-primary text-[18px]">currency_rupee</span>
                        </div>
                    </div>
                    <p class="text-2xl font-bold tracking-tight" id="statRevenue">
                        &#8377;<%= typeof totalRevenue !== 'undefined' ? totalRevenue.toLocaleString('en-IN') : '0' %>
                    </p>
                    <p class="text-[10px] text-emerald-400 font-bold flex items-center gap-1">
                        <span class="material-symbols-outlined text-[14px]">trending_up</span>
                        Gross order value
                    </p>
                    <div class="absolute bottom-0 right-0 w-24 h-24 bg-primary/5 blur-[40px] rounded-full pointer-events-none"></div>
                </div>

                <!-- Total Orders -->
                <div class="stat-card">
                    <div class="flex items-center justify-between">
                        <p class="text-[10px] font-bold text-slate-500 uppercase tracking-widest">Total Orders</p>
                        <div class="w-9 h-9 rounded-xl bg-violet-500/10 flex items-center justify-center">
                            <span class="material-symbols-outlined text-violet-400 text-[18px]">shopping_bag</span>
                        </div>
                    </div>
                    <p class="text-2xl font-bold tracking-tight" id="statOrders">
                        <%= typeof totalOrders !== 'undefined' ? totalOrders : '0' %>
                    </p>
                    <p class="text-[10px] text-slate-500 font-bold flex items-center gap-1">
                        <span class="material-symbols-outlined text-[14px]">orders</span>
                        Completed orders
                    </p>
                    <div class="absolute bottom-0 right-0 w-24 h-24 bg-violet-500/5 blur-[40px] rounded-full pointer-events-none"></div>
                </div>

                <!-- Total Discount -->
                <div class="stat-card">
                    <div class="flex items-center justify-between">
                        <p class="text-[10px] font-bold text-slate-500 uppercase tracking-widest">Total Discount</p>
                        <div class="w-9 h-9 rounded-xl bg-amber-500/10 flex items-center justify-center">
                            <span class="material-symbols-outlined text-amber-400 text-[18px]">confirmation_number</span>
                        </div>
                    </div>
                    <p class="text-2xl font-bold tracking-tight text-amber-400" id="statDiscount">
                        &#8377;<%= typeof totalDiscount !== 'undefined' ? totalDiscount.toLocaleString('en-IN') : '0' %>
                    </p>
                    <p class="text-[10px] text-slate-500 font-bold flex items-center gap-1">
                        <span class="material-symbols-outlined text-[14px]">loyalty</span>
                        Coupon deductions
                    </p>
                    <div class="absolute bottom-0 right-0 w-24 h-24 bg-amber-500/5 blur-[40px] rounded-full pointer-events-none"></div>
                </div>

                <!-- Net Revenue -->
                <div class="stat-card">
                    <div class="flex items-center justify-between">
                        <p class="text-[10px] font-bold text-slate-500 uppercase tracking-widest">Net Revenue</p>
                        <div class="w-9 h-9 rounded-xl bg-emerald-500/10 flex items-center justify-center">
                            <span class="material-symbols-outlined text-emerald-400 text-[18px]">account_balance_wallet</span>
                        </div>
                    </div>
                    <p class="text-2xl font-bold tracking-tight text-emerald-400" id="statNet">
                        &#8377;<%= typeof netRevenue !== 'undefined' ? netRevenue.toLocaleString('en-IN') : '0' %>
                    </p>
                    <p class="text-[10px] text-slate-500 font-bold flex items-center gap-1">
                        <span class="material-symbols-outlined text-[14px]">paid</span>
                        After all deductions
                    </p>
                    <div class="absolute bottom-0 right-0 w-24 h-24 bg-emerald-500/5 blur-[40px] rounded-full pointer-events-none"></div>
                </div>
            </div>

            <!-- Chart -->
            <section class="glass-morphism rounded-2xl p-8">
                <div class="flex items-center justify-between mb-6">
                    <div>
                        <h3 class="text-base font-bold">Revenue Overview</h3>
                        <p class="text-[11px] text-slate-500 mt-0.5">Order amount vs discount deductions</p>
                    </div>
                    <div class="flex items-center gap-4 text-[10px] font-bold uppercase text-slate-500">
                        <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-primary inline-block"></span>Revenue</span>
                        <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-amber-400 inline-block"></span>Discounts</span>
                    </div>
                </div>
                <div class="relative h-64">
                    <canvas id="salesChart"></canvas>
                </div>
            </section>

            <!-- Orders Table -->
            <section class="glass-morphism rounded-2xl overflow-hidden">
                <div class="p-6 border-b border-white/5 flex flex-wrap items-center justify-between gap-4">
                    <div>
                        <h3 class="text-base font-bold">Order Breakdown</h3>
                        <p class="text-[11px] text-slate-500 mt-0.5">Detailed list with coupon deductions</p>
                    </div>
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 text-[16px]">search</span>
                        <input type="text" id="tableSearch" placeholder="Search orders..."
                            oninput="filterTable()"
                            class="bg-white/5 border border-white/10 rounded-full pl-10 pr-5 py-2 text-xs text-white placeholder:text-slate-600 focus:outline-none focus:border-primary transition-all w-52" />
                    </div>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left" id="reportTable">
                        <thead>
                            <tr class="border-b border-white/5 text-[10px] text-slate-500 font-bold uppercase tracking-widest">
                                <th class="px-6 py-4">#</th>
                                <th class="px-6 py-4">Order ID</th>
                                <th class="px-6 py-4">Date</th>
                                <th class="px-6 py-4">Customer</th>
                                <th class="px-6 py-4">Status</th>
                                <th class="px-6 py-4">Order Amount</th>
                                <th class="px-6 py-4">Coupon</th>
                                <th class="px-6 py-4">Discount</th>
                                <th class="px-6 py-4 text-emerald-400">Net Amount</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-white/5 text-sm" id="reportTableBody">
                            <% if (typeof orders !== 'undefined' && orders.length > 0) { %>
                                <% orders.forEach((order, idx) => { %>
                                <tr class="hover:bg-white/3 transition-colors">
                                    <td class="px-6 py-4 text-slate-500 text-xs"><%= idx + 1 %></td>
                                    <td class="px-6 py-4">
                                        <span class="font-mono text-xs text-primary">#<%= order._id.toString().slice(-6).toUpperCase() %></span>
                                    </td>
                                    <td class="px-6 py-4 text-slate-400 text-xs">
                                        <%= new Date(order.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                                    </td>
                                    <td class="px-6 py-4 text-white font-medium">
                                        <%= order.userId ? order.userId.fullname || 'Guest' : 'Guest' %>
                                    </td>
                                    <td class="px-6 py-4">
                                        <% const s = order.status || 'Pending'; %>
                                        <span class="px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-widest
                                            <%= s === 'Delivered' ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' :
                                               s === 'Cancelled' ? 'bg-rose-500/10 text-rose-400 border border-rose-500/20' :
                                               s === 'Shipped' ? 'bg-blue-500/10 text-blue-400 border border-blue-500/20' :
                                               'bg-amber-500/10 text-amber-400 border border-amber-500/20' %>">
                                            <%= s %>
                                        </span>
                                    </td>
                                    <td class="px-6 py-4 font-bold">&#8377;<%= (order.totalAmount || 0).toLocaleString('en-IN') %></td>
                                    <td class="px-6 py-4 text-xs text-amber-400 font-bold">
                                        <%= order.couponCode || '—' %>
                                    </td>
                                    <td class="px-6 py-4 text-amber-400 font-bold">
                                        <% if (order.discount && order.discount > 0) { %>
                                            -&#8377;<%= order.discount.toLocaleString('en-IN') %>
                                        <% } else { %>
                                            <span class="text-slate-600">—</span>
                                        <% } %>
                                    </td>
                                    <td class="px-6 py-4 text-emerald-400 font-bold">
                                        &#8377;<%= (order.finalAmount || 0).toLocaleString('en-IN') %>
                                    </td>
                                </tr>
                                <% }) %>
                            <% } else { %>
                            <tr>
                                <td colspan="9" class="px-6 py-16 text-center">
                                    <div class="flex flex-col items-center gap-3 text-slate-600">
                                        <span class="material-symbols-outlined text-5xl">bar_chart</span>
                                        <p class="text-sm font-medium">No orders found for this period.</p>
                                        <p class="text-xs">Try changing the date filter above.</p>
                                    </div>
                                </td>
                            </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>

                <!-- Table Footer -->
                <div class="p-6 border-t border-white/5 flex flex-col md:flex-row items-center justify-between gap-4">
                    <p class="text-[10px] text-slate-500 font-medium uppercase tracking-widest">
                        Total: <span class="text-white font-bold"><%= typeof totalOrders !== 'undefined' ? totalOrders : 0 %> orders</span>
                    </p>
                    
                    <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
                    <div class="flex items-center gap-2">
                        <% if (currentPage > 1) { %>
                            <a href="?filter=<%= filter %>&start=<%= startDate || '' %>&end=<%= endDate || '' %>&page=<%= currentPage - 1 %>" class="w-8 h-8 flex items-center justify-center rounded-lg bg-white/5 text-white hover:bg-primary transition-colors text-xs">
                                &laquo;
                            </a>
                        <% } %>
                        
                        <% for(let i = 1; i <= totalPages; i++) { %>
                            <a href="?filter=<%= filter %>&start=<%= startDate || '' %>&end=<%= endDate || '' %>&page=<%= i %>" class="w-8 h-8 flex items-center justify-center rounded-lg text-xs transition-colors <%= currentPage === i ? 'bg-primary text-white font-bold' : 'bg-white/5 text-slate-400 hover:bg-white/10 hover:text-white' %>">
                                <%= i %>
                            </a>
                        <% } %>

                        <% if (currentPage < totalPages) { %>
                            <a href="?filter=<%= filter %>&start=<%= startDate || '' %>&end=<%= endDate || '' %>&page=<%= currentPage + 1 %>" class="w-8 h-8 flex items-center justify-center rounded-lg bg-white/5 text-white hover:bg-primary transition-colors text-xs">
                                &raquo;
                            </a>
                        <% } %>
                    </div>
                    <% } %>

                    <div class="flex items-center gap-3 text-[11px] font-bold">
                        <span class="text-slate-500">Net Revenue:</span>
                        <span class="text-emerald-400 text-base">
                            &#8377;<%= typeof netRevenue !== 'undefined' ? netRevenue.toLocaleString('en-IN') : '0' %>
                        </span>
                    </div>
                </div>
            </section>
        </div>
    </main>

    <script>
        // ─── Chart Data (injected by controller) ───────────────────────
        const chartLabels  = <%- typeof chartLabels  !== 'undefined' ? JSON.stringify(chartLabels)  : '["Mon","Tue","Wed","Thu","Fri","Sat","Sun"]' %>;
        const chartRevenue = <%- typeof chartRevenue !== 'undefined' ? JSON.stringify(chartRevenue) : '[0,0,0,0,0,0,0]' %>;
        const chartDiscount= <%- typeof chartDiscount!== 'undefined' ? JSON.stringify(chartDiscount): '[0,0,0,0,0,0,0]' %>;
        const allReportOrders = <%- typeof allReportOrders !== 'undefined' ? JSON.stringify(allReportOrders) : '[]' %>;
    </script>
    <script src="/js/admin/reports/reports.js"></script>
</body>
</html>
