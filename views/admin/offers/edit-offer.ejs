<!DOCTYPE html>
<html class="dark" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>TechKart Admin - Edit Offer</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: { "primary": "#0055ff", "background-dark": "#0d0d0d" },
                    fontFamily: { "display": ["Space Grotesk", "sans-serif"] },
                },
            },
        }
    </script>
    <link rel="stylesheet" href="/css/views/admin/offers/edit-offer.css">
</head>

<body class="flex min-h-screen bg-[#0D0D0D]">
    <%- include('../../partials/admin/sidebar') %>

    <main class="flex-1 flex flex-col relative overflow-y-auto custom-scrollbar">
        <%- include('../../partials/admin/header') %>

        <div class="p-10 max-w-4xl mx-auto w-full space-y-8">
            <nav class="flex items-center gap-2 text-[10px] font-bold uppercase tracking-widest text-slate-500">
                <a href="/admin/offers" class="hover:text-primary transition-colors">Offers</a>
                <span class="material-symbols-outlined text-xs">chevron_right</span>
                <span class="text-slate-300">Edit Offer</span>
            </nav>

            <div class="flex justify-between items-end">
                <div>
                    <h2 class="text-3xl font-bold tracking-tight">Edit Offer</h2>
                    <p class="text-xs text-slate-500 uppercase tracking-widest font-medium mt-1">Modify existing offer details</p>
                </div>
                <a href="/admin/offers" class="flex items-center gap-2 text-slate-400 hover:text-white transition-colors text-[10px] font-bold uppercase tracking-widest">
                    <span class="material-symbols-outlined text-sm">arrow_back</span>
                    Back to List
                </a>
            </div>

            <section class="glass-morphism rounded-3xl p-10 border border-white/5 relative overflow-hidden">
                <form id="editOfferForm" class="grid grid-cols-2 gap-6 relative z-10" novalidate>
                    <input type="hidden" id="offerId" value="<%= offer._id %>" />

                    <div class="col-span-2">
                        <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-3 block">Offer Name</label>
                        <input type="text" id="name" value="<%= offer.name %>" class="input-field font-bold" oninput="clearError('name')" />
                        <p id="nameError" class="field-error">Offer name is required.</p>
                    </div>

                    <div class="col-span-2">
                        <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-3 block">Description</label>
                        <textarea id="description" rows="2" class="input-field"><%= offer.description || '' %></textarea>
                    </div>

                    <div>
                        <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-3 block">Offer Type</label>
                        <!-- Offer type is locked on edit to prevent data inconsistencies -->
                        <input type="text" id="offerTypeDisplay" value="<%= offer.offerType === 'product' ? 'Product Offer' : 'Category Offer' %>" class="input-field" disabled />
                        <input type="hidden" id="offerType" value="<%= offer.offerType %>" />
                    </div>

                    <div id="applicableToContainer">
                        <label id="applicableToLabel" class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-3 block">Applicable To</label>
                        <select id="applicableTo" class="input-field appearance-none" onchange="clearError('applicableTo')">
                            <option value="">Select Option</option>
                            <% if (typeof products !== 'undefined' && products.length > 0) { %>
                                <optgroup label="Products" class="<%= offer.offerType === 'product' ? '' : 'hidden' %>" id="optgroup-product">
                                    <% products.forEach(p => { %>
                                        <option value="<%= p._id %>" <%= offer.applicableTo && offer.applicableTo.toString() === p._id.toString() ? 'selected' : '' %>><%= p.name %></option>
                                    <% }) %>
                                </optgroup>
                            <% } %>
                            <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
                                <optgroup label="Categories" class="<%= offer.offerType === 'category' ? '' : 'hidden' %>" id="optgroup-category">
                                    <% categories.forEach(c => { %>
                                        <option value="<%= c._id %>" <%= offer.applicableTo && offer.applicableTo.toString() === c._id.toString() ? 'selected' : '' %>><%= c.name %></option>
                                    <% }) %>
                                </optgroup>
                            <% } %>
                        </select>
                        <p id="applicableToError" class="field-error">Please select an applicable item.</p>
                    </div>

                    <div>
                        <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-3 block">Discount Type</label>
                        <select id="discountType" onchange="updateValueLabel()" class="input-field appearance-none">
                            <option value="percentage" <%= offer.discountType === 'percentage' ? 'selected' : '' %>>Percentage (%)</option>
                            <option value="flat" <%= offer.discountType === 'flat' ? 'selected' : '' %>>Fixed Amount (&#8377;)</option>
                        </select>
                    </div>

                    <div>
                        <label id="valueLabel" class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-3 block">Discount Value (%)</label>
                        <input type="number" id="discountValue" min="1" value="<%= offer.discountValue %>" class="input-field" oninput="clearError('discountValue')" />
                        <p id="discountValueError" class="field-error">Please enter a valid discount value.</p>
                    </div>

                    <div id="maxDiscountContainer">
                        <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-3 block">
                            Max Discount Cap (&#8377;) <span class="normal-case text-slate-600 font-normal">optional</span>
                        </label>
                        <input type="number" id="maxDiscountAmount" min="0" value="<%= offer.maxDiscountAmount || '' %>" class="input-field" />
                    </div>

                    <div>
                        <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-3 block">Start Date</label>
                        <input type="date" id="startDate" value="<%= new Date(offer.startDate).toISOString().split('T')[0] %>" class="input-field" onchange="clearError('startDate')" />
                        <p id="startDateError" class="field-error">Start date is required.</p>
                    </div>

                    <div>
                        <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-3 block">End Date</label>
                        <input type="date" id="endDate" value="<%= new Date(offer.endDate).toISOString().split('T')[0] %>" class="input-field" onchange="clearError('endDate')" />
                        <p id="endDateError" class="field-error">End date is required.</p>
                    </div>

                    <div class="col-span-2 pt-2 flex gap-4">
                        <button type="button" onclick="updateOffer()"
                            class="flex-1 bg-primary hover:bg-primary/90 text-white py-4 rounded-2xl font-bold text-xs uppercase tracking-widest transition-all shadow-[0_8px_25px_rgba(0,85,255,0.3)]">
                            Update Offer
                        </button>
                        <button type="button" onclick="window.location.href='/admin/offers'"
                            class="px-8 py-4 rounded-2xl border border-white/10 text-slate-400 hover:text-white hover:bg-white/5 transition-all text-xs font-bold uppercase tracking-widest">
                            Cancel
                        </button>
                    </div>

                </form>
                <div class="absolute top-0 right-0 w-64 h-64 bg-primary/10 blur-[100px] pointer-events-none -z-10 rounded-full"></div>
            </section>
        </div>
    </main>

    <script src="/js/validation.js"></script>
    <script src="/js/admin/offers/edit-offer.js"></script>
</body>
</html>
