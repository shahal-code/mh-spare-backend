<!DOCTYPE html>
<html class="dark" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>TechKart Admin - Category Management</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap"
        rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
        rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#0055ff",
                        "background-light": "#f5f6f8",
                        "background-dark": "#0d0d0d",
                        "card-bg": "rgba(23, 33, 54, 0.4)",
                    },
                    fontFamily: {
                        "display": ["Space Grotesk", "sans-serif"]
                    },
                    borderRadius: {
                        "DEFAULT": "0.5rem",
                        "lg": "1rem",
                        "xl": "1.5rem",
                        "full": "9999px"
                    },
                },
            },
        }
    </script>
    <link rel="stylesheet" href="/css/views/admin/category/category.css">
</head>

<body class="flex min-h-screen bg-[#0D0D0D]">
    <%- include('../../partials/admin/sidebar') %>

        <main class="flex-1 flex flex-col relative overflow-y-auto custom-scrollbar">
            <%- include('../../partials/admin/header') %>

                <div class="p-10 space-y-8">
                    <!-- Header Area -->
                    <div class="flex justify-between items-center">
                        <div>
                            <h2 class="text-2xl font-bold tracking-tight">Categories</h2>
                            <p class="text-xs text-slate-500 uppercase tracking-widest font-medium mt-0.5">Organize and
                                manage your catalog</p>
                        </div>
                        <div class="flex items-center gap-6">
                            <form action="/admin/category" method="GET" class="flex items-center gap-3">
                                <div class="relative group">
                                    <span
                                        class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 group-focus-within:text-primary transition-colors text-xl">search</span>
                                    <input name="search" type="text" placeholder="Search categories..."
                                        value="<%= typeof search !== 'undefined' ? search : '' %>"
                                        class="!bg-white/5 border border-white/10 rounded-xl py-2.5 pl-12 pr-10 text-sm w-64 focus:outline-none focus:border-primary text-white placeholder:text-slate-500" />
                                </div>
                                <button type="submit"
                                    class="bg-primary hover:bg-primary/90 text-white px-6 py-2.5 rounded-xl font-bold text-xs uppercase tracking-wider transition-all shadow-lg">
                                    Filter
                                </button>
                                <% if (typeof search !=='undefined' && search) { %>
                                    <button type="button" onclick="window.location.href='/admin/category'"
                                        class="bg-white/5 hover:bg-white/10 text-slate-400 px-6 py-2.5 rounded-xl font-bold text-xs uppercase tracking-wider transition-all border border-white/10">
                                        Reset
                                    </button>
                                    <% } %>
                            </form>
                            <div class="h-8 w-[1px] bg-white/10"></div>
                            <button onclick="window.location.href='/admin/addCategory'"
                                class="flex items-center gap-2 bg-primary hover:bg-primary/90 text-white px-6 py-2.5 rounded-xl font-bold text-xs uppercase tracking-wider transition-all shadow-[0_4px_15px_rgba(0,85,255,0.3)]">
                                <span class="material-symbols-outlined text-sm">add</span>
                                Add Category
                            </button>
                        </div>
                    </div>

                    <!-- Stats -->
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                        <!-- Total Categories -->
                        <div class="stat-card border-l-4 border-l-primary">
                            <div class="flex justify-between items-start mb-4">
                                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Total Categories</p>
                                <span class="material-symbols-outlined text-primary bg-primary/10 p-2 rounded-lg text-xl">category</span>
                            </div>
                            <h3 class="text-3xl font-bold tracking-tight mb-1">
                                <%= typeof stats !== 'undefined' ? stats.total : 0 %>
                            </h3>
                        </div>
                        <!-- Active Categories -->
                        <div class="stat-card border-l-4 border-l-emerald-500">
                            <div class="flex justify-between items-start mb-4">
                                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Active Categories</p>
                                <span class="material-symbols-outlined text-emerald-500 bg-emerald-500/10 p-2 rounded-lg text-xl">check_circle</span>
                            </div>
                            <h3 class="text-3xl font-bold tracking-tight text-emerald-400">
                                <%= typeof activeCategories !== 'undefined' ? activeCategories : 0 %>
                            </h3>
                        </div>
                        <!-- Blocked Categories -->
                        <div class="stat-card border-l-4 border-l-rose-500">
                            <div class="flex justify-between items-start mb-4">
                                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Blocked Categories</p>
                                <span class="material-symbols-outlined text-rose-500 bg-rose-500/10 p-2 rounded-lg text-xl">block</span>
                            </div>
                            <h3 class="text-3xl font-bold tracking-tight text-rose-400">
                                <%= typeof blockedCategories !== 'undefined' ? blockedCategories : 0 %>
                            </h3>
                        </div>
                        <!-- Newest Category -->
                        <div class="stat-card border-l-4 border-l-amber-500">
                            <div class="flex justify-between items-start mb-4">
                                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Newest Category</p>
                                <span class="material-symbols-outlined text-amber-500 bg-amber-500/10 p-2 rounded-lg text-xl">new_releases</span>
                            </div>
                            <h3 class="text-xl font-bold tracking-tight mb-1 truncate">
                                <%= typeof stats !== 'undefined' ? stats.newestName : 'N/A' %>
                            </h3>
                            <div class="flex items-center gap-2">
                                <span class="text-slate-500 text-[10px] uppercase tracking-tighter">
                                    <% if(typeof stats !== 'undefined' && stats.newestDate) { %>
                                        <% const daysAgo = Math.floor((new Date() - new Date(stats.newestDate)) / (1000 * 60 * 60 * 24)); %>
                                        Added <%= daysAgo === 0 ? "today" : daysAgo + " days ago" %>
                                    <% } else { %>
                                        No data
                                    <% } %>
                                </span>
                            </div>
                        </div>
                    </div>


                    <!-- Table Section -->
                    <section class="glass-morphism rounded-xl overflow-hidden border border-white/5">
                        <div class="overflow-x-auto">
                            <table class="w-full text-left">
                                <thead>
                                    <tr class="bg-white/5 border-b border-white/5">
                                        <th
                                            class="px-8 py-5 text-[10px] font-bold uppercase tracking-widest text-slate-400">
                                            Category Name</th>
                                        <th
                                            class="px-8 py-5 text-[10px] font-bold uppercase tracking-widest text-slate-400 text-center">
                                            Number of Products</th>
                                        <th
                                            class="px-8 py-5 text-[10px] font-bold uppercase tracking-widest text-slate-400">
                                            Status</th>
                                        <th
                                            class="px-8 py-5 text-[10px] font-bold uppercase tracking-widest text-slate-400 text-right">
                                            Actions</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-white/5">
                                    <% if (typeof categories !=='undefined' && categories && categories.length> 0) { %>
                                        <% categories.forEach(category=> { %>
                                            <tr class="hover:bg-white/[0.02] transition-colors">
                                                <td class="px-8 py-5">
                                                    <div class="flex items-center gap-3">
                                                        <div
                                                            class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center">
                                                            <span
                                                                class="material-symbols-outlined text-primary text-xl">
                                                                <%= category.icon || 'category' %>
                                                            </span>
                                                        </div>
                                                        <div>
                                                            <p class="font-bold text-sm">
                                                                <%= category.name %>
                                                            </p>
                                                            <p
                                                                class="text-[10px] text-slate-500 uppercase tracking-wider">
                                                                <%= category.description %>
                                                            </p>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="px-8 py-5 text-center">
                                                    <span class="font-display font-medium text-lg">
                                                        <%= category.productCount || 0 %>
                                                    </span>
                                                </td>
                                                <td class="px-8 py-5">
                                                    <span
                                                        class="px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-widest <%= !category.is_blocked ? 'glowing-badge-active' : 'glowing-badge-inactive' %>">
                                                        <%= !category.is_blocked ? 'Active' : 'Blocked' %>
                                                    </span>
                                                </td>
                                                <td class="px-8 py-5 text-right">
                                                    <div class="flex items-center justify-end gap-3">
                                                        <button
                                                            onclick="window.location.href='/admin/editCategory/<%= category._id %>'"
                                                            class="p-2 text-slate-400 hover:text-primary hover:bg-primary/10 rounded-lg transition-all">
                                                            <span class="material-symbols-outlined text-lg">edit</span>
                                                        </button>
                                                        <button
                                                            onclick="toggleList('<%= category._id %>', '<%= category.is_blocked %>')"
                                                            class="p-2 text-slate-400 hover:text-rose-500 hover:bg-rose-500/10 rounded-lg transition-all">
                                                            <span class="material-symbols-outlined text-lg">
                                                                <%= !category.is_blocked ? 'block' : 'check_circle' %>
                                                            </span>
                                                        </button>
                                                        <button onclick="deleteCategory('<%= category._id %>')"
                                                            class="p-2 text-rose-500 hover:text-rose-400 hover:bg-rose-500/10 rounded-lg transition-all">
                                                            <span
                                                                class="material-symbols-outlined text-lg">delete</span>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                            <% }) %>
                                                <% } else { %>
                                                    <tr>
                                                        <td colspan="4"
                                                            class="px-8 py-10 text-center text-slate-500 italic">No
                                                            categories found matching your search.</td>
                                                    </tr>
                                                    <% } %>
                                </tbody>
                            </table>
                        </div>

                        <!-- Pagination -->
                        <div class="px-8 py-6 border-t border-white/5 flex items-center justify-between">
                            <p class="text-xs text-slate-500 font-medium uppercase tracking-widest">
                                Showing <%= (page - 1) * limit + 1 %> to <%= Math.min(page * limit, totalCategories) %> of <%= totalCategories %> categories
                            </p>
                            <% if (totalPages > 1) { %>
                                <div class="flex items-center gap-2">
                                    <a href="?page=<%= page - 1 %>&search=<%= search %>"
                                        class="px-6 py-2.5 rounded-lg border border-white/10 text-slate-400 hover:bg-white/5 transition-all text-[10px] font-bold uppercase tracking-widest <%= page === 1 ? 'pointer-events-none opacity-30' : '' %>">
                                        Previous
                                    </a>

                                    <% for(let i = 1; i <= totalPages; i++) { %>
                                        <a href="?page=<%= i %>&search=<%= search %>"
                                            class="h-10 w-10 flex items-center justify-center rounded-lg text-[10px] font-bold transition-all <%= page === i ? 'bg-primary text-white shadow-[0_0_20px_rgba(0,85,255,0.3)]' : 'border border-white/10 text-slate-400 hover:bg-white/5' %>">
                                            <%= i %>
                                        </a>
                                    <% } %>

                                    <a href="?page=<%= page + 1 %>&search=<%= search %>"
                                        class="px-6 py-2.5 rounded-lg border border-white/10 text-slate-400 hover:bg-white/5 transition-all text-[10px] font-bold uppercase tracking-widest <%= page === totalPages ? 'pointer-events-none opacity-30' : '' %>">
                                        Next
                                    </a>
                                </div>
                            <% } %>
                        </div>
                    </section>
                </div>
        </main>

        <!-- Modal (Styling synced with new theme) -->
        <div id="addCategoryModal"
            class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-md hidden opacity-0 transition-opacity duration-300">
            <div
                class="bg-[#0d0d0d] border border-white/10 w-full max-w-lg rounded-2xl shadow-2xl overflow-hidden transform scale-95 transition-transform duration-300">
                <div class="p-6 border-b border-white/5 flex justify-between items-center bg-white/[0.02]">
                    <h3 class="text-xl font-bold" id="modalTitle">Add New Category</h3>
                    <button onclick="closeModal()" class="text-slate-400 hover:text-white transition-colors">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                </div>
                <div class="p-8">
                    <form id="categoryForm" class="space-y-6">
                        <input type="hidden" id="categoryId" name="id" />
                        <div>
                            <label
                                class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-2 block">Category
                                Name</label>
                            <input type="text" id="categoryName" name="name" required class="input-field w-full"
                                placeholder="e.g. Gaming Laptops" />
                        </div>
                        <div>
                            <label
                                class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-2 block">Description</label>
                            <textarea id="categoryDescription" name="description" required
                                class="input-field w-full resize-none h-16"
                                placeholder="Brief description..."></textarea>
                        </div>
                        <div class="pt-4 flex justify-end gap-3">
                            <button type="button" onclick="closeModal()"
                                class="px-6 py-2.5 rounded-xl text-slate-400 hover:text-white hover:bg-white/5 transition-all text-xs font-bold uppercase tracking-widest">Cancel</button>
                            <button type="submit"
                                class="px-8 py-2.5 rounded-xl bg-primary text-white font-bold text-xs uppercase tracking-widest shadow-[0_4px_15px_rgba(0,85,255,0.3)] transition-all">Save
                                Category</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Background Orbs -->
        <div
            class="fixed top-[-10%] left-[-10%] w-[40%] h-[40%] bg-primary/5 blur-[120px] pointer-events-none -z-10 rounded-full">
        </div>
        <div
            class="fixed bottom-[-10%] right-[-10%] w-[40%] h-[40%] bg-primary/5 blur-[120px] pointer-events-none -z-10 rounded-full">
        </div>

        <script src="/js/admin/category/category.js"></script>
</body>

</html>