<!DOCTYPE html>

<html class="dark" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&amp;display=swap"
        rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#0055ff",
                        "background-light": "#f5f6f8",
                        "background-dark": "#000000",
                    },
                    fontFamily: {
                        "display": ["Space Grotesk", "sans-serif"]
                    },
                    borderRadius: {
                        "DEFAULT": "0.5rem",
                        "lg": "1rem",
                        "xl": "1.5rem",
                        "full": "9999px"
                    },
                },
            },
        }
    </script>
    <link rel="stylesheet" href="/css/views/error/404.css">
</head>

<body
    class="bg-background-light dark:bg-background-dark font-display text-slate-900 dark:text-slate-100 selection:bg-primary selection:text-white">
    <div class="relative flex min-h-screen flex-col overflow-x-hidden">
        <!-- Abstract background glow -->
        <div
            class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] bg-primary/20 blur-[120px] rounded-full pointer-events-none">
        </div>
        <div
            class="absolute bottom-[-10%] right-[-10%] w-[30%] h-[30%] bg-primary/10 blur-[100px] rounded-full pointer-events-none">
        </div>
        <!-- Header -->
        <header class="sticky top-0 z-50 px-6 py-4 border-b border-slate-200/10 glass-panel">
            <div class="max-w-7xl mx-auto flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="text-primary flex items-center">
                        <span class="material-symbols-outlined text-3xl font-bold">rocket_launch</span>
                    </div>
                    <h2 class="text-xl font-bold tracking-tight text-slate-900 dark:text-slate-100">TechKart</h2>
                </div>
                <nav class="hidden md:flex items-center gap-10">
                    <a class="text-sm font-medium hover:text-primary transition-colors uppercase tracking-wider"
                        href="/user">HOME</a>
                    <a class="text-sm font-medium hover:text-primary transition-colors uppercase tracking-wider"
                        href="/user/shop">SHOP</a>
                    <a class="text-sm font-medium hover:text-primary transition-colors uppercase tracking-wider"
                        href="/user/contact">CONTACT US</a>
                    <a class="text-sm font-medium hover:text-primary transition-colors uppercase tracking-wider"
                        href="/user/about">ABOUT US</a>
                </nav>
                <div>
                    <button
                        class="bg-primary hover:bg-primary/90 text-white px-6 py-2 rounded-lg text-sm font-bold transition-all glow-effect flex items-center gap-2">
                        <span class="material-symbols-outlined text-sm">person</span>
                        ACCOUNT
                    </button>
                </div>
            </div>
        </header>
        <!-- Main Hero Content -->
        <main class="flex-grow flex items-center justify-center px-6 py-20">
            <div class="max-w-3xl w-full text-center">
                <div class="mb-8 relative inline-block">
                    <h1
                        class="text-[12rem] md:text-[18rem] font-black leading-none tracking-tighter text-transparent bg-clip-text bg-gradient-to-b from-primary to-primary/20 opacity-80 select-none">
                        404
                    </h1>
                    <div class="absolute inset-0 flex items-center justify-center">
                        <span class="material-symbols-outlined text-8xl md:text-9xl text-white/10">priority_high</span>
                    </div>
                </div>
                <div class="glass-panel p-8 md:p-12 rounded-xl shadow-2xl relative overflow-hidden">
                    <div
                        class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-primary to-transparent">
                    </div>
                    <h2 class="text-3xl md:text-5xl font-bold mb-4 text-glow">Lost in Cyberspace?</h2>
                    <p
                        class="text-slate-500 dark:text-slate-400 text-lg md:text-xl mb-10 max-w-xl mx-auto leading-relaxed">
                        <%= typeof message !== 'undefined' && message ? message : "The page you are looking for has been upgraded or moved to a different dimension." %>
                    </p>
                    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
                        <a class="group relative flex items-center justify-center bg-primary text-white px-10 py-4 rounded-lg font-bold transition-all hover:scale-105 active:scale-95 glow-effect"
                            href="/user">
                            <span class="material-symbols-outlined mr-2">home</span>
                            Back to Home
                        </a>
                        <a class="flex items-center justify-center border border-slate-700 hover:border-primary/50 text-slate-300 px-10 py-4 rounded-lg font-bold transition-all glass-panel"
                            href="/user/shop">
                            <span class="material-symbols-outlined mr-2">search</span>
                            Explore Catalog
                        </a>
                    </div>
                </div>
            </div>
        </main>
        <!-- Footer -->
        <footer class="mt-auto border-t border-slate-200/10 glass-panel py-16 px-6">
            <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-12">
                <div class="space-y-4">
                    <div class="flex items-center gap-2 mb-6">
                        <span class="material-symbols-outlined text-primary font-bold">rocket_launch</span>
                        <span class="text-xl font-bold">TechKart</span>
                    </div>
                    <p class="text-slate-500 text-sm leading-relaxed">
                        Redefining performance hardware and cutting-edge tech solutions for the digital age.
                    </p>
                </div>
                <div>
                    <h3 class="font-bold text-slate-100 mb-6 uppercase tracking-widest text-sm">Company</h3>
                    <ul class="space-y-4 text-slate-400">
                        <li><a class="hover:text-primary transition-colors" href="#">Our Story</a></li>
                        <li><a class="hover:text-primary transition-colors" href="#">Careers</a></li>
                        <li><a class="hover:text-primary transition-colors" href="#">Partners</a></li>
                    </ul>
                </div>
                <div>
                    <h3 class="font-bold text-slate-100 mb-6 uppercase tracking-widest text-sm">Support</h3>
                    <ul class="space-y-4 text-slate-400">
                        <li><a class="hover:text-primary transition-colors" href="#">Help Center</a></li>
                        <li><a class="hover:text-primary transition-colors" href="#">Shipping</a></li>
                        <li><a class="hover:text-primary transition-colors" href="#">Privacy Policy</a></li>
                    </ul>
                </div>
                <div>
                    <h3 class="font-bold text-slate-100 mb-6 uppercase tracking-widest text-sm">Social Media</h3>
                    <div class="flex gap-4">
                        <a class="w-10 h-10 rounded-lg flex items-center justify-center glass-panel hover:text-primary transition-all"
                            href="#">
                            <span class="material-symbols-outlined text-xl">share</span>
                        </a>
                        <a class="w-10 h-10 rounded-lg flex items-center justify-center glass-panel hover:text-primary transition-all"
                            href="#">
                            <span class="material-symbols-outlined text-xl">public</span>
                        </a>
                        <a class="w-10 h-10 rounded-lg flex items-center justify-center glass-panel hover:text-primary transition-all"
                            href="#">
                            <span class="material-symbols-outlined text-xl">brand_awareness</span>
                        </a>
                    </div>
                    <div class="mt-8 text-xs text-slate-500">
                        © 2024 TechKart. High-Performance Tech.
                    </div>
                </div>
            </div>
        </footer>
    </div>
</body>

</html>