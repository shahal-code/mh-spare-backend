<!-- ═══ MH SPARE HUB Design System ═══ -->
<link rel="stylesheet" href="/css/mh-design.css">
<script>(function(){try{const t=localStorage.getItem('theme');if(t==='light')document.documentElement.classList.remove('dark');else document.documentElement.classList.add('dark');}catch(e){}})()</script>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
    rel="stylesheet" />
    
<!-- Mobile Toggle Button -->
<button onclick="toggleUserSidebar()" class="lg:hidden fixed bottom-6 right-6 z-[60] size-14 bg-primary text-white rounded-full shadow-2xl flex items-center justify-center hover:scale-105 transition-transform">
    <span class="material-symbols-outlined">menu</span>
</button>

<!-- Mobile Overlay -->
<div id="userSidebarOverlay" onclick="toggleUserSidebar()" class="fixed inset-0 bg-black/80 z-[60] hidden lg:hidden backdrop-blur-sm transition-opacity"></div>

<aside id="userSidebar" class="mh-user-sidebar fixed lg:static inset-y-0 left-0 z-[70] w-[280px] flex flex-col bg-[#161b22] lg:bg-transparent p-4 transition-transform duration-300 -translate-x-full lg:translate-x-0 border-r border-white/5" style="height: 100vh; overflow-y: auto;">
    <div style="display:flex; justify-content:center; padding: 10px 0 20px;">
        <a href="/user/dashboard">
            <img src="https://raw.githubusercontent.com/muhammedhaseeb9645/MH-SPARE-HUB/refs/heads/main/logo/Logo%20big%20.png" alt="MH SPARE HUB" style="height: 35px; filter: drop-shadow(0 0 1px rgba(0,210,255,0.3));">
        </a>
    </div>
    <nav class="flex-1 space-y-2">
        <a class="flex items-center gap-3 px-4 py-3 rounded-xl hover:text-white hover:bg-white/5 transition-all <%= path === '/user/dashboard' ? 'bg-primary text-white font-medium' : 'text-white/60' %>"
            href="/user/dashboard">
            <span class="material-symbols-outlined">dashboard</span>
            <span>Dashboard</span>
        </a>
        <a class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all <%= path === '/user/profile' ? 'bg-primary text-white font-medium' : 'text-white/60 hover:text-white hover:bg-white/5' %>"
            href="/user/profile">
            <span class="material-symbols-outlined">person</span>
            <span>Profile</span>
        </a>
        <a class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all <%= path === '/user/orders' ? 'bg-primary text-white font-medium' : 'text-white/60 hover:text-white hover:bg-white/5' %>"
            href="/user/orders">
            <span class="material-symbols-outlined">package_2</span>
            <span>Orders</span>
        </a>
        <a class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all <%= path === '/user/wallet' ? 'bg-primary text-white font-medium' : 'text-white/60 hover:text-white hover:bg-white/5' %>"
            href="/user/wallet">
            <span class="material-symbols-outlined">account_balance_wallet</span>
            <span>Wallet</span>
        </a>
        <a class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all <%= path === '/user/address' ? 'bg-primary text-white font-medium' : 'text-white/60 hover:text-white hover:bg-white/5' %>"
            href="/user/address">
            <span class="material-symbols-outlined">location_on</span>
            <span>Addresses</span>
        </a>

        <!-- Security Dropdown -->
        <div class="space-y-1">
            <button onclick="toggleSecurityMenu()"
                class="w-full flex items-center justify-between px-4 py-3 rounded-xl text-white/60 hover:text-white hover:bg-white/5 transition-all group">
                <div class="flex items-center gap-3">
                    <span
                        class="material-symbols-outlined <%= (loginMethod === 'google') ? 'text-amber-500/50' : '' %>">
                        <%= (loginMethod==='google' ) ? 'lock' : 'security' %>
                    </span>
                    <span>Security</span>
                </div>
                <span id="securityChevron"
                    class="material-symbols-outlined text-sm transition-transform duration-300">expand_more</span>
            </button>
            <div id="securitySubmenu" class="hidden pl-11 space-y-1 overflow-hidden transition-all duration-300">
                <% if (loginMethod==='google' ) { %>
                    <!-- Blocked options for Google Users -->
                    <div
                        class="flex items-center gap-3 px-4 py-2 rounded-xl text-white/20 cursor-not-allowed select-none text-sm group/disabled relative hover:bg-white/[0.02]">
                        <span class="material-symbols-outlined text-[18px] text-amber-500/50">key</span>
                        <span class="flex-1 text-white/30">Change Password (Google)</span>
                        <span class="material-symbols-outlined text-sm text-white/20">lock</span>

                        <!-- Tooltip -->
                        <div
                            class="absolute left-full ml-4 px-3 py-2 bg-[#1A1D23] border border-white/10 rounded-xl text-[10px] whitespace-nowrap opacity-0 group-hover/disabled:opacity-100 transition-all duration-300 pointer-events-none z-50 shadow-2xl translate-x-[-10px] group-hover/disabled:translate-x-0">
                            <div class="flex items-center gap-2">
                                <img src="https://www.google.com/favicon.ico" class="size-3 grayscale opacity-50">
                                <span class="font-medium text-white/60">Managed by Google Security</span>
                            </div>
                        </div>
                    </div>
                    <div
                        class="flex items-center gap-3 px-4 py-2 rounded-xl text-white/20 cursor-not-allowed select-none text-sm group/disabled relative hover:bg-white/[0.02]">
                        <span class="material-symbols-outlined text-[18px] text-indigo-400/50">mail</span>
                        <span class="flex-1 text-white/30">Change Email (Google)</span>
                        <span class="material-symbols-outlined text-sm text-white/20">lock</span>

                        <!-- Tooltip -->
                        <div
                            class="absolute left-full ml-4 px-3 py-2 bg-[#1A1D23] border border-white/10 rounded-xl text-[10px] whitespace-nowrap opacity-0 group-hover/disabled:opacity-100 transition-all duration-300 pointer-events-none z-50 shadow-2xl translate-x-[-10px] group-hover/disabled:translate-x-0">
                            <div class="flex items-center gap-2">
                                <img src="https://www.google.com/favicon.ico" class="size-3 grayscale opacity-50">
                                <span class="font-medium text-white/60">Managed by Google Security</span>
                            </div>
                        </div>
                    </div>
                    <% } else { %>
                        <!-- Active options for Regular Users -->
                        <a href="/user/profile/change-password"
                            class="flex items-center gap-3 px-4 py-2 rounded-xl text-white/40 hover:text-white transition-all text-sm">
                            <span class="material-symbols-outlined text-sm">lock_reset</span>
                            <span>Change Password</span>
                        </a>
                        <a href="/user/profile/change-email"
                            class="flex items-center gap-3 px-4 py-2 rounded-xl text-white/40 hover:text-white transition-all text-sm">
                            <span class="material-symbols-outlined text-sm">mail</span>
                            <span>Change Email</span>
                        </a>
                        <% } %>
            </div>
        </div>
        <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-rose-500 hover:text-rose-400 hover:bg-rose-500/10 transition-all mt-4 border border-rose-500/10"
            href="/user/logout">
            <span class="material-symbols-outlined">logout</span>
            <span>Logout</span>
        </a>
    </nav>
    <div class="mt-auto p-4 rounded-2xl glass-card flex items-center gap-3 border border-white/5">
        <div
            class="size-10 rounded-full bg-cover bg-center flex items-center justify-center bg-primary/20 text-primary font-bold overflow-hidden">
            <% if (user.profileImage && user.profileImage.startsWith('http')) { %>
                <img src="<%= user.profileImage %>" referrerpolicy="no-referrer" class="w-full h-full object-cover">
                <% } else { %>
                    <%= user.fullname.substring(0, 2).toUpperCase() %>
                        <% } %>
        </div>
        <div>
            <p class="text-sm font-bold">
                <%= user.fullname %>
            </p>
            <p class="text-xs text-primary font-medium">Member</p>
        </div>
    </div>
</aside>

<script>
    function toggleUserSidebar() {
        const sidebar = document.getElementById('userSidebar');
        const overlay = document.getElementById('userSidebarOverlay');
        
        if (sidebar.classList.contains('-translate-x-full')) {
            sidebar.classList.remove('-translate-x-full');
            overlay.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
        } else {
            sidebar.classList.add('-translate-x-full');
            overlay.classList.add('hidden');
            document.body.style.overflow = '';
        }
    }
</script>
<script src="/js/partials/sidebar.js"></script>