<!DOCTYPE html>

<html class="dark" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>TechKart Shopping Cart</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link
        href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&amp;family=Noto+Sans:wght@400;500;600&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#0055ff",
                        "background-light": "#f5f6f8",
                        "background-dark": "#0d0d0d",
                        "surface-dark": "#161b22",
                    },
                    fontFamily: {
                        "display": ["Space Grotesk", "sans-serif"],
                        "sans": ["Noto Sans", "sans-serif"]
                    },
                    borderRadius: { "DEFAULT": "0.5rem", "lg": "1rem", "xl": "1.5rem", "full": "9999px" },
                },
            },
        }
    </script>
    <link rel="stylesheet" href="/css/views/user/cart/cart.css">
</head>

<body class="bg-background-light dark:bg-background-dark font-display text-white min-h-screen flex flex-col">
    <%- include('../../partials/user/header') %>
        <main class="flex-1 max-w-[1440px] mx-auto w-full px-6 lg:px-20 py-12">
            <div class="mb-10">
                <h2 class="text-4xl md:text-5xl font-black tracking-tight">Shopping Cart  </h2>
                <p class="text-white/50 mt-2">You have <%= cart ? cart.items.length : 0 %> items in your cart</p>
            </div>
            <div class="flex flex-col lg:flex-row gap-12">
                <!-- Left Side: Items List -->
                <div class="flex-1 space-y-4">
                    <% if (cart && cart.items && cart.items.length> 0) { %>
                        <% cart.items.forEach(item=> {
                            const product = item.productId;
                            if(product) {
                            const variant = product.variants.find(v => v._id.toString() === item.variantId.toString());
                            if(variant) {
                            %>
                            <!-- Product Item -->
                            <div id="cart-item-<%= item._id %>"
                                class="glass p-6 rounded-xl flex flex-col sm:flex-row items-center gap-6 group hover:border-primary/50 transition-all duration-300 <%= item.isUnavailable ? 'opacity-50 grayscale' : '' %>">
                                <div class="bg-surface-dark rounded-lg size-32 flex-shrink-0 bg-cover bg-center border border-white/5"
                                    style='background-image: url("<%= variant.images[0] %>");'>
                                </div>
                                <div class="flex flex-col flex-1 text-center sm:text-left">
                                    <h3 class="text-xl font-bold">
                                        <%= product.name %>
                                    </h3>
                                    <p class="text-white/50 text-sm mt-1">
                                        <% const specs=[]; if(variant.ram) specs.push(variant.ram); if(variant.storage)
                                            specs.push(variant.storage); if(variant.color) specs.push(variant.color); %>
                                            <%= specs.join(', ') %>
                                    </p>
                                    <div class="mt-4 flex items-center justify-center sm:justify-start gap-4">
                                        <% if (item.isUnavailable) { %>
                                            <span class="text-sm font-bold text-red-500 bg-red-500/10 px-3 py-1 rounded-full">Product Unavailable</span>
                                            <span id="price-<%= item._id %>" class="hidden">0</span>
                                        <% } else { %>
                                            <span class="text-lg font-semibold text-primary">₹<%= variant.price %></span>
                                            <!-- Hidden span to store unit price for JS -->
                                            <span id="price-<%= item._id %>" class="hidden"><%= variant.price %></span>
                                        <% } %>
                                    </div>
                                </div>
                                <div class="flex items-center gap-6">
                                    <div class="flex items-center gap-3 bg-white/5 p-1 rounded-full border border-white/10">
                                        <button onclick="handleQuantityChange(this)" data-id="<%= item._id %>" data-delta="-1"
                                            id="minus-<%= item._id %>"
                                            class="size-8 flex items-center justify-center rounded-full hover:bg-white/10 transition-colors text-white/70"
                                            <% if(item.quantity <= 1 || item.isUnavailable) { %> disabled <% } %>>-</button>
                                        <input id="qty-input-<%= item._id %>" class="w-8 text-center bg-transparent border-none p-0 focus:ring-0 font-medium"
                                            type="number" value="<%= item.quantity %>" readonly />
                                        <button onclick="handleQuantityChange(this)" data-id="<%= item._id %>" data-delta="1"
                                            id="plus-<%= item._id %>"
                                            class="size-8 flex items-center justify-center rounded-full hover:bg-white/10 transition-colors text-white/70"
                                            <% if(item.isUnavailable) { %> disabled <% } %>>+</button>
                                    </div>
                                    <button onclick="removeCartItem('<%=item._id %>')" class="p-2 text-white/30
                                                hover:text-red-500 transition-colors">
                                                <span class="material-symbols-outlined">delete</span>
                                                </button>
                                </div>
                            </div>
                            <% } } }) %>
                                <% } else { %>
                                    <div id="empty-cart-msg" class="glass p-12 rounded-xl text-center">
                                        <span
                                            class="material-symbols-outlined text-6xl text-white/20 mb-4 block">remove_shopping_cart</span>
                                        <h3 class="text-2xl font-bold mb-2">Your cart is empty</h3>
                                        <p class="text-white/50 mb-6">Looks like you haven't added anything to your cart
                                            yet.</p>
                                        <a href="/user/shop"
                                            class="inline-block bg-primary hover:bg-primary/90 text-white font-bold py-3 px-8 rounded-xl transition-all">Start
                                            Shopping</a>
                                    </div>
                                    <% } %>
                                        <div class="pt-6">
                                            <a class="inline-flex items-center gap-2 text-primary hover:underline font-medium"
                                                href="/user/shop">
                                                <span class="material-symbols-outlined text-sm">arrow_back</span>
                                                Continue Shopping
                                            </a>
                                        </div>
                </div>
                <!-- Right Side: Summary Sidebar -->
                <div class="w-full lg:w-[400px]">
                    <div class="glass rounded-xl p-8 sticky top-32">
                        <h3 class="text-2xl font-bold mb-8">Summary</h3>
                        <div class="space-y-4 mb-8">
                            <div class="flex justify-between items-center">
                                <span class="text-white/60 font-medium">Subtotal</span>
                                <span id="summary-subtotal" class="font-semibold">₹<%= subtotal.toFixed(2) %></span>
                            </div>
                            <div class="flex justify-between items-center">
                                <span class="text-white/60 font-medium">Shipping</span>
                                <span class="text-green-500 font-semibold uppercase text-xs">Free</span>
                            </div>
                            <div class="flex justify-between items-center">
                                <span class="text-white/60 font-medium">Estimated Tax</span>
                                <span id="summary-tax" class="font-semibold">₹<%= tax.toFixed(2) %></span>
                            </div>
                            <div class="h-px bg-white/10 my-6"></div>
                            <div class="flex justify-between items-center">
                                <span class="text-xl font-bold">Total</span>
                                <span id="summary-total" class="text-2xl font-black text-primary">₹<%= total.toFixed(2)
                                        %></span>
                            </div>
                        </div>
                        <div class="space-y-4">
                            <% const isEmpty=!cart || !cart.items || cart.items.length===0; const hasUnavailable=cart &&
                                cart.items && cart.items.some(i=> i.isUnavailable);
                                const isDisabled = isEmpty || hasUnavailable;
                                %>
                                <a href="javascript:void(0)"
                                    onclick="<%= isEmpty ? 'return showEmptyCartWarning()' : (hasUnavailable ? 'return showUnavailableWarning()' : `return validateAndProceedToCheckout(${total.toFixed(2)})`) %>"
                                    class="w-full bg-primary hover:bg-primary/90 text-white font-bold py-4 rounded-xl transition-all shadow-lg shadow-primary/20 flex items-center justify-center gap-2 <%= isDisabled ? 'opacity-50 cursor-not-allowed' : '' %>">
                                    PROCEED TO CHECKOUT
                                    <span class="material-symbols-outlined">chevron_right</span>
                                </a>
                                <% if (hasUnavailable) { %>
                                    <p class="text-red-500 text-xs text-center mt-2">Please remove unavailable items to
                                        proceed.</p>
                                    <% } else if (isEmpty) { %>
                                        <p
                                            class="text-white/30 text-[10px] text-center mt-2 uppercase tracking-widest font-black">
                                            Add items to checkout</p>
                                        <% } %>
                                            <div
                                                class="flex items-center justify-center gap-4 pt-4 grayscale opacity-40">
                                                <span class="material-symbols-outlined">payments</span>
                                                <span class="material-symbols-outlined">credit_card</span>
                                                <span class="material-symbols-outlined">account_balance</span>
                                            </div>
                        </div>
                    </div>
                    <div class="mt-8 glass p-6 rounded-xl">
                        <div class="flex items-center gap-4 mb-2">
                            <span class="material-symbols-outlined text-primary">local_shipping</span>
                            <p class="font-bold">Fast Delivery</p>
                        </div>
                        <p class="text-white/50 text-sm">Estimated delivery by Friday, Oct 27th. Express options
                            available
                            at checkout.</p>
                    </div>
                </div>
            </div>
        </main>
        <%- include('../../partials/user/footer') %>

            <script src="/js/user/cart/cart.js"></script>
</body>

</html>