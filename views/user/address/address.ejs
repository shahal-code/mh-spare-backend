<!DOCTYPE html>

<html class="dark" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>TechKart | Saved Addresses</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link
        href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&amp;family=Noto+Sans:wght@300;400;500;600&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#0657f9",
                        "background-light": "#f5f6f8",
                        "background-dark": "#0D0D0D",
                        "card-dark": "#161b22",
                    },
                    fontFamily: {
                        "display": ["Space Grotesk", "sans-serif"]
                    },
                    borderRadius: { "DEFAULT": "0.5rem", "lg": "1rem", "xl": "1.5rem", "full": "9999px" },
                },
            },
        }
    </script>
    <link rel="stylesheet" href="/css/views/user/address/address.css">
</head>

<body
    class="bg-background-light dark:bg-background-dark font-display text-white selection:bg-primary selection:text-white">
    <div class="flex h-screen overflow-hidden">
        <%- include('../../partials/user/sidebar') %>


        <main class="flex-1 flex flex-col overflow-y-auto">
            <header
                class="flex items-center justify-between px-4 md:px-10 py-5 border-b border-white/5 bg-background-dark/50 backdrop-blur-md sticky top-0 z-10 flex-wrap gap-y-4">
                <div class="flex items-center gap-10">
                    <nav class="flex items-center gap-8">
                        <a class="text-white/70 hover:text-primary text-xs font-bold tracking-widest transition-colors"
                            href="/user">HOME</a>
                        <a class="text-white/70 hover:text-primary text-xs font-bold tracking-widest transition-colors"
                            href="/user/shop">SHOP</a>
                        <a class="text-white/70 hover:text-primary text-xs font-bold tracking-widest transition-colors"
                            href="/user/contact">CONTACT US</a>
                        <a class="text-white/70 hover:text-primary text-xs font-bold tracking-widest transition-colors"
                            href="/user/about">ABOUT US</a>
                    </nav>
                </div>
                <div class="flex items-center gap-6">
                    <div class="relative group">
                        <span
                            class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-white/40 text-lg">search</span>
                        <input
                            class="bg-white/5 border-none rounded-xl pl-10 pr-4 py-2 text-sm w-64 focus:ring-1 focus:ring-primary placeholder:text-white/30"
                            placeholder="Search tech catalog..." type="text" />
                    </div>
                    <button class="relative p-2 text-white/70 hover:text-white transition-colors">
                        <span class="material-symbols-outlined">shopping_cart</span>
                        <span class="absolute top-1 right-1 size-2 bg-primary rounded-full"></span>
                    </button>
                    <button class="p-2 text-white/70 hover:text-white transition-colors">
                        <span class="material-symbols-outlined">notifications</span>
                    </button>
                </div>
            </header>

            <section class="p-4 md:p-10 max-w-6xl mx-auto w-full">
                <div class="flex flex-col gap-2 mb-10">
                    <h2 class="text-white text-4xl font-black leading-tight tracking-tight font-display italic">
                        Saved Addresses
                    </h2>
                    <p class="text-[#8ea3cc] text-base font-normal">
                        Manage your shipping and billing locations with ease.
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-6">
                    <% if (addresses && addresses.length> 0) { %>
                        <% addresses.forEach(addr=> { %>
                            <!-- Dynamic Address Card -->
                            <div
                                class="glass-card rounded-2xl p-8 hover:bg-white/10 transition-all group border border-white/5">
                                <div class="flex justify-between items-start mb-6">
                                    <div
                                        class="size-14 rounded-xl bg-primary/20 flex items-center justify-center text-primary border border-primary/20 group-hover:scale-110 transition-transform">
                                        <span class="material-symbols-outlined text-3xl">
                                            <%= addr.address_type==='Home' ? 'home' : (addr.address_type==='Work'
                                                ? 'work' : 'location_on' ) %>
                                        </span>
                                    </div>
                                    <div class="flex flex-col items-end gap-2">
                                        <span
                                            class="bg-primary/20 text-primary text-[10px] font-bold px-3 py-1.5 rounded-full uppercase tracking-widest text-center">
                                            <%= addr.address_type %>
                                        </span>
                                        <% if (addr.is_default) { %>
                                            <span
                                                class="bg-emerald-500/20 text-emerald-400 text-[10px] font-bold px-3 py-1.5 rounded-full uppercase tracking-widest border border-emerald-500/20">
                                                Default
                                            </span>
                                        <% } %>
                                    </div>
                                </div>
                                <h3 class="text-white text-xl font-bold mb-2">
                                    <%= addr.fullname %>
                                </h3>
                                <p class="text-white/50 text-sm leading-relaxed mb-6">
                                    <%= addr.line1 %><br />
                                        <% if (addr.line2) { %>
                                            <%= addr.line2 %><br />
                                                <% } %>
                                                    <%= addr.city %>, <%= addr.state %>
                                                            <%= addr.postal_code %>
                                </p>
                                <div class="flex items-center gap-3 text-white/40 text-xs font-medium mb-8">
                                    <span class="material-symbols-outlined text-sm">call</span>
                                    <%= addr.phone %>
                                </div>

                                <div class="flex items-center gap-3 text-white/40 text-xs font-medium mb-8">
                                    <span class="material-symbols-outlined text-sm">mail</span>
                                    <%= addr.email %>
                                </div>
      
                                
                                <div class="flex gap-4 pt-6 border-t border-white/5">
                                    <% if (!addr.is_default) { %>
                                        <button onclick="window.location.href='/user/address/set-default/<%= addr._id %>'"
                                            class="flex-1 rounded-xl py-3 bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-400 text-[10px] font-black uppercase tracking-widest transition-all flex items-center justify-center gap-2">
                                            <span class="material-symbols-outlined text-sm">check_circle</span>
                                            MAKE DEFAULT
                                        </button>
                                    <% } %>
                                    
                                    <button onclick="window.location.href='/user/address/edit/<%= addr._id %>'"
                                        class="flex-1 rounded-xl py-3 bg-white/5 hover:bg-white/10 text-white text-[10px] font-black uppercase tracking-widest transition-all flex items-center justify-center gap-2">
                                        <span class="material-symbols-outlined text-sm">edit</span>
                                        EDIT
                                    </button>

                                    <button onclick="confirmDelete('<%= addr._id %>')"
                                        class="flex-1 rounded-xl py-3 bg-transparent hover:bg-rose-500/10 text-white/40 hover:text-rose-400 text-[10px] font-black uppercase tracking-widest transition-all flex items-center justify-center gap-2">
                                        <span class="material-symbols-outlined text-sm">delete</span>
                                        REMOVE
                                    </button>
                                </div>
                            </div>
                            <% }) %>
                                <% } %>

                                    <!-- Add New Address Card -->
                                    <div onclick="window.location.href='/user/add-address'"
                                        class="border-2 border-dashed border-white/10 rounded-2xl p-8 flex flex-col items-center justify-center gap-6 group cursor-pointer hover:border-primary/50 hover:bg-primary/5 transition-all min-h-[320px]">
                                        <div
                                            class="size-16 rounded-full bg-primary flex items-center justify-center text-white shadow-[0_0_20px_rgba(6,87,249,0.4)] group-hover:scale-110 transition-transform">
                                            <span class="material-symbols-outlined text-4xl">add</span>
                                        </div>
                                        <div class="text-center">
                                            <h3 class="text-white text-xl font-bold">Add New Address</h3>
                                            <p class="text-white/40 text-sm">Create a new shipping location</p>
                                        </div>
                                    </div>
                </div>
            </section>
        </main>
    </div>

    <!-- Custom Delete Confirmation Modal -->
    <div id="deleteModal" class="fixed inset-0 z-50 hidden">
        <!-- Backdrop -->
        <div class="absolute inset-0 bg-black/60 backdrop-blur-sm transition-opacity"></div>
        
        <!-- Modal Content -->
        <div class="relative min-h-screen flex items-center justify-center p-4">
            <div class="glass-card bg-[#0d0d0d] border border-white/10 rounded-[2.5rem] w-full max-w-md p-10 flex flex-col items-center text-center shadow-2xl scale-95 opacity-0 transition-all duration-300 transform" id="modalContent">
                <div class="size-24 rounded-full border-2 border-orange-500/30 flex items-center justify-center mb-8 bg-orange-500/5">
                    <span class="material-symbols-outlined text-5xl text-orange-500">warning</span>
                </div>
                
                <h3 class="text-white text-3xl font-black mb-4 tracking-tight">Remove Address?</h3>
                <p class="text-white/60 text-lg mb-10 leading-relaxed px-4">
                    Are you sure you want to remove this shipping location?
                </p>
                
                <div class="flex gap-4 w-full">
                    <button onclick="hideDeleteModal()" class="flex-1 bg-white/5 hover:bg-white/10 text-white font-bold py-4 rounded-2xl transition-all border border-white/5 uppercase tracking-widest text-xs">
                        Cancel
                    </button>
                    <button id="confirmDeleteBtn" class="flex-1 bg-rose-500 hover:bg-rose-600 text-white font-bold py-4 rounded-2xl transition-all shadow-lg shadow-rose-500/20 uppercase tracking-widest text-xs">
                        Yes, Remove
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script src="/js/user/address/address-list.js"></script>
</body>
</html>