<!DOCTYPE html>
<html class="dark" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>MH SPARE HUB | Reset Password</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;900&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    
    <!-- ═══ MH SPARE HUB Design System ═══ -->
    <link rel="stylesheet" href="/css/mh-design.css">
    <script>(function(){try{const t=localStorage.getItem('theme');if(t==='light')document.documentElement.classList.remove('dark');else document.documentElement.classList.add('dark');}catch(e){}})()</script>
    
    <link rel="stylesheet" href="/css/views/user/auth/reset-password.css">
    <script src="/js/user/auth/reset-password.js"></script>
</head>

<body style="background: var(--bg-page); color: var(--text-primary); overflow-x: hidden; min-height: 100vh;">
    <div class="flex h-screen w-full flex-col lg:flex-row">
        <!-- Hero Section -->
        <div class="relative hidden lg:flex lg:w-1/2 flex-col justify-center items-center overflow-hidden" style="background: var(--bg-surface); border-right: 1px solid var(--border);">
            <div class="relative z-20 flex flex-col items-center text-center px-12">
                <img src="https://raw.githubusercontent.com/muhammedhaseeb9645/MH-SPARE-HUB/refs/heads/main/logo/Logo%20big%20.png" alt="MH SPARE HUB" style="height: 60px; margin-bottom: 24px; filter: drop-shadow(0 0 1px rgba(0,210,255,0.3));">
                <h1 style="font-size: 2.5rem; font-weight: 900; letter-spacing: -0.02em; color: var(--text-primary); margin-bottom: 16px;">Set New Password</h1>
                <p style="font-size: 1.1rem; color: var(--text-muted); max-width: 400px; line-height: 1.6;">
                    Create a strong new password to keep your MH SPARE HUB account secure.
                </p>
            </div>
        </div>
        <!-- Form Section -->
        <div class="flex-1 flex flex-col min-h-screen lg:h-screen overflow-y-auto" style="background: var(--bg-page);">
            <header class="flex items-center justify-between px-8 py-6 lg:px-12">
                <div class="flex items-center gap-3 lg:hidden">
                    <img src="https://raw.githubusercontent.com/muhammedhaseeb9645/MH-SPARE-HUB/refs/heads/main/logo/Logo%20big%20.png" alt="MH SPARE HUB" style="height: 30px;">
                </div>
                <div class="hidden lg:block"></div>
                <a class="text-sm font-medium transition-colors" href="/user/dashboard" style="color: var(--text-muted); hover:color: var(--primary);">Home</a>
            </header>
            <main class="flex-1 flex flex-col justify-center px-6 py-12 lg:px-24">
                <div class="max-w-[440px] w-full mx-auto">
                    <div class="mb-10">
                        <h2 style="font-size: 1.875rem; font-weight: 700; letter-spacing: -0.025em; color: var(--text-primary); margin-bottom: 8px;">Set New Password</h2>
                        <p style="color: var(--text-muted);">Enter your new password below.</p>
                        <% if (locals.message) { %>
                            <div
                                class="bg-red-500/10 border border-red-500/20 text-red-500 px-4 py-3 rounded-lg text-sm mb-4">
                                <%= message %>
                            </div>
                            <% } %>
                    </div>

                    <form action="/user/reset-password" method="POST" class="space-y-6">
                        <div class="flex flex-col gap-2">
                            <label class="text-xs font-semibold text-gray-500 uppercase px-1">New Password</label>
                            <div class="relative group">
                                <input name="password"
                                    class="w-full bg-[#1A1A1A] border border-gray-800 focus:border-[#0055ff] focus:ring-1 focus:ring-[#0055ff] rounded-2xl h-14 pl-4 pr-12 text-white placeholder:text-gray-600 transition-all font-medium outline-none"
                                    placeholder="••••••••" type="password" />
                                <button type="button"
                                    class="toggle-password absolute right-4 top-1/2 -translate-y-1/2 text-gray-600 hover:text-white transition-colors">
                                    <span class="material-symbols-outlined text-[18px]">visibility</span>
                                </button>
                            </div>
                        </div>
                        <div class="flex flex-col gap-2">
                            <label class="text-xs font-semibold text-gray-500 uppercase px-1">Confirm Password</label>
                            <div class="relative group">
                                <input name="confirmPassword"
                                    class="w-full bg-[#1A1A1A] border border-gray-800 focus:border-[#0055ff] focus:ring-1 focus:ring-[#0055ff] rounded-2xl h-14 pl-4 pr-12 text-white placeholder:text-gray-600 transition-all font-medium outline-none"
                                    placeholder="••••••••" type="password" />
                                <button type="button"
                                    class="toggle-password absolute right-4 top-1/2 -translate-y-1/2 text-gray-600 hover:text-white transition-colors">
                                    <span class="material-symbols-outlined text-[18px]">visibility</span>
                                </button>
                            </div>
                        </div>

                        <button
                            class="w-full bg-[#0055ff] hover:bg-[#0055ff]/90 text-white font-bold h-14 rounded-2xl transition-all shadow-[0_0_20px_rgba(0,85,255,0.3)] mt-2 flex items-center justify-center gap-2 text-sm"
                            type="submit">
                            Update Password
                            <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
                        </button>
                    </form>

                    <div class="mt-8 pt-8 border-t border-gray-800">
                        <a href="/user/login"
                            class="flex items-center gap-2 text-gray-400 hover:text-white transition-colors text-sm font-medium w-fit">
                            <span class="material-symbols-outlined text-[18px]">arrow_back</span>
                            Back to Login
                        </a>
                    </div>
                </div>
            </main>
            <footer class="px-8 py-8 lg:px-24">
                <div class="flex justify-between items-center gap-4 text-xs">
                    <a class="text-gray-600 hover:text-gray-400 transition-colors" href="#">Privacy Policy</a>
                    <a class="text-gray-600 hover:text-gray-400 transition-colors" href="#">Terms of Service</a>
                    <a class="text-gray-600 hover:text-gray-400 transition-colors" href="#">Support</a>
                </div>
            </footer>
        </div>
    </div>
    <script src="/js/utils/password-toggle.js"></script>
</body>
</html>