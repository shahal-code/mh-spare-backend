<!DOCTYPE html>
<html class="dark" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Change Password | TechKart</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link
        href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Noto+Sans:wght@300;400;500;600&display=swap"
        rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
        rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#0657f9",
                        "background-dark": "#0D0D0D",
                        "card-dark": "#161b22",
                    },
                    fontFamily: {
                        "display": ["Space Grotesk", "sans-serif"]
                    },
                    borderRadius: { "DEFAULT": "0.5rem", "lg": "1rem", "xl": "1.5rem", "full": "9999px" },
                },
            },
        }
    </script>
    <link rel="stylesheet" href="/css/views/user/auth/change-password.css">
</head>

<body class="bg-background-dark font-display text-white min-h-screen flex flex-col">
    <div class="flex h-screen overflow-hidden">
        <%- include('../../partials/user/sidebar') %>

            <main class="flex-1 flex flex-col overflow-y-auto">
                <header
                    class="flex items-center justify-between px-10 py-5 border-b border-white/5 bg-background-dark/50 backdrop-blur-md sticky top-0 z-10">
                    <div class="flex items-center gap-10">
                        <h1 class="text-xl font-bold tracking-tight">Security</h1>
                    </div>
                </header>

                <section class="p-10 max-w-2xl mx-auto w-full space-y-12 pb-20 mt-10">
                    <div class="glass-card rounded-[2.5rem] p-12 relative border border-white/5 overflow-hidden">
                        <div class="mb-10 text-center">
                            <div
                                class="size-20 rounded-2xl bg-primary/20 flex items-center justify-center mx-auto mb-6 text-primary">
                                <span class="material-symbols-outlined text-4xl">lock_reset</span>
                            </div>
                            <h2 class="text-3xl font-bold tracking-tight mb-2">Change Password</h2>
                            <p class="text-white/40">Ensure your account is using a strong password</p>
                        </div>

                        <div id="messageContainer" class="hidden mb-6 p-4 rounded-xl text-sm font-medium"></div>

                        <form id="changePasswordForm" action="/user/profile/change-password" method="POST"
                            class="space-y-8">
                            <div class="space-y-6">
                                <div class="flex flex-col gap-3">
                                    <label for="currentPassword"
                                        class="text-white/40 text-xs font-bold uppercase tracking-widest ml-1">Current
                                        Password</label>
                                    <div class="relative group">
                                        <input type="password" id="currentPassword" name="currentPassword"
                                            class="w-full input-glass rounded-2xl px-6 py-4 text-white font-medium text-lg placeholder:text-white/20 focus:outline-none ring-0 pr-16">
                                        <button type="button"
                                            class="toggle-password absolute right-6 top-1/2 -translate-y-1/2 text-white/20 hover:text-white transition-colors">
                                            <span class="material-symbols-outlined">visibility</span>
                                        </button>
                                    </div>
                                </div>

                                <div class="flex flex-col gap-3">
                                    <label for="newPassword"
                                        class="text-white/40 text-xs font-bold uppercase tracking-widest ml-1">New
                                        Password</label>
                                    <div class="relative group">
                                        <input type="password" id="newPassword" name="newPassword"
                                            class="w-full input-glass rounded-2xl px-6 py-4 text-white font-medium text-lg placeholder:text-white/20 focus:outline-none ring-0 pr-16">
                                        <button type="button"
                                            class="toggle-password absolute right-6 top-1/2 -translate-y-1/2 text-white/20 hover:text-white transition-colors">
                                            <span class="material-symbols-outlined">visibility</span>
                                        </button>
                                    </div>
                                </div>

                                <div class="flex flex-col gap-3">
                                    <label for="confirmPassword"
                                        class="text-white/40 text-xs font-bold uppercase tracking-widest ml-1">Confirm
                                        New Password</label>
                                    <div class="relative group">
                                        <input type="password" id="confirmPassword" name="confirmPassword"
                                            class="w-full input-glass rounded-2xl px-6 py-4 text-white font-medium text-lg placeholder:text-white/20 focus:outline-none ring-0 pr-16">
                                        <button type="button"
                                            class="toggle-password absolute right-6 top-1/2 -translate-y-1/2 text-white/20 hover:text-white transition-colors">
                                            <span class="material-symbols-outlined">visibility</span>
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <div class="pt-6">
                                <button type="submit"
                                    class="w-full bg-primary hover:bg-primary/90 text-white py-5 rounded-2xl text-lg font-bold transition-all shadow-lg shadow-primary/20 flex items-center justify-center gap-3 group">
                                    Update Password
                                    <span
                                        class="material-symbols-outlined group-hover:scale-110 transition-transform">verified_user</span>
                                </button>
                            </div>
                        </form>
                    </div>
                </section>
            </main>
    </div>

    <script src="/js/utils/password-toggle.js"></script>
    <script src="/js/user/auth/change-password.js"></script>
</body>

</html>