<!DOCTYPE html>
<html class="dark" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>MH SPARE HUB | Email Verification</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;900&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />

    <!-- ═══ MH SPARE HUB Design System ═══ -->
    <link rel="stylesheet" href="/css/mh-design.css">
    <script>(function(){try{const t=localStorage.getItem('theme');if(t==='light')document.documentElement.classList.remove('dark');else document.documentElement.classList.add('dark');}catch(e){}})()</script>

    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#0055ff",
                        "background-light": "#f5f6f8",
                        "background-dark": "#0f1623",
                        "dark-form": "#0D0D0D",
                        "dark-card": "#131313",
                    },
                    fontFamily: {
                        "display": ["Inter", "sans-serif"]
                    },
                    borderRadius: { "DEFAULT": "0.25rem", "lg": "0.5rem", "xl": "0.75rem", "full": "9999px" },
                },
            },
        }
    </script>
    <link rel="stylesheet" href="/css/views/user/auth/otp.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>

<body style="background: var(--bg-page); color: var(--text-primary); overflow-x: hidden; min-height: 100vh;">
    <div class="flex h-screen w-full flex-col lg:flex-row">
        <!-- Hero Section -->
        <div class="relative hidden lg:flex lg:w-1/2 flex-col justify-center items-center overflow-hidden" style="background: var(--bg-surface); border-right: 1px solid var(--border);">
            <div class="relative z-20 flex flex-col items-center text-center px-12">
                <img src="https://raw.githubusercontent.com/muhammedhaseeb9645/MH-SPARE-HUB/refs/heads/main/logo/Logo%20big%20.png" alt="MH SPARE HUB" style="height: 60px; margin-bottom: 24px; filter: drop-shadow(0 0 1px rgba(0,210,255,0.3));">
                <h1 style="font-size: 2.5rem; font-weight: 900; letter-spacing: -0.02em; color: var(--text-primary); margin-bottom: 16px;">Verify Your Email</h1>
                <p style="font-size: 1.1rem; color: var(--text-muted); max-width: 400px; line-height: 1.6;">
                    Please enter the verification code sent to your email to complete registration.
                </p>
            </div>
        </div>
        <!-- Form Section -->
        <div class="flex-1 flex flex-col min-h-screen lg:h-screen overflow-y-auto" style="background: var(--bg-page);">
            <header class="flex items-center justify-between px-8 py-6 lg:px-12">
                <div class="flex items-center gap-3 lg:hidden">
                    <img src="https://raw.githubusercontent.com/muhammedhaseeb9645/MH-SPARE-HUB/refs/heads/main/logo/Logo%20big%20.png" alt="MH SPARE HUB" style="height: 30px;">
                </div>
                <div class="hidden lg:block"></div>
                <a class="text-sm font-medium transition-colors" href="/user/dashboard" style="color: var(--text-muted); hover:color: var(--primary);">Home</a>
            </header>
            <main class="flex-1 flex flex-col justify-center px-6 py-12 lg:px-24">
                <div class="max-w-[440px] w-full mx-auto">
                    <div class="mb-10 text-center lg:text-left">
                        <div class="lg:hidden flex justify-center mb-6">
                            <div class="size-16 rounded-full bg-primary/10 flex items-center justify-center border border-primary/20">
                                <span class="material-symbols-outlined text-primary text-3xl">mark_email_read</span>
                            </div>
                        </div>
                        <h2 style="font-size: 1.875rem; font-weight: 700; letter-spacing: -0.025em; color: var(--text-primary); margin-bottom: 8px;">Check Your Email</h2>
                        <p style="color: var(--text-muted);">We've sent a 6-digit code to your email. Enter it below to verify your account.</p>
                    </div>

                        <% if(typeof message !=='undefined' ) { %>
                            <p class="text-red-500 text-sm mt-2">
                                <%= message %>
                            </p>
                            <% } %>

                    <form action="<%= typeof actionUrl !== 'undefined' ? actionUrl : '/user/verify-otp' %>"
                        method="POST" id="otpForm" class="flex flex-col gap-10">
                        <div class="flex justify-between gap-2 md:gap-4 w-full">
                            <input type="number"
                                class="w-12 h-14 md:w-16 md:h-16 text-center text-2xl font-bold bg-[#1A1A1A] border border-gray-800 rounded-lg text-white focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all"
                                maxLength="1" autofocus oninput="moveToNext(this, event)">
                            <input type="number"
                                class="w-12 h-14 md:w-16 md:h-16 text-center text-2xl font-bold bg-[#1A1A1A] border border-gray-800 rounded-lg text-white focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all"
                                maxLength="1" oninput="moveToNext(this, event)">
                            <input type="number"
                                class="w-12 h-14 md:w-16 md:h-16 text-center text-2xl font-bold bg-[#1A1A1A] border border-gray-800 rounded-lg text-white focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all"
                                maxLength="1" oninput="moveToNext(this, event)">
                            <input type="number"
                                class="w-12 h-14 md:w-16 md:h-16 text-center text-2xl font-bold bg-[#1A1A1A] border border-gray-800 rounded-lg text-white focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all"
                                maxLength="1" oninput="moveToNext(this, event)">
                            <input type="number"
                                class="w-12 h-14 md:w-16 md:h-16 text-center text-2xl font-bold bg-[#1A1A1A] border border-gray-800 rounded-lg text-white focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all"
                                maxLength="1" oninput="moveToNext(this, event)">
                            <input type="number"
                                class="w-12 h-14 md:w-16 md:h-16 text-center text-2xl font-bold bg-[#1A1A1A] border border-gray-800 rounded-lg text-white focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all"
                                maxLength="1" oninput="moveToNext(this, event)">
                        </div>

                        <input type="hidden" name="otp" id="otpValue">
                        <input type="hidden" id="resendUrl"
                            value="<%= typeof resendUrl !== 'undefined' ? resendUrl : '/user/resend-otp' %>">

                        <div class="flex flex-col items-center gap-6 mt-2">
                            <button
                                class="w-full bg-primary hover:bg-primary/90 text-white font-bold h-14 rounded-lg transition-all shadow-[0_0_20px_rgba(0,85,255,0.3)] flex items-center justify-center gap-2"
                                type="submit" onclick="submitOtp()">
                                Verify & Continue
                            </button>

                            <div class="text-sm font-medium flex flex-col items-center gap-2">
                                <span class="text-gray-400">Didn't receive the code?
                                    <button type="button" id="resendBtn"
                                        class="text-primary hover:underline ml-1 cursor-not-allowed opacity-50" disabled
                                        onclick="resendOtp()">Resend</button>
                                </span>
                                <span class="text-xs text-gray-500" id="timerText"
                                    data-expires-in="<%= typeof expiresIn !== 'undefined' ? expiresIn : 60 %>">Resend in
                                    <span id="timer">00:60</span></span>
                            </div>
                        </div>
                    </form>
                </div>
            </main>

            <footer class="absolute bottom-0 w-full px-8 py-8 text-center bg-transparent z-20">
                <p class="text-gray-600 text-[11px] font-medium tracking-wide">
                    © 2024 TechKart Inc. All rights reserved. <a class="hover:text-gray-400 ml-1 transition-colors"
                        href="#">Privacy Policy</a> · <a class="hover:text-gray-400 transition-colors" href="#">Terms of
                        Service</a>
                </p>
            </footer>
        </div>
    </div>

    <script src="/js/user/auth/otp.js"></script>
</body>

</html>