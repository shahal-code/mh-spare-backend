<!DOCTYPE html>
<html class="dark" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Payment Failed | TechKart</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#f43f5e",
                        "background-dark": "#0D0D0D",
                        "card-dark": "#161b22",
                    },
                    fontFamily: {
                        "display": ["Space Grotesk", "sans-serif"]
                    }
                },
            },
        }
    </script>
    <link rel="stylesheet" href="/css/views/user/checkout/paymentFailure.css">
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>

<body class="bg-background-dark font-display text-white overflow-hidden">
    <div class="min-h-screen flex items-center justify-center p-6 relative">
        <!-- Abstract Background Glows -->
        <div class="absolute top-0 left-0 w-full h-full overflow-hidden -z-10">
            <div class="absolute -top-1/4 -left-1/4 size-[500px] bg-primary/20 blur-[120px] rounded-full"></div>
            <div class="absolute -bottom-1/4 -right-1/4 size-[500px] bg-rose-500/10 blur-[120px] rounded-full"></div>
        </div>

        <% const hasOrder = typeof order !== 'undefined' && order; %>
        <div class="max-w-xl w-full text-center space-y-10">
            <!-- Animated Failure Icon -->
            <div class="relative inline-block">
                <div class="size-32 rounded-[2.5rem] bg-primary/10 flex items-center justify-center animate-check border border-primary/20 failure-glow mx-auto">
                    <span class="material-symbols-outlined text-6xl text-primary font-bold">error</span>
                </div>
                <div class="absolute -top-4 -right-4 size-10 rounded-2xl bg-rose-500 flex items-center justify-center shadow-lg shadow-rose-500/20 border border-rose-400/20 animate-bounce">
                    <span class="material-symbols-outlined text-white text-lg">cancel</span>
                </div>
            </div>

            <!-- Content -->
            <div class="space-y-4 animate-fade-up delay-1">
                <h1 class="text-5xl font-black tracking-tighter leading-none">
                    Payment <span class="text-primary">Failed</span>
                </h1>
                <p class="text-white/40 text-lg font-medium max-w-sm mx-auto leading-relaxed">
                    <% if (hasOrder) { %>
                        We couldn't process your payment. Don't worry, your items are safe.
                    <% } else { %>
                        We couldn't process your payment. No order was placed.
                    <% } %>
                </p>
            </div>

            <!-- Order ID Card -->
            <div class="glass-card rounded-[2rem] p-6 max-w-sm mx-auto flex items-center justify-between group hover:bg-white/[0.05] transition-all animate-fade-up delay-2">
                <div class="text-left">
                    <p class="text-[10px] font-black text-white/20 uppercase tracking-[0.2em] mb-1">
                        <%= hasOrder ? 'Order Reference' : 'Payment Status' %>
                    </p>
                    <p class="text-xl font-bold tracking-widest text-primary">
                        <%= hasOrder ? orderId : 'NOT PLACED' %>
                    </p>
                </div>
                <div class="size-12 rounded-2xl bg-white/5 flex items-center justify-center group-hover:bg-primary/20 transition-colors">
                    <span class="material-symbols-outlined text-white/40 group-hover:text-primary transition-colors">receipt_long</span>
                </div>
            </div>

            <!-- Actions -->
            <div class="flex flex-col sm:flex-row gap-4 justify-center pt-6 animate-fade-up delay-3">
                <% if (hasOrder) { %>
                    <button id="retry-btn" class="bg-primary hover:bg-primary/90 text-white px-8 py-4 rounded-2xl font-bold transition-all shadow-xl shadow-primary/20 flex items-center justify-center gap-3 group relative overflow-hidden">
                        <span class="relative z-10 flex items-center gap-3">
                            <span class="material-symbols-outlined group-hover:-rotate-180 transition-transform duration-500">refresh</span>
                            Retry Payment
                        </span>
                    </button>
                    <a href="/user/orders" class="bg-white/5 hover:bg-white/10 text-white px-8 py-4 rounded-2xl font-bold transition-all border border-white/10 flex items-center justify-center gap-3">
                        View Orders
                        <span class="material-symbols-outlined">receipt</span>
                    </a>
                <% } else { %>
                    <a href="/user/checkout" class="bg-primary hover:bg-primary/90 text-white px-8 py-4 rounded-2xl font-bold transition-all shadow-xl shadow-primary/20 flex items-center justify-center gap-3 group relative overflow-hidden">
                        <span class="relative z-10 flex items-center gap-3">
                            <span class="material-symbols-outlined group-hover:-rotate-180 transition-transform duration-500">refresh</span>
                            Try Again
                        </span>
                    </a>
                    <a href="/user/cart" class="bg-white/5 hover:bg-white/10 text-white px-8 py-4 rounded-2xl font-bold transition-all border border-white/10 flex items-center justify-center gap-3">
                        View Cart
                        <span class="material-symbols-outlined">shopping_cart</span>
                    </a>
                <% } %>
            </div>

            <!-- Support Footer -->
            <p class="text-white/20 text-xs font-bold uppercase tracking-[0.3em] pt-10 animate-fade-up delay-3">
                Need help? <a href="/user/support" class="text-white hover:text-primary transition-colors underline underline-offset-4">Contact Support</a>
            </p>
        </div>
    </div>

    <script>
        window.paymentFailureData = {
            orderAmount: <%= hasOrder ? order.finalAmount : 'null' %>,
            razorpayKey: "<%= razorpayKey %>",
            orderId: <%- JSON.stringify(orderId || null) %>,
            userName: <%- JSON.stringify((user?.fullname || '').replace(/[^a-zA-Z\s]/g, '').trim() || 'Customer') %>,
            userEmail: <%- JSON.stringify(user?.email || '') %>,
            userPhone: <%- JSON.stringify(user?.phone || '') %>
        };
    </script>
    <script src="/js/user/checkout/paymentFailure.js"></script>
</body>

</html>
