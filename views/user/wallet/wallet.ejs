<!DOCTYPE html>
<html class="dark" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>My Wallet | TechKart</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Noto+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#0657f9",
                        "background-dark": "#0D0D0D",
                        "card-dark": "#161b22",
                    },
                    fontFamily: { "display": ["Space Grotesk", "sans-serif"] },
                    borderRadius: { "DEFAULT": "0.5rem", "lg": "1rem", "xl": "1.5rem", "full": "9999px" },
                },
            },
        }
    </script>
    <link rel="stylesheet" href="/css/views/user/wallet/wallet.css">
</head>

<body class="bg-background-dark font-display text-white selection:bg-primary selection:text-white">
    <div class="flex h-screen overflow-hidden">
        <%- include('../../partials/user/sidebar') %>

        <main class="flex-1 flex flex-col overflow-y-auto">
            <header class="flex items-center justify-between px-4 md:px-10 py-5 border-b border-white/5 bg-background-dark/50 backdrop-blur-md sticky top-0 z-10 flex-wrap gap-y-4">
                <div class="flex items-center gap-3">
                    <span class="material-symbols-outlined text-primary">account_balance_wallet</span>
                    <h1 class="text-xl font-bold tracking-tight">My Wallet</h1>
                </div>
            </header>

            <section class="p-4 md:p-8 max-w-5xl mx-auto w-full space-y-8 pb-20">

                <!-- Wallet Card -->
                <div class="wallet-card rounded-3xl p-8 shadow-2xl shadow-primary/20 border border-white/10">
                    <div class="relative z-10">
                        <div class="flex items-start justify-between mb-8">
                            <div>
                                <p class="text-white/50 text-xs font-bold uppercase tracking-[0.2em] mb-1">TechKart Wallet</p>
                                <p class="text-white font-bold text-lg"><%= user.fullname %></p>
                            </div>
                            <div class="size-12 rounded-2xl bg-white/10 flex items-center justify-center backdrop-blur-md">
                                <span class="material-symbols-outlined text-white text-2xl">account_balance_wallet</span>
                            </div>
                        </div>

                        <div class="mb-8">
                            <p class="text-white/40 text-xs font-bold uppercase tracking-widest mb-2">Available Balance</p>
                            <div class="flex items-end gap-2">
                                <span class="text-white text-5xl font-black tracking-tight">₹<%= balance.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></span>
                            </div>
                        </div>

                        <div class="flex items-center gap-3">
                            <div class="flex items-center gap-2 bg-white/10 px-4 py-2 rounded-full backdrop-blur-sm">
                                <span class="size-2 rounded-full bg-emerald-400 animate-pulse"></span>
                                <span class="text-white text-xs font-bold uppercase tracking-widest">Active</span>
                            </div>
                            <div class="flex items-center gap-2 bg-white/10 px-4 py-2 rounded-full backdrop-blur-sm">
                                <span class="material-symbols-outlined text-white/70 text-sm">shield</span>
                                <span class="text-white/70 text-xs font-bold uppercase tracking-widest">Secure</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Info Cards -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div class="glass-card rounded-2xl p-6 border border-white/5">
                        <div class="flex items-center gap-3 mb-3">
                            <div class="size-10 rounded-xl bg-emerald-500/10 flex items-center justify-center">
                                <span class="material-symbols-outlined text-emerald-400">trending_up</span>
                            </div>
                            <span class="text-white/50 text-xs font-bold uppercase tracking-widest">Total Credits</span>
                        </div>
                        <p class="text-2xl font-black text-emerald-400">
                            ₹<%= transactions.filter(t => t.type === 'credit').reduce((s, t) => s + t.amount, 0).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                        </p>
                    </div>
                    <div class="glass-card rounded-2xl p-6 border border-white/5">
                        <div class="flex items-center gap-3 mb-3">
                            <div class="size-10 rounded-xl bg-rose-500/10 flex items-center justify-center">
                                <span class="material-symbols-outlined text-rose-400">trending_down</span>
                            </div>
                            <span class="text-white/50 text-xs font-bold uppercase tracking-widest">Total Debits</span>
                        </div>
                        <p class="text-2xl font-black text-rose-400">
                            ₹<%= transactions.filter(t => t.type === 'debit').reduce((s, t) => s + t.amount, 0).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                        </p>
                    </div>
                    <div class="glass-card rounded-2xl p-6 border border-white/5">
                        <div class="flex items-center gap-3 mb-3">
                            <div class="size-10 rounded-xl bg-primary/10 flex items-center justify-center">
                                <span class="material-symbols-outlined text-primary">receipt_long</span>
                            </div>
                            <span class="text-white/50 text-xs font-bold uppercase tracking-widest">Transactions</span>
                        </div>
                        <p class="text-2xl font-black text-white"><%= total %></p>
                    </div>
                </div>

                <!-- Transaction History -->
                <div class="glass-card rounded-3xl p-8 border border-white/5">
                    <div class="flex items-center justify-between mb-6">
                        <h2 class="text-xl font-bold">Transaction History</h2>
                        <span class="text-white/30 text-xs font-bold uppercase tracking-widest"><%= total %> total</span>
                    </div>

                    <% if (transactions && transactions.length > 0) { %>
                        <div class="space-y-3">
                            <% transactions.forEach(txn => { %>
                                <div class="flex items-center gap-4 p-4 rounded-2xl border transition-all hover:bg-white/5 <%= txn.type === 'credit' ? 'credit-bg' : 'debit-bg' %>">
                                    <!-- Icon -->
                                    <div class="size-12 rounded-xl flex items-center justify-center flex-shrink-0 <%= txn.type === 'credit' ? 'bg-emerald-500/20' : 'bg-rose-500/20' %>">
                                        <span class="material-symbols-outlined text-xl <%= txn.type === 'credit' ? 'text-emerald-400' : 'text-rose-400' %>">
                                            <%= txn.type === 'credit' ? 'add_circle' : 'remove_circle' %>
                                        </span>
                                    </div>

                                    <!-- Details -->
                                    <div class="flex-1 min-w-0">
                                        <p class="font-semibold text-sm text-white truncate"><%= txn.description %></p>
                                        <div class="flex items-center gap-3 mt-1">
                                            <% if (txn.orderId) { %>
                                                <span class="text-white/30 text-[10px] font-mono">Order: <%= txn.orderId %></span>
                                            <% } %>
                                            <span class="text-white/30 text-[10px]">
                                                <%= new Date(txn.createdAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                                            </span>
                                        </div>
                                    </div>

                                    <!-- Amount -->
                                    <div class="text-right flex-shrink-0">
                                        <p class="font-black text-lg <%= txn.type === 'credit' ? 'credit-badge' : 'debit-badge' %>">
                                            <%= txn.type === 'credit' ? '+' : '-' %>₹<%= txn.amount.toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                                        </p>
                                        <span class="text-[10px] font-bold uppercase tracking-widest px-2 py-0.5 rounded-full
                                            <%= txn.status === 'success' ? 'bg-emerald-500/10 text-emerald-400' :
                                               txn.status === 'pending' ? 'bg-amber-500/10 text-amber-400' : 'bg-rose-500/10 text-rose-400' %>">
                                            <%= txn.status %>
                                        </span>
                                    </div>
                                </div>
                            <% }) %>
                        </div>

                        <!-- Pagination -->
                        <% if (totalPages > 1) { %>
                            <div class="flex items-center justify-center gap-2 mt-8">
                                <% if (currentPage > 1) { %>
                                    <a href="?page=<%= currentPage - 1 %>"
                                        class="flex items-center gap-2 px-4 py-2 rounded-xl bg-white/5 hover:bg-white/10 text-white/70 hover:text-white transition-all text-sm font-bold">
                                        <span class="material-symbols-outlined text-sm">chevron_left</span> Prev
                                    </a>
                                <% } %>
                                <% for (let i = 1; i <= totalPages; i++) { %>
                                    <a href="?page=<%= i %>"
                                        class="size-10 rounded-xl flex items-center justify-center text-sm font-bold transition-all
                                        <%= i === currentPage ? 'bg-primary text-white shadow-lg shadow-primary/30' : 'bg-white/5 text-white/50 hover:bg-white/10 hover:text-white' %>">
                                        <%= i %>
                                    </a>
                                <% } %>
                                <% if (currentPage < totalPages) { %>
                                    <a href="?page=<%= currentPage + 1 %>"
                                        class="flex items-center gap-2 px-4 py-2 rounded-xl bg-white/5 hover:bg-white/10 text-white/70 hover:text-white transition-all text-sm font-bold">
                                        Next <span class="material-symbols-outlined text-sm">chevron_right</span>
                                    </a>
                                <% } %>
                            </div>
                        <% } %>

                    <% } else { %>
                        <!-- Empty State -->
                        <div class="flex flex-col items-center justify-center py-20 text-center">
                            <div class="size-24 rounded-3xl bg-primary/10 flex items-center justify-center mb-6">
                                <span class="material-symbols-outlined text-5xl text-primary/50">account_balance_wallet</span>
                            </div>
                            <h3 class="text-xl font-bold text-white mb-2">No Transactions Yet</h3>
                            <p class="text-white/40 text-sm max-w-sm leading-relaxed">
                                Your wallet is all set! Refunds from cancelled or returned orders will appear here automatically.
                            </p>
                        </div>
                    <% } %>
                </div>

                <!-- How it works -->
                <div class="glass-card rounded-3xl p-8 border border-white/5">
                    <h3 class="text-lg font-bold mb-6 flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary">info</span>
                        How TechKart Wallet Works
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <div class="flex gap-4">
                            <div class="size-10 rounded-xl bg-primary/10 flex items-center justify-center flex-shrink-0">
                                <span class="material-symbols-outlined text-primary text-lg">cancel</span>
                            </div>
                            <div>
                                <p class="font-bold text-sm mb-1">Order Cancellation</p>
                                <p class="text-white/40 text-xs leading-relaxed">Cancelled orders are refunded instantly to your wallet.</p>
                            </div>
                        </div>
                        <div class="flex gap-4">
                            <div class="size-10 rounded-xl bg-amber-500/10 flex items-center justify-center flex-shrink-0">
                                <span class="material-symbols-outlined text-amber-400 text-lg">assignment_return</span>
                            </div>
                            <div>
                                <p class="font-bold text-sm mb-1">Return Refunds</p>
                                <p class="text-white/40 text-xs leading-relaxed">Return refunds are credited after admin confirms the return.</p>
                            </div>
                        </div>
                        <div class="flex gap-4">
                            <div class="size-10 rounded-xl bg-emerald-500/10 flex items-center justify-center flex-shrink-0">
                                <span class="material-symbols-outlined text-emerald-400 text-lg">shopping_cart</span>
                            </div>
                            <div>
                                <p class="font-bold text-sm mb-1">Pay with Wallet</p>
                                <p class="text-white/40 text-xs leading-relaxed">Use your balance to pay for any order at checkout.</p>
                            </div>
                        </div>
                    </div>
                </div>

            </section>
        </main>
    </div>
    <script src="/js/partials/sidebar.js"></script>
</body>

</html>
