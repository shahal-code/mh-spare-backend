<!DOCTYPE html>

<html class="dark" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>TechKart Profile Overview</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link
        href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&amp;family=Noto+Sans:wght@300;400;500;600&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script id="tailwind-config">

        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#0657f9",
                        "background-light": "#f5f6f8",
                        "background-dark": "#0D0D0D",
                        "card-dark": "#161b22",
                    },
                    fontFamily: {
                        "display": ["Space Grotesk", "sans-serif"]
                    },
                    borderRadius: { "DEFAULT": "0.5rem", "lg": "1rem", "xl": "1.5rem", "full": "9999px" },
                },
            },
        }
    </script>
    <link rel="stylesheet" href="/css/views/user/profile/profile.css">
</head>

<body
    class="bg-background-light dark:bg-background-dark font-display text-white selection:bg-primary selection:text-white">
    <div class="flex h-screen overflow-hidden">
        <%- include('../../partials/user/sidebar') %>

            <main class="flex-1 flex flex-col overflow-y-auto">
                <header
                    class="flex items-center justify-between px-4 md:px-10 py-5 border-b border-white/5 bg-background-dark/50 backdrop-blur-md sticky top-0 z-10 flex-wrap gap-y-4">
                    <div class="flex flex-wrap items-center gap-10">

                    </div>
                    <div class="flex items-center gap-6">
                        <div class="relative group">
                            <span
                                class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-white/40 text-lg">search</span>
                            <input
                                class="bg-white/5 border-none rounded-xl pl-10 pr-4 py-2 text-sm w-64 focus:ring-1 focus:ring-primary placeholder:text-white/30"
                                placeholder="Search tech catalog..." type="text" />
                        </div>
                        <button class="relative p-2 text-white/70 hover:text-white transition-colors">
                            <span class="material-symbols-outlined">shopping_cart</span>
                            <span class="absolute top-1 right-1 size-2 bg-primary rounded-full"></span>
                        </button>
                        <button class="p-2 text-white/70 hover:text-white transition-colors">
                            <span class="material-symbols-outlined">notifications</span>
                        </button>
                    </div>
                </header>
                <section class="p-4 md:p-10 max-w-5xl mx-auto w-full space-y-12 pb-20 mt-10">

                    <!-- Flash Message Container -->
                    <div id="flash-message-container" class="hidden fixed top-24 left-1/2 -translate-x-1/2 z-50">
                        <div id="flash-message"
                            class="flex items-center gap-3 px-6 py-4 rounded-xl shadow-2xl border backdrop-blur-md transition-all duration-300 translate-y-[-1rem] opacity-0">
                            <span id="flash-icon" class="material-symbols-outlined text-xl"></span>
                            <span id="flash-text" class="text-sm font-bold tracking-wide"></span>
                            <button onclick="closeFlashMessage()"
                                class="ml-4 text-white/50 hover:text-white transition-colors">
                                <span class="material-symbols-outlined text-sm">close</span>
                            </button>
                        </div>
                    </div>

                    <!-- Personal Information Card -->
                    <div class="glass-card rounded-[2.5rem] p-12 relative border border-white/5 overflow-hidden">
                        <div class="flex items-center justify-between mb-12">
                            <h2 class="text-2xl font-bold tracking-tight">Personal Information</h2>
                            <button onclick="window.location.href='/user/profile/edit'"
                                class="bg-primary/10 hover:bg-primary/20 text-primary px-6 py-2.5 rounded-xl text-sm font-bold transition-all flex items-center gap-2 border border-primary/10">
                                <span class="material-symbols-outlined text-lg">edit</span>
                                Edit
                            </button>
                        </div>

                        <div class="flex flex-col items-center mb-12">
                            <div class="relative group cursor-pointer">
                                <div
                                    class="size-40 rounded-full border-4 border-primary/30 p-1 glowing-avatar transition-transform group-hover:scale-105 duration-500">
                                    <div
                                        class="size-full rounded-full bg-cover bg-center flex items-center justify-center bg-primary/20 text-primary text-4xl font-black overflow-hidden">
                                        <% if (user.profileImage) { %>
                                            <img src="<%= user.profileImage %>?v=<%= Date.now() %>"
                                                referrerpolicy="no-referrer" class="w-full h-full object-cover" />
                                            <% } else { %>
                                                <%= user.fullname.substring(0, 2).toUpperCase() %>
                                                    <% } %>
                                    </div>
                                </div>
                                <div
                                    class="absolute bottom-2 right-2 size-8 bg-primary rounded-full border-4 border-[#0d0d0d] flex items-center justify-center shadow-lg">
                                    <span class="material-symbols-outlined text-white text-base">verified</span>
                                </div>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 gap-10 max-w-3xl mx-auto">
                            <!-- Full Name -->
                            <div class="flex flex-col gap-3">
                                <label class="text-white/40 text-xs font-bold uppercase tracking-widest ml-1">Full
                                    Name</label>
                                <div
                                    class="w-full bg-white/5 border border-white/5 rounded-2xl px-6 py-5 text-white font-medium text-lg">
                                    <%= user.fullname %>
                                </div>
                            </div>

                            <!-- Email -->
                            <div class="flex flex-col gap-3">
                                <label
                                    class="text-white/40 text-xs font-bold uppercase tracking-widest ml-1">Email</label>
                                <div
                                    class="w-full bg-white/5 border border-white/5 rounded-2xl px-6 py-5 text-white font-medium text-lg">
                                    <%= user.email %>
                                </div>
                            </div>

                            <!-- Phone -->
                            <div class="flex flex-col gap-3">
                                <label
                                    class="text-white/40 text-xs font-bold uppercase tracking-widest ml-1">Phone</label>
                                <div
                                    class="w-full border <%= user.phone ? 'bg-white/5 border-white/5' : 'bg-transparent border-dashed border-white/10' %> rounded-2xl px-6 py-5 flex items-center justify-between">
                                    <span class="text-white font-medium text-lg <%= !user.phone ? 'opacity-30' : '' %>">
                                        <%= user.phone || 'Not added' %>
                                    </span>
                                    <% if (!user.phone) { %>
                                        <button onclick="window.location.href='/user/profile/edit'"
                                            class="text-primary text-sm font-bold hover:underline">+ Add phone
                                            number</button>
                                        <% } %>
                                </div>
                            </div>

                            <hr class="border-white/5 my-4">

                            <!-- Referral Code -->
                            <div class="flex flex-col gap-3">
                                <label class="text-white/40 text-xs font-bold uppercase tracking-widest ml-1">Referral
                                    Code</label>
                                <% const displayReferral=user.referralCode || 'TECHKART' +
                                    user._id.toString().substring(18).toUpperCase(); %>
                                    <div
                                        class="w-full bg-[#111111] border border-white/5 rounded-2xl p-2 flex items-center">
                                        <span class="flex-1 px-6 text-white font-bold tracking-[0.2em] text-xl">
                                            <%= displayReferral %>
                                        </span>
                                        <button onclick="copyToClipboard('<%= displayReferral %>')"
                                            class="bg-white/5 hover:bg-white/10 text-white/70 px-6 py-4 rounded-xl text-sm font-bold transition-all border border-white/5 uppercase tracking-widest">
                                            Copy
                                        </button>
                                    </div>
                                    <p class="text-center text-white/30 text-xs mt-4">
                                        Share your code and both of you will get <span
                                            class="text-primary font-bold">₹1000</span> in wallet
                                    </p>
                            </div>
                        </div>
                    </div>

                    <!-- Secondary Summaries -->
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <div onclick="window.location.href='/user/address'"
                            class="glass-card rounded-3xl p-8 hover:bg-white/10 transition-all group cursor-pointer border border-white/5">
                            <div
                                class="size-16 rounded-2xl bg-primary/20 flex items-center justify-center mb-8 text-primary group-hover:scale-110 transition-transform">
                                <span class="material-symbols-outlined text-4xl">home_pin</span>
                            </div>
                            <h3 class="text-xl font-bold mb-3 tracking-tight">Saved Addresses</h3>
                            <p class="text-white/40 text-sm leading-relaxed mb-8">Manage your shipping and billing
                                locations with ease.</p>
                            <div
                                class="flex items-center gap-3 text-xs font-black text-primary tracking-widest uppercase">
                                <span>Manage</span>
                                <span class="material-symbols-outlined text-sm">arrow_forward_ios</span>
                            </div>
                        </div>

                        <!-- Wallet Card -->
                        <div onclick="window.location.href='/user/wallet'"
                            class="glass-card rounded-3xl p-8 hover:bg-white/10 transition-all group cursor-pointer border border-white/5 relative overflow-hidden">
                            <div
                                class="absolute top-0 right-0 w-32 h-32 bg-primary/5 rounded-full -translate-y-1/2 translate-x-1/2 group-hover:bg-primary/10 transition-all">
                            </div>
                            <div
                                class="size-16 rounded-2xl bg-primary/20 flex items-center justify-center mb-8 text-primary group-hover:scale-110 transition-transform relative z-10">
                                <span class="material-symbols-outlined text-4xl">account_balance_wallet</span>
                            </div>
                            <h3 class="text-xl font-bold mb-3 tracking-tight relative z-10">My Wallet</h3>
                            <p class="text-white/40 text-sm leading-relaxed mb-8 relative z-10">Refunds, credits &
                                wallet payments all in one place.</p>
                            <div
                                class="flex items-center gap-3 text-xs font-black text-primary tracking-widest uppercase relative z-10">
                                <span>View Wallet</span>
                                <span
                                    class="material-symbols-outlined text-sm group-hover:translate-x-1 transition-transform">arrow_forward_ios</span>
                            </div>
                        </div>

                        <div onclick="window.location.href='/user/orders'"
                            class="glass-card rounded-3xl p-8 hover:bg-white/10 transition-all group cursor-pointer border border-white/5">
                            <div
                                class="size-16 rounded-2xl bg-primary/20 flex items-center justify-center mb-8 text-primary group-hover:scale-110 transition-transform">
                                <span class="material-symbols-outlined text-4xl">package_2</span>
                            </div>
                            <h3 class="text-xl font-bold mb-3 tracking-tight">My Orders</h3>
                            <p class="text-white/40 text-sm leading-relaxed mb-8">Track your purchases and order
                                history in one place.</p>
                            <div
                                class="flex items-center gap-3 text-xs font-black text-primary tracking-widest uppercase">
                                <span>View All</span>
                                <span class="material-symbols-outlined text-sm">arrow_forward_ios</span>
                            </div>
                        </div>
                    </div>
                </section>
            </main>
    </div>
    <script src="/js/user/profile/profile.js"></script>
</body>

</html>