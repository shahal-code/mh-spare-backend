<html class="dark" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>About Us | TechKart Legacy</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#0055FF",
                        "dark-bg": "#0D0D0D",
                        "glass-border": "rgba(255, 255, 255, 0.1)",
                    },
                    fontFamily: {
                        "display": ["Inter", "sans-serif"]
                    },
                    borderRadius: {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "2xl": "1.25rem",
                        "full": "9999px"
                    },
                },
            },
        }
    </script>
    <link rel="stylesheet" href="/css/views/user/home/about.css">
</head>

<body class="dark">
    <div class="relative flex h-auto min-h-screen w-full flex-col overflow-x-hidden">
        <div class="layout-container flex h-full grow flex-col">
            <%- include('../../partials/user/header') %>
                <main class="flex-1">
                    <section class="relative py-24 md:py-32 overflow-hidden border-b border-white/5">
                        <div
                            class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-full bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-primary/10 via-transparent to-transparent opacity-50">
                        </div>
                        <div class="max-w-[1200px] mx-auto px-4 relative z-10 text-center">
                            <div
                                class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 mb-8">
                                <span class="size-2 rounded-full bg-primary"></span>
                                <span class="text-primary text-[10px] font-bold uppercase tracking-widest">Our
                                    Story</span>
                            </div>
                            <h1
                                class="text-white text-6xl md:text-8xl font-black mb-8 premium-heading uppercase leading-tight">
                                The TechKart <br /><span class="text-gradient">Legacy</span>
                            </h1>
                            <p class="text-gray-400 text-xl max-w-2xl mx-auto font-medium leading-relaxed">
                                Forging the future of personal computing through relentless innovation and a commitment
                                to
                                uncompromising excellence since our inception.
                            </p>
                        </div>
                    </section>
                    <section class="max-w-[1200px] mx-auto px-4 py-24 border-b border-white/5">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
                            <div class="flex flex-col gap-8">
                                <h2 class="text-white text-4xl font-black premium-heading uppercase leading-tight">
                                    Redefining the <br /><span class="text-primary">Standard</span> of Performance
                                </h2>
                                <div class="space-y-6">
                                    <p class="text-gray-400 text-lg leading-relaxed">
                                        At TechKart, we believe that technology should be an extension of the human
                                        spirit.
                                        Our mission is to provide high-performance computing solutions that empower
                                        visionaries, creators, and professionals to push beyond their limits.
                                    </p>
                                    <p class="text-gray-400 text-lg leading-relaxed">
                                        Every component we select, every chassis we design, and every thermal solution
                                        we
                                        engineer is driven by one goal: to deliver the ultimate computing experience
                                        without
                                        compromise.
                                    </p>
                                </div>
                                <div class="flex items-center gap-12 pt-4">
                                    <div>
                                        <p class="text-white text-3xl font-black">10+</p>
                                        <p class="text-primary text-[10px] font-bold uppercase tracking-widest">Years
                                            Innovation</p>
                                    </div>
                                    <div class="w-px h-10 bg-white/10"></div>
                                    <div>
                                        <p class="text-white text-3xl font-black">50k+</p>
                                        <p class="text-primary text-[10px] font-bold uppercase tracking-widest">
                                            Professionals</p>
                                    </div>
                                </div>
                            </div>
                            <div class="relative">
                                <div class="aspect-square rounded-2xl overflow-hidden glass-card p-2">
                                    <div class="w-full h-full rounded-xl bg-center bg-cover opacity-80"
                                        style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuC6dimibt_t4FisiP5Li4TwUc_V7o7qcrtwkIQWa8aaIRmbTqrbeTkv43wL7sY4IT63Ivfcty31ooifdC7zAQjTdUbpYK-hmvkWMCDExuqIxqNPtK22LW64rGicjKkBVepPHCWtBGZkDhUlHpvNB_oAXciUA-rRWSjf3jGwx5zgXnzuDZ3s5faZFQB3tyZpJQaaDUC_MASzmQZKwBAClE_LdUOwYnKT8me7Ok7Cw1YMybK6sI0FudHDHav83nRj76qnczC7HE1DchTC");'>
                                    </div>
                                </div>
                                <div
                                    class="absolute -top-10 -right-10 size-40 bg-primary/20 blur-[80px] -z-10 rounded-full">
                                </div>
                            </div>
                        </div>
                    </section>
                    <section class="max-w-[1200px] mx-auto px-4 py-24">
                        <div class="text-center mb-16">
                            <h2 class="text-white text-4xl font-black premium-heading uppercase">Core Pillars</h2>
                            <div class="h-1 w-20 bg-primary mx-auto mt-4 rounded-full"></div>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                            <div class="glass-card p-10 rounded-2xl flex flex-col gap-6 text-center group">
                                <div
                                    class="size-20 bg-primary/10 text-primary flex items-center justify-center rounded-2xl mx-auto group-hover:bg-primary group-hover:text-white transition-all duration-500">
                                    <span class="material-symbols-outlined text-4xl">speed</span>
                                </div>
                                <h3 class="text-white text-2xl font-black premium-heading uppercase">Performance</h3>
                                <p class="text-gray-400 leading-relaxed text-sm">
                                    Raw, unadulterated power designed to handle the most demanding creative and
                                    technical
                                    workflows with effortless grace.
                                </p>
                            </div>
                            <div class="glass-card p-10 rounded-2xl flex flex-col gap-6 text-center group">
                                <div
                                    class="size-20 bg-primary/10 text-primary flex items-center justify-center rounded-2xl mx-auto group-hover:bg-primary group-hover:text-white transition-all duration-500">
                                    <span class="material-symbols-outlined text-4xl">architecture</span>
                                </div>
                                <h3 class="text-white text-2xl font-black premium-heading uppercase">Minimalism</h3>
                                <p class="text-gray-400 leading-relaxed text-sm">
                                    Form follows function. Our aesthetic is defined by clean lines, premium materials,
                                    and a
                                    clutter-free user experience.
                                </p>
                            </div>
                            <div class="glass-card p-10 rounded-2xl flex flex-col gap-6 text-center group">
                                <div
                                    class="size-20 bg-primary/10 text-primary flex items-center justify-center rounded-2xl mx-auto group-hover:bg-primary group-hover:text-white transition-all duration-500">
                                    <span class="material-symbols-outlined text-4xl">tips_and_updates</span>
                                </div>
                                <h3 class="text-white text-2xl font-black premium-heading uppercase">Innovation</h3>
                                <p class="text-gray-400 leading-relaxed text-sm">
                                    Constantly challenging the status quo to integrate the latest technological
                                    breakthroughs into every machine we build.
                                </p>
                            </div>
                        </div>
                    </section>
                </main>
                <%- include('../../partials/user/footer') %>
        </div>
    </div>

</body>

</html>