<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MH SPARE HUB | Power for Every Passion</title>
    <meta name="description" content="Shop the best spare parts and electronics at MH SPARE HUB. TWS batteries, gaming console parts, iPhone calibration batteries and more.">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/views/user/home/dashboard.css">
</head>

<body>
    <!-- Theme init: runs before paint to avoid flash -->
    <script>
        (function() {
            try {
                const theme = localStorage.getItem('theme');
                if (theme === 'light') {
                    document.documentElement.classList.remove('dark');
                } else {
                    document.documentElement.classList.add('dark');
                }
            } catch(e) {}
        })();
    </script>

    <!-- ===================== HEADER ===================== -->
    <header>
        <div class="logo-container">
            <img src="https://raw.githubusercontent.com/muhammedhaseeb9645/MH-SPARE-HUB/refs/heads/main/logo/Logo%20big%20.png" alt="MH SPARE HUB" class="brand-logo">
        </div>
        
        <div class="header-search">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input type="text" id="searchInput" placeholder="Search for spare parts, batteries, screens..." oninput="applyFilters()">
        </div>

        <a href="/user/profile" class="header-profile" title="Profile">
            <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
        </a>

        <div class="bottom-dock-bar">
            <a href="/" class="nav-icon active" title="Home">
                <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
            </a>
            <a href="/user/shop" class="nav-icon" title="Shop">
                <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
            </a>
            <a href="/user/wishlist" class="nav-icon" title="Wishlist">
                <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
            </a>
            <a href="/user/cart" class="nav-icon" title="Cart" style="position: relative;">
                <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
                <span id="headerTotal" style="position: absolute; top: -2px; right: -2px; background: #e74c3c; color: white; font-size: 10px; font-weight: bold; border-radius: 50%; min-width: 16px; height: 16px; display: none; align-items: center; justify-content: center;">0</span>
            </a>
            <!-- Theme Toggle -->
            <button class="theme-toggle-btn" id="themeToggle" title="Toggle dark/light mode" onclick="toggleTheme()">
                <span class="icon-sun"><svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg></span>
                <span class="icon-moon"><svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg></span>
            </button>
        </div>
    </header>

    <!-- ===================== DEAL OF THE DAY ===================== -->
    <section class="deals-carousel-section">
        <div class="deals-carousel">
            <!-- Card 1 -->
            <div class="deal-card">
                <div class="deal-badge">🔥 Flash Deal</div>
                <div class="deal-content">
                    <div class="deal-image">
                        <img src="https://raw.githubusercontent.com/muhammedhaseeb9645/MH-SPARE-HUB/refs/heads/main/Photo/400808.png" alt="TWS Battery">
                    </div>
                    <div class="deal-info">
                        <h2 class="deal-title">OEM Premium TWS Battery</h2>
                        <div class="deal-prices">
                            <span class="old-price">₹120</span>
                            <span class="new-price">₹40</span>
                        </div>
                        <div class="deal-timer">
                            <span class="timer-label">Ends in:</span>
                            <div class="time-blocks">
                                <span class="time-block deal-h">02</span><span class="colon">:</span>
                                <span class="time-block deal-m">45</span><span class="colon">:</span>
                                <span class="time-block deal-s">00</span>
                            </div>
                        </div>
                        <a href="/user/shop" class="btn-claim-deal">Claim Deal</a>
                    </div>
                </div>
            </div>
            <!-- Card 2 -->
            <div class="deal-card deal-2">
                <div class="deal-badge">⚡ Hot Sale</div>
                <div class="deal-content">
                    <div class="deal-image">
                        <img src="https://raw.githubusercontent.com/muhammedhaseeb9645/MH-SPARE-HUB/refs/heads/main/Photo/1054.png" alt="Round Battery">
                    </div>
                    <div class="deal-info">
                        <h2 class="deal-title">Ear Buds Round Battery OEM</h2>
                        <div class="deal-prices">
                            <span class="old-price">₹150</span>
                            <span class="new-price">₹45</span>
                        </div>
                        <div class="deal-timer">
                            <span class="timer-label">Ends in:</span>
                            <div class="time-blocks">
                                <span class="time-block deal-h">02</span><span class="colon">:</span>
                                <span class="time-block deal-m">45</span><span class="colon">:</span>
                                <span class="time-block deal-s">00</span>
                            </div>
                        </div>
                        <a href="/user/shop" class="btn-claim-deal">Claim Deal</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <script>
        (function() {
            let totalSeconds = 2 * 3600 + 45 * 60 + 0;
            const hs = document.querySelectorAll('.deal-h');
            const ms = document.querySelectorAll('.deal-m');
            const ss = document.querySelectorAll('.deal-s');
            
            if(hs.length > 0) {
                setInterval(() => {
                    if (totalSeconds <= 0) totalSeconds = 24 * 3600;
                    totalSeconds--;
                    const h = Math.floor(totalSeconds / 3600);
                    const m = Math.floor((totalSeconds % 3600) / 60);
                    const s = totalSeconds % 60;
                    
                    const hStr = String(h).padStart(2, '0');
                    const mStr = String(m).padStart(2, '0');
                    const sStr = String(s).padStart(2, '0');

                    hs.forEach(el => el.textContent = hStr);
                    ms.forEach(el => el.textContent = mStr);
                    ss.forEach(el => el.textContent = sStr);
                }, 1000);
            }
        })();
    </script>

    <!-- ===================== CATEGORY NAV ===================== -->
    <nav class="category-nav-wrapper">
        <button class="category-tab active" onclick="filterCategory('all', this)">📁 All Products</button>
        <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
            <% categories.forEach(cat => { %>
                <button class="category-tab" onclick="filterCategory('<%= cat._id %>', this)">📦 <%= cat.name %></button>
            <% }) %>
        <% } %>
    </nav>

    <!-- ===================== MAIN CONTENT ===================== -->
    <div class="page-container">
        <div class="main-content-stream">
            <!-- Search Hub -->
            <div class="search-control-hub" style="justify-content: center; padding: 12px;">
                <div class="filter-toggle-group" style="width: 100%; max-width: 400px; display: flex;">
                    <button class="filter-toggle-btn active" style="flex: 1;" onclick="toggleStock('all', this)">All Stock</button>
                    <button class="filter-toggle-btn" style="flex: 1;" onclick="toggleStock('in', this)">In Stock</button>
                    <button class="filter-toggle-btn" style="flex: 1;" onclick="toggleStock('out', this)">Out of Stock</button>
                </div>
            </div>

            <!-- Products Grid -->
            <main class="products-grid" id="productsGrid">
                <!-- Cards rendered by JS from EJS data injected below -->
            </main>
        </div>

        <!-- ===================== CART PANEL ===================== -->
        <aside class="cart-panel" id="cartPanel" onclick="handlePanelClick(event)">
            <div class="cart-toggle-header" style="cursor:pointer;" onclick="toggleMobileCart(event)">
                <div class="cart-title">Cart Items (<span id="cartCount">0</span>)</div>
                <div class="toggle-icon">▲</div>
            </div>

            <div class="cart-table-header">
                <div>Item Detail</div>
                <div class="col-price">Price</div>
                <div style="text-align:right;">Action</div>
            </div>

            <div class="cart-items-list" id="cartItems" onclick="event.stopPropagation();"></div>

            <a href="/user/cart" class="go-cart-btn" id="goCartBtn">
                &#128722; Go to Cart
            </a>
        </aside>
    </div>

    <!-- ===================== FOOTER ===================== -->
    <footer style="margin-top: 60px; padding: 50px 20px; background: var(--bg-surface); border-top: 1px solid var(--border); text-align: center; padding-bottom: 120px;">
        <div style="margin-bottom: 24px;">
            <img src="https://raw.githubusercontent.com/muhammedhaseeb9645/MH-SPARE-HUB/refs/heads/main/logo/Logo%20big%20.png" alt="MH SPARE HUB" style="height: 40px; margin: 0 auto; display: block; filter: grayscale(100%) opacity(0.6); transition: filter 0.3s;" onmouseover="this.style.filter='none'" onmouseout="this.style.filter='grayscale(100%) opacity(0.6)'">
        </div>
        <div style="display: flex; justify-content: center; gap: 30px; margin-bottom: 24px; flex-wrap: wrap;">
            <a href="/about" class="nav-link">About Us</a>
            <a href="/contact" class="nav-link">Contact Us</a>
            <a href="/privacy" class="nav-link">Privacy Policy</a>
            <a href="/terms" class="nav-link">Terms of Service</a>
        </div>
        <p style="color: var(--text-muted); font-size: 0.9rem;">&copy; 2026 MH Spare Hub. All rights reserved.</p>
    </footer>

    <script>
        // ---- Inject EJS products into JS ----
        const ejsProducts = <%- JSON.stringify(products.map(p => {
            const variant = p.variants.find(v => v.stock > 0) || p.variants[0];
            const img = (p.variants && p.variants.length > 0 && variant && variant.images && variant.images.length > 0)
                ? variant.images[0]
                : (p.images && p.images.length > 0 ? p.images[0] : '/img/placeholder.jpg');
            const inStock = p.variants.some(v => v.stock > 0);
            return {
                id: p._id.toString(),
                name: p.name,
                description: p.description || '',
                img: img,
                inStock: inStock,
                price: variant ? variant.price : 0,
                originalPrice: variant ? variant.originalPrice : null,
                variantId: variant ? variant._id.toString() : null,
                category: p.category_id ? p.category_id.toString() : 'all',
                popular: inStock
            };
        })) %>;

        let cart = {};
        let currentCategory = 'all';
        let currentStock = 'all';

        // ---- Filters ----
        function filterCategory(catId, btn) {
            currentCategory = catId;
            document.querySelectorAll('.category-tab').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            applyFilters();
        }

        function toggleStock(mode, btn) {
            currentStock = mode;
            document.querySelectorAll('.filter-toggle-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            applyFilters();
        }

        function escapeRegExp(s) { return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); }

        function highlightText(text, kw) {
            if (!kw) return text;
            const regex = new RegExp(`(${escapeRegExp(kw)})`, 'gi');
            return text.replace(regex, '<span class="search-match-highlight">$1</span>');
        }

        function applyFilters() {
            const grid = document.getElementById('productsGrid');
            const kw = document.getElementById('searchInput').value.trim();
            const kwLow = kw.toLowerCase();
            grid.innerHTML = '';

            let filtered = ejsProducts;

            if (currentCategory !== 'all') {
                filtered = filtered.filter(p => p.category === currentCategory);
            }

            if (currentStock === 'in') filtered = filtered.filter(p => p.inStock);
            else if (currentStock === 'out') filtered = filtered.filter(p => !p.inStock);

            if (kwLow) {
                filtered = filtered.filter(p =>
                    p.name.toLowerCase().includes(kwLow) ||
                    p.id.toLowerCase().includes(kwLow)
                );
            }

            if (filtered.length === 0) {
                grid.innerHTML = `<div style="grid-column:1/-1;text-align:center;color:#64748b;padding:48px;font-weight:600;">No products match your filters.</div>`;
                return;
            }

            filtered.forEach(p => {
                const qty = cart[p.id] ? cart[p.id].qty : 1;
                const displayName = highlightText(p.name, kw);
                const displayId = highlightText(p.id.slice(-6).toUpperCase(), kw);

                let actionHTML = '';
                if (p.inStock) {
                    actionHTML = `<button class="add-btn" onclick="addToCart('${p.id}')">Add to Cart</button>`;
                } else {
                    actionHTML = `
                        <button class="add-btn out-of-stock" disabled>Out of stock</button>
                        <button class="prebook-btn" onclick="preBook('${p.id}')">Pre-book Item</button>
                    `;
                }

                let priceHTML = `₹${p.price}`;
                if (p.originalPrice && p.originalPrice > p.price) {
                    priceHTML = `₹${p.price} <small style="color:#94a3b8;text-decoration:line-through;font-size:0.75rem;">₹${p.originalPrice}</small>`;
                }

                const card = document.createElement('div');
                card.className = 'product-card';
                card.id = `card-${p.id}`;
                card.innerHTML = `
                    <div class="image-container">
                        <div class="floating-top-row">
                            <div class="floating-meta">
                                ${p.popular ? '<span class="popular-badge">Popular</span>' : ''}
                                <span class="product-id">ID: ${displayId}</span>
                            </div>
                            <span class="stock-badge ${p.inStock ? 'status-ready' : 'status-out'}">
                                ${p.inStock ? 'Ready Stock' : 'Out of stock'}
                            </span>
                        </div>
                        <img src="${p.img}" alt="${p.name}" class="product-img" onerror="this.src='/img/placeholder.jpg'">
                    </div>
                    <div class="product-info">
                        <a href="/user/product/${p.id}" style="text-decoration:none;">
                            <h2 class="product-name">${displayName}</h2>
                        </a>
                        <p class="product-desc">${p.description || 'Premium OEM grade replacement component.'}</p>
                        <div class="tier-indicator" id="tier-${p.id}">Standard Retail Tier</div>
                        <div class="info-white-box-grid">
                            <div class="price-white-box">
                                <div class="box-label">Price</div>
                                <div class="current-unit-price" id="price-${p.id}">${priceHTML}</div>
                            </div>
                            <div class="qty-white-box">
                                <div class="box-label">Quantity</div>
                                <div class="qty-controls">
                                    <button class="qty-btn" onclick="stepQty('${p.id}', -1)">−</button>
                                    <input type="number" class="qty-input" id="qty-${p.id}" value="${qty}" min="1">
                                    <button class="qty-btn" onclick="stepQty('${p.id}', 1)">+</button>
                                </div>
                            </div>
                        </div>
                        <div class="action-layout-block">${actionHTML}</div>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        // ---- Qty Controls ----
        function stepQty(id, delta) {
            const input = document.getElementById('qty-' + id);
            let val = parseInt(input.value) || 1;
            val = Math.max(1, val + delta);
            input.value = val;
        }

        // ---- Cart ----
        function addToCart(id, isPrebook = false) {
            const p = ejsProducts.find(x => x.id === id);
            const qty = parseInt(document.getElementById('qty-' + id)?.value) || 1;
            cart[id] = { product: p, qty, isPrebook };

            // Also send to backend cart API
            fetch('/user/cart/add', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ productId: id, variantId: p.variantId, quantity: qty })
            }).catch(() => {});

            // Animate header
            const hdr = document.getElementById('headerTotal');
            hdr.classList.add('scale-up');
            setTimeout(() => hdr.classList.remove('scale-up'), 280);

            updateCartUI();
        }

        function preBook(id) { addToCart(id, true); }

        function removeFromCart(id, event) {
            if (event) event.stopPropagation();
            const row = event?.currentTarget?.closest('.cart-item');
            if (row) {
                row.style.animation = 'slideInRow 0.25s ease reverse forwards';
                setTimeout(() => { delete cart[id]; updateCartUI(); }, 200);
            } else {
                delete cart[id]; updateCartUI();
            }
        }

        function updateCartUI() {
            const cartItems = document.getElementById('cartItems');
            const cartCount = document.getElementById('cartCount');
            const hdr = document.getElementById('headerTotal');
            cartItems.innerHTML = '';
            let total = 0, count = 0;

            Object.keys(cart).forEach(id => {
                const item = cart[id];
                const rowTotal = item.product.price * item.qty;
                total += rowTotal;
                count += item.qty;

                const row = document.createElement('div');
                row.className = 'cart-item';
                row.innerHTML = `
                    <div class="cart-item-info">
                        <h4>${item.product.name}</h4>
                        <p>${item.qty} pcs × ₹${item.product.price}</p>
                        ${item.isPrebook ? '<span class="cart-item-status">📝 Pre-booked</span>' : ''}
                    </div>
                    <div class="cart-item-price">₹${rowTotal}</div>
                    <div class="cart-item-actions">
                        <button class="remove-item" onclick="removeFromCart('${id}', event)">✕</button>
                    </div>
                `;
                cartItems.appendChild(row);
            });

            if (Object.keys(cart).length === 0) {
                cartItems.innerHTML = '<div class="cart-empty-msg">Your cart is empty.<br>Add products to get started.</div>';
            }

            cartCount.textContent = count;
            if (hdr) {
                hdr.textContent = count;
                hdr.style.display = count > 0 ? 'flex' : 'none';
            }
        }

        // ---- Mobile Cart ----
        function toggleMobileCart(event) {
            if (event) event.stopPropagation();
            if (window.innerWidth <= 900) {
                document.getElementById('cartPanel').classList.toggle('open');
            }
        }

        function handlePanelClick(event) {
            if (window.innerWidth <= 900 && !document.getElementById('cartPanel').classList.contains('open')) {
                toggleMobileCart(event);
            }
        }

        // ---- WhatsApp ----
        function sendWhatsApp(event) {
            if (event) event.stopPropagation();
            const keys = Object.keys(cart);
            if (keys.length === 0) { alert('Please add items to your cart first!'); return; }
            let msg = '📦 *NEW ORDER*\n\n';
            let total = 0;
            keys.forEach((id, i) => {
                const item = cart[id];
                const sub = item.product.price * item.qty;
                total += sub;
                msg += `*${i+1}. ${item.product.name}*${item.isPrebook ? ' 📝 *[PRE-BOOKED]*' : ''}\n`;
                msg += `   Qty: ${item.qty} pcs\n`;
                msg += `   Price: ₹${item.product.price} → *Subtotal: ₹${sub}*\n\n`;
            });
            msg += `---\n💰 *Total: ₹${total}*`;
            window.open(`https://wa.me/?text=${encodeURIComponent(msg)}`, '_blank');
        }

        // ---- Theme Toggle ----
        function toggleTheme() {
            const html = document.documentElement;
            const isDark = html.classList.toggle('dark');
            try { localStorage.setItem('theme', isDark ? 'dark' : 'light'); } catch(e) {}
        }

        // ---- Init ----
        updateCartUI();
        applyFilters();
    </script>
</body>
</html>