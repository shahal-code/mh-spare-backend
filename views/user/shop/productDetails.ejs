<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= product.name %> | TechKart
    </title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
    <link rel="stylesheet" href="/css/views/user/shop/productDetails.css">
</head>

<body class="min-h-screen">
    <%- include('../../partials/user/header') %>

        <main class="container mx-auto px-6 py-10 mt-10 max-w-7xl">
            <!-- Breadcrumbs -->
            <nav
                class="flex items-center gap-2 text-[10px] font-bold uppercase tracking-[0.2em] text-slate-500 mb-8 overflow-x-auto whitespace-nowrap pb-2 scrollbar-none">
                <a href="/" class="hover:text-primary transition-colors">Home</a>
                <span class="material-symbols-outlined text-[12px]">chevron_right</span>
                <a href="/user/shop" class="hover:text-primary transition-colors">Shop</a>
                <span class="material-symbols-outlined text-[12px]">chevron_right</span>
                <a href="/user/shop?category=<%= product.category_id._id %>"
                    class="hover:text-primary transition-colors">
                    <%= product.category_id.name %>
                </a>
                <span class="material-symbols-outlined text-[12px]">chevron_right</span>
                <span class="text-white">
                    <%= product.name %>
                </span>
            </nav>

            <%
                // Compute defaultVariant: first in-stock variant, falls back to variants[0] if all out of stock
                const defaultVariant = (product.variants && product.variants.find(v => v.stock > 0)) || (product.variants && product.variants[0]);
            %>
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 xl:gap-24">
                <!-- Left: Gallery -->
                <div class="space-y-8">
                    <div class="img-zoom-container glass-card aspect-[16/10] rounded-[32px] overflow-hidden relative shadow-2xl"
                        id="mainImageContainer">
                        <% if(product.variants && product.variants.length> 0 && defaultVariant.images &&
                            defaultVariant.images.length > 0) { %>
                            <img id="mainImage" src="<%= defaultVariant.images[0] %>"
                                class="w-full h-full object-cover" />
                            <% } else if(product.images && product.images.length> 0) { %>
                                <img id="mainImage" src="<%= product.images[0] %>" class="w-full h-full object-cover" />
                                <% } %>
                    </div>
                    <div class="grid grid-cols-4 gap-4">
                        <% let displayImages=[]; if (product.variants && product.variants.length> 0 &&
                            defaultVariant.images) {
                            displayImages = defaultVariant.images;
                            } else {
                            displayImages = product.images || [];
                            }

                            displayImages.forEach((img, index) => {
                            %>
                            <div class="glass-card aspect-square rounded-2xl overflow-hidden cursor-pointer hover:border-primary transition-all duration-300 thumbnails border-2 <%= index === 0 ? 'border-primary' : 'border-transparent' %>"
                                onclick="changeImage('<%= img %>', this)">
                                <img src="<%= img %>" class="w-full h-full object-cover" />
                            </div>
                            <% }) %>
                    </div>
                </div>
                <!-- Right: Info -->
                <div class="space-y-8">
                    <div class="space-y-4">
                        <div class="flex items-center gap-4">
                            <span
                                class="px-3 py-1 bg-primary/10 text-primary text-[10px] font-black uppercase tracking-[0.2em] rounded-full border border-primary/20">
                                New Arrival
                            </span>
                            <div class="flex items-center gap-2">
                                <div class="flex text-amber-400">
                                    <span class="material-symbols-outlined text-sm FILL">star</span>
                                    <span class="material-symbols-outlined text-sm FILL">star</span>
                                    <span class="material-symbols-outlined text-sm FILL">star</span>
                                    <span class="material-symbols-outlined text-sm FILL">star</span>
                                    <span class="material-symbols-outlined text-sm FILL">star_half</span>
                                </div>
                                <span class="text-[11px] font-black text-white"><%= averageRating || '0.0' %></span>
                                <span class="text-[11px] font-bold text-slate-500 uppercase tracking-widest ml-1">(<%= totalRatings %>
                                    Reviews)</span>
                            </div>
                        </div>
                        <% if (typeof isUnavailable !=='undefined' && isUnavailable) { %>
                            <div
                                class="mb-6 p-4 bg-rose-500/10 border border-rose-500/20 rounded-2xl flex items-center gap-3">
                                <span class="material-symbols-outlined text-rose-500">block</span>
                                <div>
                                    <h3 class="text-rose-500 font-bold tracking-widest uppercase text-sm">Currently
                                        Unavailable</h3>
                                    <p class="text-rose-400/80 text-xs mt-1"><%= unavailableMessage || 'This product is currently unavailable.' %></p>
                                </div>
                            </div>
                            <% } %>
                                <h1
                                    class="text-6xl font-black premium-heading tracking-tighter leading-[1.1] text-white">
                                    <%= product.name %>
                                </h1>
                                <div class="flex items-center gap-6">
                                    <div class="flex items-baseline gap-4">
                                        <span id="displayPrice" class="text-5xl font-bold text-white tracking-tight">
                                            ₹<%= (product.variants && product.variants.length> 0) ?
                                                defaultVariant.price :
                                                '0' %>
                                        </span>
                                        <% if(product.variants && product.variants.length> 0 &&
                                            (defaultVariant.oldPrice || defaultVariant.originalPrice)) {
                                            %>
                                            <span id="displayOldPrice"
                                                class="text-2xl text-slate-600 line-through font-medium tracking-tight">
                                                ₹<%= defaultVariant.originalPrice || defaultVariant.oldPrice %>
                                            </span>
                                            <% } %>
                                    </div>
                                    <% if (product.offer) { %>
                                        <div id="discount-badge"
                                            class="flex flex-col items-start px-3 py-1.5 bg-emerald-500/10 text-emerald-500 text-[10px] font-black uppercase tracking-widest rounded-lg border border-emerald-500/20 leading-tight">
                                            <span class="text-emerald-400 font-black text-[11px]"><%= product.offer.name %></span>
                                            <span class="text-emerald-600 text-[9px] font-bold">
                                                <% if (product.offer.discountType === 'percentage') { %>
                                                    Save <%= product.offer.discountValue %>%<% if (product.offer.maxDiscountAmount) { %> (upto ₹<%= product.offer.maxDiscountAmount %>)<% } %>
                                                <% } else { %>
                                                    Flat ₹<%= product.offer.discountValue %> Off
                                                <% } %>
                                            </span>
                                        </div>
                                    <% } else { %>
                                        <div id="discount-badge" class="hidden"></div>
                                    <% } %>
                                </div>

                                <!-- Stock Info -->
                                <div class="flex items-center gap-2 py-2">
                                    <div id="stock-dot"
                                        class="w-2 h-2 rounded-full <%= (defaultVariant?.stock > 10) ? 'bg-emerald-500 shadow-[0_0_10px_rgba(16,185,129,0.5)]' : (defaultVariant?.stock > 0 ? 'bg-amber-500 shadow-[0_0_10px_rgba(245,158,11,0.5)]' : 'bg-rose-500 shadow-[0_0_10px_rgba(244,63,94,0.5)]') %> animate-pulse">
                                    </div>
                                    <span id="stock-status"
                                        class="text-[10px] font-bold uppercase tracking-[0.2em] <%= (defaultVariant?.stock > 10) ? 'text-emerald-500' : (defaultVariant?.stock > 0 ? 'text-amber-500' : 'text-rose-500') %>">
                                        <%= (defaultVariant?.stock> 10) ? 'In Stock' : (defaultVariant?.stock
                                            > 0 ?
                                            `Only ${defaultVariant.stock} Left` : 'Out of Stock') %>
                                    </span>
                                </div>
                                <div class="flex flex-wrap gap-2 pt-2">
                                    <span
                                        class="px-2.5 py-1 bg-white/5 border border-white/10 rounded-full text-[9px] font-bold text-slate-400 uppercase tracking-widest flex items-center gap-1.5">
                                        <span
                                            class="material-symbols-outlined text-[12px] text-[#3b82f6]">developer_board</span>
                                        <span id="badge-gpu-meta">
                                            <%= defaultVariant?.gpu || 'RTX 4090' %>
                                        </span>
                                    </span>
                                    <span
                                        class="px-2.5 py-1 bg-white/5 border border-white/10 rounded-full text-[9px] font-bold text-slate-400 uppercase tracking-widest flex items-center gap-1.5">
                                        <span class="material-symbols-outlined text-[12px] text-[#3b82f6]">memory</span>
                                        <span id="badge-ram-meta">
                                            <%= defaultVariant?.ram || '64GB DDR5' %>
                                        </span>
                                    </span>
                                    <span
                                        class="px-2.5 py-1 bg-white/5 border border-white/10 rounded-full text-[9px] font-bold text-slate-400 uppercase tracking-widest flex items-center gap-1.5">
                                        <span
                                            class="material-symbols-outlined text-[12px] text-[#3b82f6]">storage</span>
                                        <span id="badge-storage-meta">
                                            <%= defaultVariant?.storage || '2TB NVMe' %>
                                        </span>
                                    </span>
                                </div>
                    </div>


                    <p id="displayDesc" class="text-slate-400 leading-relaxed text-sm max-w-xl font-medium">
                        <%= product.description %>
                    </p>

                    <!-- Selectors Grid -->
                    <% if (!(typeof isUnavailable !== 'undefined' && isUnavailable)) { %>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-10 pt-4">

                        <% 
                            // Extract unique options from variants
                            const rams = [...new Set(product.variants.map(v => v.ram))].filter(Boolean);
                            const processors = [...new Set(product.variants.map(v => v.processor))].filter(Boolean);
                            const storages = [...new Set(product.variants.map(v => v.storage))].filter(Boolean);
                            const sizes = [...new Set(product.variants.map(v => v.size))].filter(Boolean);
                            const colors = [...new Set(product.variants.map(v => v.color))].filter(Boolean);
                        %>

                            <% if(rams.length> 0) { %>
                                <div class="space-y-3">
                                    <label class="text-[9px] font-bold uppercase tracking-[0.2em] text-slate-500">Select
                                        RAM</label>
                                    <div class="flex flex-wrap gap-2">
                                        <% rams.forEach(ram=> { %>
                                            <button onclick="updateSelection('ram', '<%= ram %>')"
                                                class="option-btn px-4 py-1.5 rounded-full border text-[10px] font-bold uppercase tracking-widest transition-all duration-300 <%= defaultVariant?.ram === ram ? 'border-[#3b82f6] bg-[#3b82f6]/10 text-white' : 'border-white/10 text-slate-500 hover:border-white/20' %>"
                                                data-type="ram" data-value="<%= ram %>">
                                                <%= ram %>
                                            </button>
                                            <% }) %>
                                    </div>
                                </div>
                                <% } %>


                                    <% if(storages.length> 0) { %>
                                        <div class="space-y-3">
                                            <label
                                                class="text-[9px] font-bold uppercase tracking-[0.2em] text-slate-500">Storage
                                                (NVMe SSD)</label>
                                            <div class="flex flex-wrap gap-2">
                                                <% storages.forEach(storage=> { %>
                                                    <button onclick="updateSelection('storage', '<%= storage %>')"
                                                        class="option-btn px-4 py-1.5 rounded-full border text-[10px] font-bold uppercase tracking-widest transition-all duration-300 <%= defaultVariant?.storage === storage ? 'border-[#3b82f6] bg-[#3b82f6]/10 text-white' : 'border-white/10 text-slate-500 hover:border-white/20' %>"
                                                        data-type="storage" data-value="<%= storage %>">
                                                        <%= storage %>
                                                    </button>
                                                    <% }) %>
                                            </div>
                                        </div>
                                        <% } %>

                                            <% if(sizes.length> 0) { %>
                                                <div class="space-y-3">
                                                    <label
                                                        class="text-[9px] font-bold uppercase tracking-[0.2em] text-slate-500">Screen
                                                        Size</label>
                                                    <div class="flex flex-wrap gap-2">
                                                        <% sizes.forEach(size=> { %>
                                                            <button onclick="updateSelection('size', '<%= size %>')"
                                                                class="option-btn px-4 py-1.5 rounded-full border text-[10px] font-bold uppercase tracking-widest transition-all duration-300 <%= defaultVariant?.size === size ? 'border-[#3b82f6] bg-[#3b82f6]/10 text-white' : 'border-white/10 text-slate-500 hover:border-white/20' %>"
                                                                data-type="size" data-value="<%= size %>">
                                                                <%= size %>
                                                            </button>
                                                            <% }) %>
                                                    </div>
                                                </div>
                                                <% } %>

                                                    <% if(colors.length> 0) { %>
                                                        <div class="space-y-3 col-span-1">
                                                            <label
                                                                class="text-[9px] font-bold uppercase tracking-[0.2em] text-slate-500">Select
                                                                Color</label>
                                                            <div class="flex flex-wrap gap-2">
                                                                <% colors.forEach(color=> { %>
                                                                    <button
                                                                        onclick="updateSelection('color', '<%= color %>')"
                                                                        class="option-btn px-4 py-1.5 rounded-full border text-[10px] font-bold uppercase tracking-widest transition-all duration-300 <%= defaultVariant?.color === color ? 'border-[#3b82f6] bg-[#3b82f6]/10 text-white' : 'border-white/10 text-slate-500 hover:border-white/20' %>"
                                                                        data-type="color" data-value="<%= color %>">
                                                                        <%= color %>
                                                                    </button>
                                                                    <% }) %>
                                                            </div>
                                                        </div>
                                                        <% } %>

                                                            <!-- Quantity -->
                                                            <div class="space-y-3 col-span-1 md:col-span-2">
                                                                <label
                                                                    class="text-[9px] font-bold uppercase tracking-[0.2em] text-slate-500">Quantity</label>
                                                                <div id="qty-selector-container"
                                                                    class="flex items-center gap-4 bg-white/5 w-fit rounded-full px-4 py-1.5 border border-white/10 shrink-0">
                                                                    <button onclick="updateQty(-1)"
                                                                        class="w-6 h-6 flex items-center justify-center text-slate-400 hover:text-white transition-colors bg-white/5 rounded-full">
                                                                        <span
                                                                            class="material-symbols-outlined text-[14px]">remove</span>
                                                                    </button>
                                                                    <span id="quantity"
                                                                        class="w-4 text-center font-bold text-xs text-white">1</span>
                                                                    <button onclick="updateQty(1)"
                                                                        class="w-6 h-6 flex items-center justify-center text-slate-400 hover:text-white transition-colors bg-white/5 rounded-full">
                                                                        <span
                                                                            class="material-symbols-outlined text-[14px]">add</span>
                                                                    </button>
                                                                </div>
                                                            </div>
                    </div>
                    <% } %>

                    <div class="space-y-4 pt-4 border-t border-white/5">
                        <% if (typeof isUnavailable !== 'undefined' && isUnavailable) { %>
                            <p class="text-sm text-slate-400 leading-relaxed">
                                This product has been blocked and cannot be purchased at the moment.
                            </p>
                            <a href="/user/shop"
                                class="w-full flex items-center justify-center gap-3 py-5 bg-white/10 text-white font-black uppercase tracking-[0.2em] rounded-2xl hover:bg-white/20 transition-all border border-white/5">
                                <span class="material-symbols-outlined">arrow_back</span>
                                Back to Shop
                            </a>
                        <% } else { %>
                            <% 
                                const firstVariant = defaultVariant;
                                const hasStock = firstVariant && firstVariant.stock > 0;
                                const isWishlisted = wishlistProductIds && wishlistProductIds.includes(product._id.toString());
                            %>

                            <button id="mainAddToCartBtn" 
                                onclick="handleAddToCart('<%= product._id %>', event)"
                                <%= hasStock ? '' : 'disabled' %>
                                class="w-full py-5 font-black uppercase tracking-[0.2em] rounded-2xl transition-all border border-white/5 
                                <%= hasStock ? 'bg-primary text-white hover:bg-blue-600 shadow-[0_0_30px_rgba(59,130,246,0.3)]' : 'bg-white/10 text-gray-500 cursor-not-allowed opacity-50' %>">
                                <%= hasStock ? 'Add to Cart' : 'Out of Stock' %>
                            </button>
                            
                            <!-- <button
                                onclick="handleBuyNow('<%= product._id %>', event)"
                                class="w-full py-5 border border-white/10 text-white font-black uppercase tracking-[0.2em] rounded-2xl hover:bg-white/5 transition-all <%= hasStock ? '' : 'hidden' %>">
                                Buy Now
                            </button> -->

                            <button
                                onclick="toggleWishlist(event, '<%= product._id %>', '<%= firstVariant ? (firstVariant._id.$oid || firstVariant._id) : '' %>')"
                                class="w-full py-5 border border-white/10 text-white font-black uppercase tracking-[0.2em] rounded-2xl hover:bg-white/5 transition-all flex items-center justify-center gap-3">
                                <span class="material-symbols-outlined"
                                    style="<%= isWishlisted ? 'font-variation-settings: \'FILL\' 1' : '' %>">favorite</span>
                                Add to Wishlist
                            </button>
                        <% } %>

                                                <div class="flex items-center justify-between px-2 pt-4">
                                                    <div
                                                        class="flex items-center gap-2 text-[10px] font-bold text-slate-500 uppercase tracking-widest">
                                                        <span
                                                            class="material-symbols-outlined text-primary text-sm FILL">verified</span>
                                                        Free Shipping
                                                    </div>
                                                    <div
                                                        class="flex items-center gap-2 text-[10px] font-bold text-slate-500 uppercase tracking-widest">
                                                        <span
                                                            class="material-symbols-outlined text-primary text-sm">shield</span>
                                                        2-Year Warranty
                                                    </div>
                                                </div>
                    </div>
                </div>
            </div>

            <!-- Rich Specifications Section -->
            <div class="mt-32 space-y-12">
                <div class="flex items-center gap-6">
                    <div class="h-px bg-[#3b82f6] w-12 text-white"></div>
                    <h2 class="text-3xl font-black uppercase tracking-tight text-white">Specifications</h2>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                    <!-- Processor -->
                    <div
                        class="glass-card p-8 rounded-[32px] space-y-6 group hover:border-[#3b82f6]/30 transition-all duration-500 border border-white/5">
                        <div class="w-14 h-14 rounded-full bg-[#3b82f6]/10 flex items-center justify-center">
                            <span class="material-symbols-outlined text-[#3b82f6] text-2xl FILL">memory</span>
                        </div>
                        <div class="space-y-2">
                            <h4 class="text-[10px] font-bold text-slate-500 uppercase tracking-widest">Processor</h4>
                            <p id="spec-processor" class="font-bold text-lg text-white leading-tight">
                                <%= defaultVariant?.processorBrand ? defaultVariant.processorBrand + ' ' : ''
                                    %>
                                    <%= defaultVariant?.processor || 'High-Performance' %>
                            </p>
                            <p class="text-xs text-slate-500 font-medium leading-relaxed">Next-gen
                                architecture<br>Optimal Thermals</p>
                        </div>
                    </div>

                    <!-- GPU -->
                    <div
                        class="glass-card p-8 rounded-[32px] space-y-6 group hover:border-[#3b82f6]/30 transition-all duration-500 border border-white/5">
                        <div class="w-14 h-14 rounded-full bg-[#3b82f6]/10 flex items-center justify-center">
                            <span class="material-symbols-outlined text-[#3b82f6] text-2xl FILL">developer_board</span>
                        </div>
                        <div class="space-y-2">
                            <h4 class="text-[10px] font-bold text-slate-500 uppercase tracking-widest">Graphics</h4>
                            <p id="spec-gpu" class="font-bold text-lg text-white leading-tight">
                                <%= defaultVariant?.gpu || 'Integrated' %>
                            </p>
                            <p class="text-xs text-slate-500 font-medium leading-relaxed">Advanced Rendering<br>175W Max
                                TGP</p>
                        </div>
                    </div>

                    <!-- Display -->
                    <div
                        class="glass-card p-8 rounded-[32px] space-y-6 group hover:border-[#3b82f6]/30 transition-all duration-500 border border-white/5">
                        <div class="w-14 h-14 rounded-full bg-[#3b82f6]/10 flex items-center justify-center">
                            <span class="material-symbols-outlined text-[#3b82f6] text-2xl FILL">laptop_mac</span>
                        </div>
                        <div class="space-y-2">
                            <h4 class="text-[10px] font-bold text-slate-500 uppercase tracking-widest">Display</h4>
                            <p class="font-bold text-lg text-white leading-tight">
                                <%= product.specifications?.display || '16" 4K Mini-LED' %>
                            </p>
                            <p class="text-xs text-slate-500 font-medium leading-relaxed">100% DCI-P3 Color<br>240Hz
                                Refresh Rate</p>
                        </div>
                    </div>

                    <!-- Battery -->
                    <div
                        class="glass-card p-8 rounded-[32px] space-y-6 group hover:border-[#3b82f6]/30 transition-all duration-500 border border-white/5">
                        <div class="w-14 h-14 rounded-full bg-[#3b82f6]/10 flex items-center justify-center">
                            <span
                                class="material-symbols-outlined text-[#3b82f6] text-2xl FILL">battery_charging_full</span>
                        </div>
                        <div class="space-y-2">
                            <h4 class="text-[10px] font-bold text-slate-500 uppercase tracking-widest">Battery Life</h4>
                            <p class="font-bold text-lg text-white leading-tight">
                                <%= product.specifications?.battery || '99.9Wh Density' %>
                            </p>
                            <p class="text-xs text-slate-500 font-medium leading-relaxed">Up to 12 Hours Use<br>330W GaN
                                Fast Charger</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Product Highlights -->
            <% if (product.highlights && product.highlights.length> 0) { %>
                <div class="mt-20 space-y-8">
                    <div class="flex items-center gap-6">
                        <div class="h-px bg-[#3b82f6] w-12 text-white"></div>
                        <h2 class="text-3xl font-black uppercase tracking-tight text-white">Product Highlights</h2>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <% product.highlights.forEach(highlight=> { %>
                            <div class="flex items-start gap-4 p-5 glass-card rounded-2xl border border-white/5">
                                <span class="material-symbols-outlined text-primary text-xl">check_circle</span>
                                <p class="text-sm font-medium text-slate-300">
                                    <%= highlight %>
                                </p>
                            </div>
                            <% }) %>
                    </div>
                </div>
                <% } %>

                    <!-- Customer Reviews Section -->
                    <div class="mt-32 space-y-12 pb-20">
                        <div class="flex flex-col md:flex-row md:items-end justify-between gap-8">
                            <div class="space-y-6">
                                <div class="flex items-center gap-6">
                                    <div class="h-px bg-[#3b82f6] w-12 text-white"></div>
                                    <h2 class="text-3xl font-black uppercase tracking-tight text-white">Customer Reviews
                                    </h2>
                                </div>
                                <div class="flex items-center gap-8">
                                    <div class="flex items-baseline gap-2">
                                        <span class="text-6xl font-black text-white"><%= parseFloat(averageRating) > 0 ? parseFloat(averageRating).toFixed(1) : '0.0' %></span>
                                        <span class="text-2xl font-bold text-slate-500">/5</span>
                                    </div>
                                    <div class="space-y-1">
                                        <div class="flex text-amber-400">
                                            <% for(let i=1; i<=5; i++) { %>
                                                <span class="material-symbols-outlined text-sm <%= Math.round(parseFloat(averageRating)) >= i ? 'FILL' : '' %>">star</span>
                                            <% } %>
                                        </div>
                                        <p class="text-[10px] font-bold text-slate-500 uppercase tracking-widest">Based
                                            on <%= totalRatings %>
                                            global ratings</p>
                                    </div>
                                </div>
                            </div>

                            <% if(user) { %>
                            <button onclick="openReviewModal()"
                                class="px-8 py-4 bg-white/5 border border-white/10 rounded-2xl text-[11px] font-black uppercase tracking-[0.2em] text-white hover:bg-white/10 transition-all">
                                Write a Review
                            </button>
                            <% } else { %>
                            <a href="/user/login"
                                class="px-8 py-4 bg-white/5 border border-white/10 rounded-2xl text-[11px] font-black uppercase tracking-[0.2em] text-white hover:bg-white/10 transition-all text-center">
                                Login to Review
                            </a>
                            <% } %>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                            <% if (reviews && reviews.length > 0) { %>
                                <% reviews.forEach(review => { %>
                                    <div class="glass-card p-6 rounded-[24px] border border-white/5 flex flex-col gap-4">
                                        <!-- Top row: avatar + info on left, badges on right -->
                                        <div class="flex items-center justify-between gap-2">
                                            <!-- Avatar + name + stars -->
                                            <div class="flex items-center gap-3 min-w-0">
                                                <div class="w-9 h-9 rounded-full bg-primary/20 flex items-center justify-center text-primary text-sm font-bold uppercase overflow-hidden shrink-0">
                                                    <% if (review.user && review.user.profileImage) { %>
                                                        <img src="<%= review.user.profileImage %>" alt="<%= review.user.fullname %>" class="w-full h-full object-cover" />
                                                    <% } else if (review.user && review.user.fullname) { %>
                                                        <%= review.user.fullname.charAt(0) %>
                                                    <% } else { %>
                                                        U
                                                    <% } %>
                                                </div>
                                                <div class="min-w-0">
                                                    <h4 class="text-sm font-bold text-white truncate"><%= review.user && review.user.fullname ? review.user.fullname : 'User' %></h4>
                                                    <div class="flex text-amber-400 mt-0.5">
                                                        <% for(let i=1; i<=5; i++) { %>
                                                            <span class="material-symbols-outlined text-[12px] <%= review.rating >= i ? 'FILL' : '' %>">star</span>
                                                        <% } %>
                                                    </div>
                                                </div>
                                            </div>
                                            <!-- Verified + Delete -->
                                            <div class="flex items-center gap-2 shrink-0">
                                                <span class="text-emerald-500 flex items-center" title="Verified Purchase">
                                                    <span class="material-symbols-outlined text-[16px] FILL">verified</span>
                                                </span>
                                                <% if (user && String(user) === String(review.user._id)) { %>
                                                    <button onclick="deleteReview('<%= review._id %>')" class="text-rose-500 hover:bg-rose-500/10 p-1 rounded-full transition-all flex items-center justify-center" title="Delete Review">
                                                        <span class="material-symbols-outlined text-[16px]">delete</span>
                                                    </button>
                                                <% } %>
                                            </div>
                                        </div>
                                        <!-- Comment -->
                                        <p class="text-sm text-slate-400 leading-relaxed font-medium italic">
                                            "<%= review.comment %>"
                                        </p>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <p class="text-slate-500 italic">No reviews yet. Be the first to review this product!</p>
                            <% } %>
                        </div>
                    </div>
                    <!-- Related Products -->
                    <% if (typeof relatedProducts !=='undefined' && relatedProducts && relatedProducts.length> 0) { %>
                        <div class="mt-32 space-y-12 pb-20">
                            <div class="flex items-center gap-6">
                                <div class="h-px bg-[#3b82f6] w-12 text-white"></div>
                                <h2 class="text-3xl font-black uppercase tracking-tight text-white">Related Products
                                </h2>
                            </div>
                            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-8">
                                <% relatedProducts.forEach(rel=> { %>
                                    <div
                                        class="glass-card group rounded-2xl overflow-hidden transition-all duration-500 hover:-translate-y-2 border border-white/5">
                                        <div class="aspect-[4/3] bg-white/[0.03] relative overflow-hidden block">
                                            <% const isRelSoldOut=rel.variants.every(v=> v.stock <= 0); %>
                                                    <a href="/user/product/<%= rel._id %>" class="w-full h-full block">
                                                        <img src="<%= (rel.variants && rel.variants.length > 0 && rel.variants[0].images) ? rel.variants[0].images[0] : (rel.images ? rel.images[0] : '/img/placeholder.jpg') %>"
                                                            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110 opacity-90 <%= isRelSoldOut ? 'grayscale opacity-50' : '' %>" />
                                                    </a>
                                                    <% if (isRelSoldOut) { %>
                                                        <div
                                                            class="absolute inset-0 flex items-center justify-center bg-black/40 backdrop-blur-[2px]">
                                                            <span
                                                                class="px-6 py-2 bg-rose-500 text-white text-[10px] font-black uppercase tracking-[0.3em] rounded-full shadow-lg">Sold
                                                                Out</span>
                                                        </div>
                                                        <% } %>
                                                            <button
                                                                onclick="toggleWishlist(event, '<%= rel._id %>', '<%= rel.variants[0]?._id %>')"
                                                                class="absolute top-4 right-4 z-10 size-10 rounded-full bg-black/40 backdrop-blur-md flex items-center justify-center text-white hover:bg-primary transition-all duration-300">
                                                                <span class="material-symbols-outlined text-xl"
                                                                    style="<%= (wishlistProductIds && wishlistProductIds.includes(rel._id.toString())) ? 'font-variation-settings: \'FILL\' 1' : '' %>">favorite</span>
                                                            </button>
                                        </div>
                                        <div class="p-8">
                                            <div class="flex justify-between items-start mb-3">
                                                <a href="/user/product/<%= rel._id %>">
                                                    <h3
                                                        class="text-white text-2xl font-black premium-heading uppercase hover:text-primary transition-colors truncate max-w-[150px]">
                                                        <%= rel.name %>
                                                    </h3>
                                                </a>
                                                <div class="flex items-center gap-2">
                                                    <% if (rel.variants[0]?.originalPrice && rel.variants[0]?.originalPrice > rel.variants[0]?.price) { %>
                                                        <span class="text-gray-500 line-through text-sm">₹<%= rel.variants[0]?.originalPrice %></span>
                                                    <% } %>
                                                    <span class="text-primary font-bold text-2xl">₹<%= rel.variants[0]?.price || '0' %></span>
                                                </div>
                                            </div>
                                            <p class="text-gray-400 text-sm mb-8 leading-relaxed line-clamp-2">
                                                <%= rel.description %>
                                            </p>
                                            <% if (!isRelSoldOut) { %>
                                                <button
                                                    onclick="addToCart('<%= rel._id %>', '<%= rel.variants.find(v => v.stock > 0)?._id || rel.variants[0]?._id %>', 1, event)"
                                                    class="w-full flex items-center justify-center gap-3 bg-white text-black font-black text-xs uppercase tracking-widest py-4 rounded-full hover:bg-primary hover:text-white transition-all duration-300">
                                                    <span
                                                        class="material-symbols-outlined text-lg">add_shopping_cart</span>
                                                    Add to Cart
                                                </button>
                                                <% } else { %>
                                                    <button disabled
                                                        class="w-full flex items-center justify-center gap-3 bg-white/10 text-gray-500 font-black text-xs uppercase tracking-widest py-4 rounded-full cursor-not-allowed">
                                                        <span class="material-symbols-outlined text-lg">block</span>
                                                        Out of Stock
                                                    </button>
                                                    <% } %>
                                        </div>
                                    </div>
                                    <% }) %>
                            </div>
                        </div>
                        <% } %>
        </main>

        <%- include('../../partials/user/footer') %>

            <script id="product-variants-json" type="application/json">
                <%- JSON.stringify(product.variants || []) %>
            </script>
            <script id="cart-items-json" type="application/json">
                <%- JSON.stringify(cart && cart.items ? cart.items : []) %>
            </script>
            <script id="product-offer-json" type="application/json">
                <%- JSON.stringify(product.offer || null) %>
            </script>
            <script src="/js/user/shop/productDetails.js"></script>
</body>

</html>
