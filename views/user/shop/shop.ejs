<!DOCTYPE html>
<html class="dark" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>TechKart | Advanced Luxury Catalog</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#0055FF",
                        "dark-bg": "#0D0D0D",
                        "glass-border": "rgba(255, 255, 255, 0.1)",
                    },
                    fontFamily: {
                        "display": ["Inter", "sans-serif"]
                    },
                    borderRadius: {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "2xl": "1.25rem",
                        "full": "9999px"
                    },
                },
            },
        }
    </script>
    <link rel="stylesheet" href="/css/views/user/shop/shop.css">
</head>

<body class="dark">
    <div class="relative flex h-auto min-h-screen w-full flex-col overflow-x-hidden">
        <div class="layout-container flex h-full grow flex-col">
            <%- include('../../partials/user/header') %>
                <main class="flex-1">
                    <div class="bg-gradient-to-b from-primary/5 to-transparent border-b border-white/5">
                        <div class="max-w-[1400px] mx-auto px-4 py-12 md:py-20">
                            <div class="flex flex-col gap-4">
                                <h1
                                    class="text-white text-4xl md:text-5xl font-black premium-heading uppercase tracking-tighter">
                                    TechKart Shop
                                </h1>
                                <p class="text-gray-400 text-lg max-w-xl font-medium leading-relaxed">
                                    Advanced technical selection for the next generation of computing.
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="max-w-[1400px] mx-auto px-4 py-12">
                        <div class="flex flex-col lg:flex-row gap-12">
                            <!-- Mobile Filter Overlay -->
                            <div id="shopFilterOverlay" onclick="toggleShopFilters()" class="fixed inset-0 bg-black/80 z-[75] hidden lg:hidden backdrop-blur-sm transition-opacity"></div>

                            <!-- Sidebar -->
                            <aside id="shopFilterSidebar" class="fixed inset-y-0 left-0 z-[80] w-72 transform -translate-x-full lg:translate-x-0 lg:static lg:w-72 flex-shrink-0 bg-[#0D0D0D] lg:bg-transparent overflow-y-auto lg:overflow-visible transition-transform duration-300 p-6 lg:p-0 border-r border-white/10 lg:border-none">
                                <div class="flex items-center justify-between mb-6 lg:hidden">
                                    <h3 class="text-white text-lg font-black uppercase premium-heading">Filters</h3>
                                    <button type="button" onclick="toggleShopFilters()" class="text-gray-400 hover:text-white">
                                        <span class="material-symbols-outlined">close</span>
                                    </button>
                                </div>
                                <div class="sticky top-24 space-y-6">
                                    <div class="filter-section">
                                        <h3
                                            class="text-white text-[10px] font-black uppercase tracking-[0.25em] mb-6 flex items-center justify-between">
                                            Categories
                                            <span class="w-8 h-px bg-primary/40"></span>
                                        </h3>
                                        <div class="space-y-4">
                                            <% categories.forEach(cat=> { %>
                                                <label class="flex items-center gap-3 group cursor-pointer">
                                                    <input class="size-4" type="checkbox" name="category"
                                                        value="<%= cat._id %>" <%=(Array.isArray(query.category) ?
                                                        query.category.includes(cat._id.toString()) :
                                                        query.category===cat._id.toString()) ? 'checked' : '' %> />
                                                    <span
                                                        class="text-sm font-medium text-gray-400 group-hover:text-white transition-colors">
                                                        <%= cat.name %>
                                                    </span>
                                                </label>
                                                <% }) %>
                                        </div>
                                    </div>

                                    <div class="filter-section">
                                        <h3
                                            class="text-white text-[10px] font-black uppercase tracking-[0.25em] mb-6 flex items-center justify-between">
                                            Processor
                                            <span class="w-8 h-px bg-primary/40"></span>
                                        </h3>
                                        <div class="space-y-4">
                                            <!-- Intel Group -->
                                            <div class="space-y-3">
                                                <div class="flex items-center justify-between group cursor-pointer"
                                                    onclick="toggleProcessorGroup('intel-sub')">
                                                    <div class="flex items-center gap-3">
                                                        <div
                                                            class="size-2 rounded-full bg-primary/40 group-hover:bg-primary transition-colors">
                                                        </div>
                                                        <span
                                                            class="text-sm font-bold text-gray-300 group-hover:text-white uppercase tracking-wider">Intel
                                                            Core</span>
                                                    </div>
                                                    <span id="intel-sub-icon"
                                                        class="material-symbols-outlined text-gray-500 group-hover:text-white transition-transform duration-300">keyboard_arrow_down</span>
                                                </div>
                                                <div id="intel-sub"
                                                    class="ml-5 space-y-3 hidden border-l border-white/5 pl-4 py-1">
                                                    <label class="flex items-center gap-3 group cursor-pointer">
                                                        <input class="size-3.5" type="checkbox" name="processor"
                                                            value="i3" <%=(Array.isArray(query.processor) ?
                                                            query.processor.includes('i3') : query.processor==='i3' )
                                                            ? 'checked' : '' %> />
                                                        <span
                                                            class="text-xs font-medium text-gray-400 group-hover:text-white transition-colors">Core
                                                            i3</span>
                                                    </label>
                                                    <label class="flex items-center gap-3 group cursor-pointer">
                                                        <input class="size-3.5" type="checkbox" name="processor"
                                                            value="i5" <%=(Array.isArray(query.processor) ?
                                                            query.processor.includes('i5') : query.processor==='i5' )
                                                            ? 'checked' : '' %> />
                                                        <span
                                                            class="text-xs font-medium text-gray-400 group-hover:text-white transition-colors">Core
                                                            i5</span>
                                                    </label>
                                                    <label class="flex items-center gap-3 group cursor-pointer">
                                                        <input class="size-3.5" type="checkbox" name="processor"
                                                            value="i7" <%=(Array.isArray(query.processor) ?
                                                            query.processor.includes('i7') : query.processor==='i7' )
                                                            ? 'checked' : '' %> />
                                                        <span
                                                            class="text-xs font-medium text-gray-400 group-hover:text-white transition-colors">Core
                                                            i7</span>
                                                    </label>
                                                    <label class="flex items-center gap-3 group cursor-pointer">
                                                        <input class="size-3.5" type="checkbox" name="processor"
                                                            value="i9" <%=(Array.isArray(query.processor) ?
                                                            query.processor.includes('i9') : query.processor==='i9' )
                                                            ? 'checked' : '' %> />
                                                        <span
                                                            class="text-xs font-medium text-gray-400 group-hover:text-white transition-colors">Core
                                                            i9</span>
                                                    </label>
                                                </div>
                                            </div>

                                            <!-- AMD Group -->
                                            <div class="space-y-3">
                                                <div class="flex items-center justify-between group cursor-pointer"
                                                    onclick="toggleProcessorGroup('amd-sub')">
                                                    <div class="flex items-center gap-3">
                                                        <div
                                                            class="size-2 rounded-full bg-primary/40 group-hover:bg-primary transition-colors">
                                                        </div>
                                                        <span
                                                            class="text-sm font-bold text-gray-300 group-hover:text-white uppercase tracking-wider">AMD
                                                            Ryzen</span>
                                                    </div>
                                                    <span id="amd-sub-icon"
                                                        class="material-symbols-outlined text-gray-500 group-hover:text-white transition-transform duration-300">keyboard_arrow_down</span>
                                                </div>
                                                <div id="amd-sub"
                                                    class="ml-5 space-y-3 hidden border-l border-white/5 pl-4 py-1">
                                                    <label class="flex items-center gap-3 group cursor-pointer">
                                                        <input class="size-3.5" type="checkbox" name="processor"
                                                            value="Ryzen 5" <%=(Array.isArray(query.processor) ?
                                                            query.processor.includes('Ryzen 5') :
                                                            query.processor==='Ryzen 5' ) ? 'checked' : '' %> />
                                                        <span
                                                            class="text-xs font-medium text-gray-400 group-hover:text-white transition-colors">Ryzen
                                                            5</span>
                                                    </label>
                                                    <label class="flex items-center gap-3 group cursor-pointer">
                                                        <input class="size-3.5" type="checkbox" name="processor"
                                                            value="Ryzen 7" <%=(Array.isArray(query.processor) ?
                                                            query.processor.includes('Ryzen 7') :
                                                            query.processor==='Ryzen 7' ) ? 'checked' : '' %> />
                                                        <span
                                                            class="text-xs font-medium text-gray-400 group-hover:text-white transition-colors">Ryzen
                                                            7</span>
                                                    </label>
                                                    <label class="flex items-center gap-3 group cursor-pointer">
                                                        <input class="size-3.5" type="checkbox" name="processor"
                                                            value="Ryzen 9" <%=(Array.isArray(query.processor) ?
                                                            query.processor.includes('Ryzen 9') :
                                                            query.processor==='Ryzen 9' ) ? 'checked' : '' %> />
                                                        <span
                                                            class="text-xs font-medium text-gray-400 group-hover:text-white transition-colors">Ryzen
                                                            9</span>
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>


                                    <!-- RAM Filter -->
                                    <div class="filter-section">
                                        <h3
                                            class="text-white text-[10px] font-black uppercase tracking-[0.25em] mb-6 flex items-center justify-between">
                                            Memory (RAM)
                                            <span class="w-8 h-px bg-primary/40"></span>
                                        </h3>
                                        <div class="space-y-3">
                                            <div class="flex items-center justify-between group cursor-pointer"
                                                onclick="toggleProcessorGroup('ram-sub')">
                                                <div class="flex items-center gap-3">
                                                    <div
                                                        class="size-2 rounded-full bg-primary/40 group-hover:bg-primary transition-colors">
                                                    </div>
                                                    <span
                                                        class="text-sm font-bold text-gray-300 group-hover:text-white uppercase tracking-wider">Capacity</span>
                                                </div>
                                                <span id="ram-sub-icon"
                                                    class="material-symbols-outlined text-gray-500 group-hover:text-white transition-transform duration-300">keyboard_arrow_down</span>
                                            </div>
                                            <div id="ram-sub"
                                                class="ml-5 space-y-3 hidden border-l border-white/5 pl-4 py-1">
                                                <% ['64GB', '32GB' , '16GB' , '8GB' ].forEach(ram=> { %>
                                                    <label class="flex items-center gap-3 group cursor-pointer">
                                                        <input class="size-3.5" type="checkbox" name="ram"
                                                            value="<%= ram %>" <%=(Array.isArray(query.ram) ?
                                                            query.ram.includes(ram) : query.ram===ram) ? 'checked' : ''
                                                            %> />
                                                        <span
                                                            class="text-xs font-medium text-gray-400 group-hover:text-white transition-colors">
                                                            <%= ram %>
                                                        </span>
                                                    </label>
                                                    <% }) %>
                                            </div>
                                        </div>
                                    </div>



                                    <div class="filter-section">
                                        <h3
                                            class="text-white text-[10px] font-black uppercase tracking-[0.25em] mb-6 flex items-center justify-between">
                                            Price Range
                                            <span class="w-8 h-px bg-primary/40"></span>
                                        </h3>
                                        <div class="space-y-4">
                                            <label class="flex items-center gap-3 group cursor-pointer">
                                                <input
                                                    class="size-4 rounded-full border-white/10 bg-white/5 text-primary focus:ring-primary"
                                                    name="price" type="radio" value="under50000"
                                                    <%=query.price==='under50000' ? 'checked' : '' %> />
                                                <span
                                                    class="text-sm font-medium text-gray-400 group-hover:text-white transition-colors">Under
                                                    ₹50,000</span>
                                            </label>
                                            <label class="flex items-center gap-3 group cursor-pointer">
                                                <input
                                                    class="size-4 rounded-full border-white/10 bg-white/5 text-primary focus:ring-primary"
                                                    name="price" type="radio" value="50000-100000"
                                                    <%=query.price==='50000-100000' ? 'checked' : '' %> />
                                                <span
                                                    class="text-sm font-medium text-gray-400 group-hover:text-white transition-colors">₹50,000
                                                    - ₹1,00,000</span>
                                            </label>
                                            <label class="flex items-center gap-3 group cursor-pointer">
                                                <input
                                                    class="size-4 rounded-full border-white/10 bg-white/5 text-primary focus:ring-primary"
                                                    name="price" type="radio" value="100000-200000"
                                                    <%=query.price==='100000-200000' ? 'checked' : '' %> />
                                                <span
                                                    class="text-sm font-medium text-gray-400 group-hover:text-white transition-colors">₹1,00,000
                                                    - ₹2,00,000</span>
                                            </label>
                                            <label class="flex items-center gap-3 group cursor-pointer">
                                                <input
                                                    class="size-4 rounded-full border-white/10 bg-white/5 text-primary focus:ring-primary"
                                                    name="price" type="radio" value="over200000"
                                                    <%=query.price==='over200000' ? 'checked' : '' %> />
                                                <span
                                                    class="text-sm font-medium text-gray-400 group-hover:text-white transition-colors">Over
                                                    ₹2,00,000</span>
                                            </label>
                                        </div>
                                        <div class="mt-8">
                                            <div
                                                class="text-[9px] font-bold text-gray-500 uppercase tracking-widest mb-3 flex justify-between items-center">
                                                Custom Range
                                                <span id="priceRangeValue" class="text-primary font-black tracking-normal">₹<%= query.maxPrice || '500000' %></span>
                                            </div>
                                            <input
                                                id="priceRangeSlider"
                                                class="w-full h-1 bg-white/10 rounded-lg appearance-none cursor-pointer accent-primary"
                                                max="500000" min="0" step="1000" type="range" 
                                                value="<%= query.maxPrice || '500000' %>" />
                                            <div class="flex justify-between mt-2">
                                                <span class="text-[10px] text-gray-500 font-bold">₹0</span>
                                                <span class="text-[10px] text-gray-500 font-bold">₹500k+</span>
                                            </div>
                                        </div>
                                    </div>

                                    <button
                                        class="w-full py-4 bg-primary text-white text-[10px] font-black uppercase tracking-[0.2em] rounded-xl hover:shadow-[0_0_25px_-5px_#0055FF] transition-all duration-300">
                                        Apply All Filters
                                    </button>
                                </div>
                            </aside>

                            <!-- Product Grid Section -->
                            <div class="flex-1">
                                <div
                                    class="flex flex-col md:flex-row md:items-center justify-between gap-8 mb-12 pb-8 border-b border-white/5">
                                    <!-- Search and Active Filters -->
                                    <div class="flex flex-col gap-6 flex-1 max-w-2xl">
                                        <div class="relative group">
                                            <div
                                                class="absolute inset-y-0 left-0 pl-5 flex items-center pointer-events-none">
                                                <span
                                                    class="material-symbols-outlined text-gray-500 group-focus-within:text-primary transition-colors">search</span>
                                            </div>
                                            <input type="text" id="shopSearchInput"
                                                class="w-full bg-white/[0.03] border border-white/10 rounded-xl py-3.5 pl-14 pr-4 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-primary/50 transition-all shadow-lg "
                                                placeholder="Search products..." value="<%= query.search || '' %>">
                                            <div class="absolute inset-y-0 right-3 flex items-center">
                                                <button onclick="updateFilters()"
                                                    class="bg-primary hover:bg-primary/80 text-white px-4 py-1.5 rounded-lg text-xs font-bold uppercase tracking-widest transition-all">
                                                    Search
                                                </button>
                                            </div>
                                        </div>

                                        <div class="flex items-center gap-4">
                                            <% if (query.search || query.category || query.processor || query.ram ||
                                                query.price || query.maxPrice) { %>
                                                <span
                                                    class="text-[10px] font-black text-gray-500 uppercase tracking-[0.2em] whitespace-nowrap">Active
                                                    Filters:</span>
                                                <div class="flex flex-wrap items-center gap-2">
                                                    <% if (query.search) { %>
                                                        <div
                                                            class="px-3 py-1 bg-primary/10 border border-primary/20 rounded-full text-[10px] font-bold text-primary uppercase flex items-center gap-2">
                                                            Search: <%= query.search %>
                                                                <a href="/user/shop?<%= new URLSearchParams({...query, search: '', page: 1}).toString() %>"
                                                                    class="material-symbols-outlined text-xs cursor-pointer hover:text-white transition-colors">close</a>
                                                        </div>
                                                        <% } %>
                                                            <!-- ... other active filters ... -->
                                                            <% if (query.category) { %>
                                                                <% const catArr=Array.isArray(query.category) ?
                                                                    query.category : [query.category] %>
                                                                    <% catArr.forEach(cId=> { %>
                                                                        <% const activeCat=categories.find(c=>
                                                                            c._id.toString() === cId) %>
                                                                            <% if (activeCat) { %>
                                                                                <div
                                                                                    class="px-3 py-1 bg-primary/10 border border-primary/20 rounded-full text-[10px] font-bold text-primary uppercase flex items-center gap-2">
                                                                                    <%= activeCat.name %>
                                                                                        <a href="/user/shop?<%= new URLSearchParams({...query, category: catArr.filter(x => x !== cId), page: 1}).toString() %>"
                                                                                            class="material-symbols-outlined text-xs cursor-pointer hover:text-white transition-colors">close</a>
                                                                                </div>
                                                                                <% } %>
                                                                                    <% }) %>
                                                                                        <% } %>
                                                                                            <% ['processor', 'ram'
                                                                                                , 'price'
                                                                                                ].forEach(filterKey=> {
                                                                                                %>
                                                                                                <% if (query[filterKey])
                                                                                                    { %>
                                                                                                    <% const
                                                                                                        vals=Array.isArray(query[filterKey])
                                                                                                        ?
                                                                                                        query[filterKey]
                                                                                                        :
                                                                                                        [query[filterKey]]
                                                                                                        %>
                                                                                                        <%
                                                                                                            vals.forEach(v=>
                                                                                                            { %>
                                                                                                            <div
                                                                                                                class="px-3 py-1 bg-primary/10 border border-primary/20 rounded-full text-[10px] font-bold text-primary uppercase flex items-center gap-2">
                                                                                                                <%= filterKey.toUpperCase()
                                                                                                                    %>:
                                                                                                                    <%= v
                                                                                                                        %>
                                                                                                                        <a href="/user/shop?<%= new URLSearchParams({...query, [filterKey]: vals.filter(x => x !== v), page: 1}).toString() %>"
                                                                                                                            class="material-symbols-outlined text-xs cursor-pointer hover:text-white transition-colors">close</a>
                                                                                                            </div>
                                                                                                            <% }) %>
                                                                                                                <% } %>
                                                                                                                    <% })
                                                                                                                        %>
                                                                                                                        <% if (query.maxPrice && !query.price) { %>
                                                                <div
                                                                    class="px-3 py-1 bg-primary/10 border border-primary/20 rounded-full text-[10px] font-bold text-primary uppercase flex items-center gap-2">
                                                                    MAX PRICE: ₹<%= query.maxPrice %>
                                                                        <a href="/user/shop?<%= new URLSearchParams({...query, maxPrice: '', page: 1}).toString() %>"
                                                                            class="material-symbols-outlined text-xs cursor-pointer hover:text-white transition-colors">close</a>
                                                                </div>
                                                            <% } %>
                                                            <a href="/user/shop"
                                                                class="text-[10px] font-bold text-gray-500 hover:text-white uppercase tracking-widest whitespace-nowrap underline decoration-primary/40 underline-offset-4">Clear All</a>
                                                </div>
                                                <% } else { %>
                                                    <span
                                                        class="text-[10px] font-black text-gray-500 uppercase tracking-[0.2em]">Showing
                                                        all products</span>
                                                    <% } %>
                                        </div>
                                    </div>

                                    <!-- Sorting & Mobile Filter Toggle -->
                                    <div class="flex items-center gap-4 self-end md:self-auto w-full md:w-auto justify-between md:justify-end">
                                        <button type="button" onclick="toggleShopFilters()" class="lg:hidden flex items-center gap-2 bg-white/[0.03] border border-white/10 rounded-xl px-4 py-3 text-xs font-bold text-white hover:border-primary/50 transition-all shadow-xl backdrop-blur-md">
                                            <span class="material-symbols-outlined text-[18px]">tune</span>
                                            <span>Filters</span>
                                        </button>
                                        <div class="flex items-center gap-4">
                                            <span class="text-[10px] font-black text-gray-400 uppercase tracking-[0.2em] whitespace-nowrap hidden sm:inline">Sort By:</span>
                                        <div class="relative custom-dropdown" id="sortDropdown">
                                            <button type="button" id="sortDropdownBtn" class="flex items-center justify-between gap-4 bg-white/[0.03] border border-white/10 rounded-xl px-5 py-3 text-xs font-bold text-white hover:border-primary/50 transition-all min-w-[180px] group shadow-xl backdrop-blur-md">
                                                <span id="selectedSortLabel">
                                                    <%= query.sort === 'priceLow' ? 'Price: Low to High' : query.sort === 'priceHigh' ? 'Price: High to Low' : query.sort === 'aa' ? 'A - Z' : query.sort === 'zz' ? 'Z - A' : 'Featured' %>
                                                </span>
                                                <span class="material-symbols-outlined text-[20px] text-gray-500 group-hover:text-primary transition-all duration-300">expand_more</span>
                                            </button>
                                            <div id="sortDropdownMenu" class="absolute right-0 mt-3 w-full min-w-[200px] bg-[#0A0A0A]/95 backdrop-blur-2xl border border-white/10 rounded-2xl overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.5)] z-[100] hidden opacity-0 translate-y-2 transition-all duration-300">
                                                <div class="flex flex-col p-1.5">
                                                    <button onclick="applySort('')" class="flex items-center justify-between px-4 py-3.5 text-left text-[11px] font-black uppercase tracking-widest text-gray-400 hover:text-white hover:bg-white/5 rounded-xl transition-all <%= !query.sort ? 'text-primary bg-primary/5 !text-white' : '' %>">
                                                        Featured
                                                        <% if (!query.sort) { %><span class="material-symbols-outlined text-sm text-primary">check</span><% } %>
                                                    </button>
                                                    <button onclick="applySort('priceLow')" class="flex items-center justify-between px-4 py-3.5 text-left text-[11px] font-black uppercase tracking-widest text-gray-400 hover:text-white hover:bg-white/5 rounded-xl transition-all <%= query.sort === 'priceLow' ? 'text-primary bg-primary/5 !text-white' : '' %>">
                                                        Price: Low to High
                                                        <% if (query.sort === 'priceLow') { %><span class="material-symbols-outlined text-sm text-primary">check</span><% } %>
                                                    </button>
                                                    <button onclick="applySort('priceHigh')" class="flex items-center justify-between px-4 py-3.5 text-left text-[11px] font-black uppercase tracking-widest text-gray-400 hover:text-white hover:bg-white/5 rounded-xl transition-all <%= query.sort === 'priceHigh' ? 'text-primary bg-primary/5 !text-white' : '' %>">
                                                        Price: High to Low
                                                        <% if (query.sort === 'priceHigh') { %><span class="material-symbols-outlined text-sm text-primary">check</span><% } %>
                                                    </button>
                                                    <button onclick="applySort('aa')" class="flex items-center justify-between px-4 py-3.5 text-left text-[11px] font-black uppercase tracking-widest text-gray-400 hover:text-white hover:bg-white/5 rounded-xl transition-all <%= query.sort === 'aa' ? 'text-primary bg-primary/5 !text-white' : '' %>">
                                                        A - Z
                                                        <% if (query.sort === 'aa') { %><span class="material-symbols-outlined text-sm text-primary">check</span><% } %>
                                                    </button>
                                                    <button onclick="applySort('zz')" class="flex items-center justify-between px-4 py-3.5 text-left text-[11px] font-black uppercase tracking-widest text-gray-400 hover:text-white hover:bg-white/5 rounded-xl transition-all <%= query.sort === 'zz' ? 'text-primary bg-primary/5 !text-white' : '' %>">
                                                        Z - A
                                                        <% if (query.sort === 'zz') { %><span class="material-symbols-outlined text-sm text-primary">check</span><% } %>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    </div>
                                </div>

                                <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8">
                                    <% if (products && products.length> 0) { %>
                                        <% products.forEach(product=> { %>
                                            <div
                                                class="glass-card group rounded-2xl overflow-hidden transition-all duration-500 hover:-translate-y-2">
                                                <div class="aspect-[4/3] bg-white/[0.03] relative overflow-hidden block">
                                                    <% 
                                                        const isProductSoldOut = product.variants.every(v => {
                                                            return v.stock <= 0;
                                                        });
                                                        const cardVariant = product.variants.find(v => v.stock > 0) || product.variants[0];
                                                    %>
                                                    <a href="/user/product/<%= product._id %>" class="w-full h-full block">
                                                        <img src="<%= (product.variants && product.variants.length > 0 && cardVariant.images) ? cardVariant.images[0] : (product.images ? product.images[0] : '/img/placeholder.jpg') %>"
                                                            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110 opacity-90 <%= isProductSoldOut ? 'grayscale opacity-50' : '' %>" />
                                                    </a>
                                                    <% if (isProductSoldOut) { %>
                                                        <div class="absolute inset-0 flex items-center justify-center bg-black/40 backdrop-blur-[2px]">
                                                            <span class="px-6 py-2 bg-rose-500 text-white text-[10px] font-black uppercase tracking-[0.3em] rounded-full shadow-lg">Sold Out</span>
                                                        </div>
                                                    <% } %>
                                                    <button onclick="toggleWishlist(event, '<%= product._id %>', '<%= product.variants[0]?._id %>')" 
                                                            class="absolute top-4 right-4 z-10 size-10 rounded-full bg-black/40 backdrop-blur-md flex items-center justify-center text-white hover:bg-primary transition-all duration-300">
                                                        <span class="material-symbols-outlined text-xl" style="<%= (wishlistProductIds && wishlistProductIds.includes(product._id.toString())) ? 'font-variation-settings: \'FILL\' 1' : '' %>">favorite</span>
                                                    </button>
                                                </div>
                                                <div class="p-8">
                                                    <div class="flex justify-between items-start mb-3">
                                                        <a href="/user/product/<%= product._id %>">
                                                            <h3
                                                                class="text-white text-2xl font-black premium-heading uppercase hover:text-primary transition-colors">
                                                                <%= product.name %>
                                                            </h3>
                                                        </a>
                                                        <div class="flex items-center gap-2">
                                                            <% if (product.variants[0]?.originalPrice && product.variants[0]?.originalPrice > product.variants[0]?.price) { %>
                                                                <span class="text-gray-500 line-through text-sm">₹<%= product.variants[0]?.originalPrice %></span>
                                                            <% } %>
                                                            <span class="text-primary font-bold text-2xl">₹<%= product.variants[0]?.price || '0' %></span>
                                                        </div>
                                                    </div>
                                                    <p class="text-gray-400 text-sm mb-8 leading-relaxed">
                                                        <%= product.description %>
                                                    </p>
                                                    <% const firstInStockVariant = product.variants.find(v => v.stock > 0) || product.variants[0]; %>
                                                    <% if (!isProductSoldOut) { %>
                                                        <button onclick="addToCart('<%= product._id %>', '<%= firstInStockVariant?._id %>', 1, event)"
                                                            class="w-full flex items-center justify-center gap-3 bg-white text-black font-black text-xs uppercase tracking-widest py-4 rounded-full hover:bg-primary hover:text-white transition-all duration-300">
                                                            <span
                                                                class="material-symbols-outlined text-lg">add_shopping_cart</span>
                                                            Add to Cart
                                                        </button>
                                                    <% } else { %>
                                                        <button disabled
                                                            class="w-full flex items-center justify-center gap-3 bg-white/10 text-gray-500 font-black text-xs uppercase tracking-widest py-4 rounded-full cursor-not-allowed">
                                                            <span
                                                                class="material-symbols-outlined text-lg">block</span>
                                                            Out of Stock
                                                        </button>
                                                    <% } %>
                                                </div>
                                            </div>
                                            <% }) %>
                                                <% } else { %>
                                                    <div class="col-span-full text-center py-20">
                                                        <p class="text-gray-500 font-bold uppercase tracking-widest">No
                                                            products found</p>
                                                    </div>
                                                    <% } %>
                                </div>

                                <!-- Pagination -->
                                <div class="flex justify-center mt-20 gap-2">
                                    <% const getPageUrl=(p)=> {
                                        const params = new URLSearchParams();
                                        Object.keys(query).forEach(key => {
                                        if (key === 'page') return;
                                        const val = query[key];
                                        if (Array.isArray(val)) {
                                        val.forEach(v => params.append(key, v));
                                        } else if (val) {
                                        params.set(key, val);
                                        }
                                        });
                                        params.set('page', p);
                                        return '/user/shop?' + params.toString();
                                        };
                                        %>
                                        <% if (currentPage> 1) { %>
                                            <a href="<%= getPageUrl(currentPage - 1) %>"
                                                class="size-12 flex items-center justify-center rounded-full border border-white/10 text-white hover:border-primary hover:text-primary transition-all">
                                                <span class="material-symbols-outlined">chevron_left</span>
                                            </a>
                                            <% } %>

                                                <% for(let i=1; i <=totalPages; i++) { %>
                                                    <a href="<%= getPageUrl(i) %>"
                                                        class="size-12 flex items-center justify-center rounded-full <%= currentPage == i ? 'bg-primary text-white font-bold' : 'border border-white/10 text-white font-bold hover:border-primary hover:text-primary' %> text-xs">
                                                        <%= i %>
                                                    </a>
                                                    <% } %>

                                                        <% if (currentPage < totalPages) { %>
                                                            <a href="<%= getPageUrl(parseInt(currentPage) + 1) %>"
                                                                class="size-12 flex items-center justify-center rounded-full border border-white/10 text-white hover:border-primary hover:text-primary transition-all">
                                                                <span
                                                                    class="material-symbols-outlined">chevron_right</span>
                                                            </a>
                                                            <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                </main>
            <%- include('../../partials/user/footer') %>
        </div>
    </div>
    
    <script>
        function toggleShopFilters() {
            const sidebar = document.getElementById('shopFilterSidebar');
            const overlay = document.getElementById('shopFilterOverlay');
            if (sidebar.classList.contains('-translate-x-full')) {
                sidebar.classList.remove('-translate-x-full');
                overlay.classList.remove('hidden');
                document.body.style.overflow = 'hidden';
            } else {
                sidebar.classList.add('-translate-x-full');
                overlay.classList.add('hidden');
                document.body.style.overflow = '';
            }
        }
    </script>
    <script src="/js/user/shop/shop.js"></script>
</body>

</html>